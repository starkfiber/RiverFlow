# RF2 local graphical editor. Browser renders forms; all handlers/data/PDF are compiled RF2.
fn edg()
 return buffer("editor_state", 256)
end
fn edcopy(dst, src, n)
 let i = 0
 while i < n
  do store8(dst + i, load8(src + i))
  set i = i + 1
 end
 return n
end
fn edsame(p, n, text)
 let i = 0
 if n != slen(text)
  return 0
 end
 while i < n
  if load8(p + i) != load8(text + i)
   return 0
  end
  set i = i + 1
 end
 return 1
end
fn edkey(p, n, text)
 let i = 0
 let c = 0
 if n != slen(text)
  return 0
 end
 while i < n
  set c = load8(p + i)
  if (c >= 65) & (c <= 90)
   set c = c + 32
  end
  if c != load8(text + i)
   return 0
  end
  set i = i + 1
 end
 return 1
end
fn edfind(p, n, text, size)
 let i = 0
 let j = 0
 while i + size <= n
  set j = 0
  while (j < size) & (load8(p + i + j) == load8(text + j))
   set j = j + 1
  end
  if j == size
   return i + 1
  end
  set i = i + 1
 end
 return 0
end
fn edcapture()
 do store64(buffer("capture_state", 24), 1)
 return store64(buffer("capture_state", 24) + 8, 0)
end
fn edfinish()
 do store64(buffer("capture_state", 24), 0)
 return load64(buffer("capture_state", 24) + 8)
end
fn edreset()
 do store32(buffer("invoice_currency", 4), 5396813)
 do store64(buffer("invoice_state", 80) + 24, 0)
 do store64(buffer("invoice_state", 80) + 32, 0)
 do store64(buffer("invoice_state", 80) + 40, 0)
 do store64(buffer("invoice_state", 80) + 48, 0)
 do store64(buffer("invoice_state", 80) + 56, 0)
 do edcapture()
 do iwjson()
 return edcommit()
end
fn edcommit()
 let size = edfinish()
 if (load64(state()) != 0) | (size > 131072)
  return fail(37)
 end
 do edcopy(buffer("editor_document", 131073), buffer("capture_bytes", 1048576), size)
 do store64(edg() + 24, size)
 return store64(edg() + 16, load64(edg() + 16) + 1)
end
fn edload()
 do store64(state(), 0)
 return iwparse(buffer("editor_document", 131073), load64(edg() + 24))
end
fn edhidden()
 do say("<input type=hidden name=token value=\"")
 do say(buffer("editor_nonce", 33))
 do say("\"><input type=hidden name=rev value=\"")
 do decimal(load64(edg() + 16))
 return say("\">")
end
fn edmoney(value)
 do decimal(value // 100)
 do say(".")
 if value - (value // 100) * 100 < 10
  do say("0")
 end
 return decimal(value - (value // 100) * 100)
end
fn edprice(p, n)
 let i = 0
 let whole = 0
 let fraction = 0
 let scale = 0
 let dot = 0
 let c = 0
 if (n == 0) | (n > 14)
  return fail(39)
 end
 while i < n
  set c = load8(p + i)
  if c == 46
   if (dot != 0) | (i == 0)
    return fail(39)
   end
   set dot = 1
  else
   if digit(c) == 0
    return fail(39)
   end
   if dot
    set scale = scale + 1
    if scale > 2
     return fail(39)
    end
    set fraction = fraction * 10 + c - 48
   else
    set whole = whole * 10 + c - 48
    if whole > 42949672
     return fail(39)
    end
   end
  end
  set i = i + 1
 end
 if dot & (scale == 0)
  return fail(39)
 end
 if scale == 1
  set fraction = fraction * 10
 end
 set whole = whole * 100 + fraction
 if whole > 4294967295
  return fail(39)
 end
 return whole
end
fn edpage(message)
 let i = 0
 let count = 0
 let data = buffer("invoice_words", 8000)
 do edload()
 set count = load64(buffer("invoice_state", 80) + 32)
 do edcapture()
 do say("<!doctype html><html lang=en><head><meta charset=utf-8><meta name=viewport content=\"width=device-width,initial-scale=1\"><title>RiverFlow Studio · Invoice</title><style>")
 do say("*{box-sizing:border-box}body{margin:0;background:#f6f5f1;color:#152c35;font:16px/1.5 system-ui,-apple-system,sans-serif}a{color:inherit}button,input{font:inherit}button,a.button{cursor:pointer;border:1px solid #becbc9;border-radius:9px;background:white;color:#18373c;padding:10px 16px;min-height:44px;text-decoration:none;display:inline-flex;align-items:center;justify-content:center;transition:background .16s}button:hover,a.button:hover{background:#e6eeeb}button:focus-visible,a:focus-visible,input:focus-visible,summary:focus-visible{outline:3px solid #16706c;outline-offset:3px}button.primary{background:#145e59;color:white;border-color:#145e59}button.primary:hover{background:#104a46}header{height:78px;background:#102f38;color:#f5fbf9;display:flex;align-items:center;justify-content:space-between;padding:0 5vw;gap:16px}.brand{font-size:21px;font-weight:650;letter-spacing:-.6px}.brand b{color:#9de5d3;margin-right:16px;font-size:27px}.local{font-size:13px;color:#c1dcd6}main{max-width:1240px;margin:44px auto;padding:0 28px}.eyebrow{font-size:12px;text-transform:uppercase;letter-spacing:1.7px;color:#496663;font-weight:650}h1{font:44px/1.15 Georgia,serif;letter-spacing:-1.3px;margin:12px 0}h2{font-size:19px;margin:0 0 18px}.intro{color:#526864;max-width:660px}.toolbar{display:flex;flex-wrap:wrap;gap:10px;margin:26px 0}.layout>*{min-width:0}.layout{display:grid;grid-template-columns:minmax(0,1fr) 310px;gap:24px;align-items:start}.card{background:#fff;border:1px solid #d9e0da;border-radius:16px;padding:26px;box-shadow:0 3px 15px #183b2d05}.summary{position:sticky;top:24px}.fields{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:30px}label{display:block;font-size:13px;font-weight:650;color:#405c59}input{display:block;width:100%;border:1px solid #bdccc6;border-radius:8px;padding:11px;background:#fff;color:#152c35;min-height:44px;margin-top:7px}small,.muted{color:#5b6f69;font-size:13px}.tablewrap{overflow-x:auto}table{border-collapse:collapse;width:100%;min-width:460px}th{text-align:left;color:#5b6f69;font-size:12px;font-weight:650;padding:0 10px 12px;border-bottom:1px solid #d8e3dd}td{padding:12px 10px;border-bottom:1px solid #edf0ec}td:first-child{width:42px;color:#637973}td input{min-width:90px;margin:0}td:last-child{width:58px}td button{padding:9px 12px}.bottom{display:flex;justify-content:space-between;gap:10px;margin-top:22px;flex-wrap:wrap}.metric{display:flex;justify-content:space-between;padding:14px 0;border-bottom:1px solid #e6ece6}.total{font-size:28px;letter-spacing:-.8px;font-weight:650;margin:20px 0}.total span{font-size:14px;font-weight:400;letter-spacing:0;color:#5b6f69;display:block}.notice{padding:16px 20px;background:#e5f2ec;border:1px solid #b4d8c8;border-radius:10px;margin:20px 0}.error{background:#fff0e9;border-color:#ecc4b0;color:#773419}details{margin-top:24px;border-top:1px solid #e2e8e2;padding-top:18px}summary{cursor:pointer;font-size:14px;font-weight:600}pre{font:13px/1.7 ui-monospace,monospace;white-space:pre-wrap;color:#355b54;background:#f3f6f1;border-radius:8px;padding:14px}.open{display:flex;align-items:end;gap:12px;flex-wrap:wrap}.open input{max-width:340px}.footer{margin:26px 0 10px;font-size:12px;color:#60756d}.empty{padding:34px 10px;text-align:center;color:#60756d}.close{background:transparent;color:#d8eae4;border-color:#54756f}header button:hover{color:#173b36}@media(max-width:850px){.layout{grid-template-columns:1fr}.summary{position:static}main{margin-top:28px;padding:0 18px}h1{font-size:36px}.card{padding:20px}.fields{gap:12px}}@media(max-width:420px){.local{display:none}.fields{grid-template-columns:1fr}}@media(prefers-reduced-motion:reduce){*{transition:none!important}}")
 do say("</style></head><body><header><div class=brand><b>RF²</b>RiverFlow Studio</div><span class=local>Local workspace</span></header><main><p class=eyebrow>Documents / Invoice</p><h1>Invoice studio</h1><p class=intro>Keep the rules visible. Edit your lines, apply changes, then save a document or export a printable worksheet.</p>")
 if message != 0
  if message == 1
   do say("<p class=notice role=status>Changes applied. Totals have been recalculated.</p>")
  else
   if message == 2
    do say("<p class=notice role=status>Document opened and checked.</p>")
   else
    if message == 3
     do say("<p class=notice role=alert>Start an empty draft? Download your current document first if you need to keep it. <button form=edit name=action value=reset>Start empty draft</button></p>")
    else
     do say("<p class=\"notice error\" role=alert>Changes were not saved. Check the currency, tax, whole-number quantities and prices. If this page is older than another tab, review the latest values below and try again.</p>")
    end
   end
  end
 end
 do say("<div class=toolbar><button form=save type=submit>Save document</button><button form=pdf type=submit>Export PDF</button><button form=edit name=action value=new>New draft</button><button form=close type=submit>Close workspace</button></div><form id=edit action=/edit method=post>")
 do edhidden()
 do say("<input type=hidden name=rows value=\"")
 do decimal(count)
 do say("\"><div class=layout><section class=card aria-label=\"Invoice lines\"><h2>Calculation rules</h2><div class=fields><label>Currency label<input name=currency aria-label=Currency pattern=\"[A-Z]{3}\" maxlength=3 required value=\"")
 do say(buffer("invoice_currency", 4))
 do say("\"><small>Three uppercase letters</small></label><label>Tax rate (basis points)<input name=tax aria-label=\"Tax rate in basis points\" type=number min=0 max=10000 step=1 required value=\"")
 do decimal(load64(buffer("invoice_state", 80) + 24))
 do say("\"><small>600 basis points means 6%</small></label></div><h2>Line items</h2><div class=tablewrap tabindex=0 role=region aria-label=\"Line items table\"><table><thead><tr><th scope=col>Line</th><th scope=col>Quantity</th><th scope=col>Unit price</th><th scope=col>Action</th></tr></thead><tbody>")
 while i < count
  do say("<tr><td>")
  do decimal(i + 1)
  do say("</td><td><input type=number min=1 max=4294967295 step=1 required name=q")
  do decimal(i)
  do say(" aria-label=\"Quantity for line ")
  do decimal(i + 1)
  do say("\" value=\"")
  do decimal(load32(data + i * 8))
  do say("\"></td><td><input type=text inputmode=decimal pattern=\"[0-9]+(\\.[0-9]{1,2})?\" required name=p")
  do decimal(i)
  do say(" aria-label=\"Unit price for line ")
  do decimal(i + 1)
  do say("\" value=\"")
  do edmoney(load32(data + i * 8 + 4))
  do say("\"></td><td><button name=action value=remove:")
  do decimal(i)
  do say(" aria-label=\"Remove line ")
  do decimal(i + 1)
  do say("\">Remove</button></td></tr>")
  set i = i + 1
 end
 if count == 0
  do say("<tr><td colspan=4 class=empty>No lines yet. Add your first line to begin.</td></tr>")
 end
 do say("</tbody></table></div><div class=bottom><button name=action value=add>Add line</button><button class=primary name=action value=apply>Apply changes</button></div><p class=muted>Downloads use the last applied draft. Your data stays in this process until you close the workspace; save a document to keep it.</p></section><aside class=\"card summary\" aria-label=\"Invoice summary\"><p class=eyebrow>Checked totals</p><h2>")
 do say(buffer("invoice_currency", 4))
 do say(" worksheet</h2><div class=metric><span>Lines</span><strong>")
 do decimal(count)
 do say("</strong></div><div class=metric><span>Subtotal</span><strong>")
 do edmoney(load64(buffer("invoice_state", 80) + 40))
 do say("</strong></div><div class=metric><span>Tax</span><strong>")
 do edmoney(load64(buffer("invoice_state", 80) + 48))
 do say("</strong></div><p class=total><span>Total</span>")
 do edmoney(load64(buffer("invoice_state", 80) + 56))
 do say("</p><p class=muted>Invoice-level half-up rounding. Confirm the business and tax rules before issuing an invoice.</p><details><summary>View the rf2 plan</summary><pre>rf2 app v1\ninvoice total\ncurrency ")
 do say(buffer("invoice_currency", 4))
 do say("\ntax ")
 do decimal(load64(buffer("invoice_state", 80) + 24))
 do say(" bps</pre></details></aside></div></form><section class=card style=\"margin-top:24px\"><h2>Open a saved document</h2><form class=open action=/open method=post enctype=multipart/form-data>")
 do edhidden()
 do say("<label>Invoice document<input type=file name=document accept=\".json,application/json\" required></label><button type=submit>Open document</button></form></section><p class=footer>RiverFlow Studio · Local file-based workspace · SFE<br>A calculation worksheet, with explicit rules. Customer registration, tax-law decisions and payments are outside this version.</p>")
 do say("<form id=close action=/quit method=post hidden>")
 do edhidden()
 do say("</form><form id=save action=/document method=post hidden>")
 do edhidden()
 do say("</form><form id=pdf action=/pdf method=post hidden>")
 do edhidden()
 do say("</form></main></body></html>")
 return edfinish()
end
fn edsend(fd, p, n)
 let i = 0
 let r = 0
 while i < n
  set r = write(fd, p + i, n - i)
  if (r == 0) | (r >= 9223372036854775808)
   return 0
  end
  set i = i + r
 end
 return 1
end
fn edrespond(fd, status, kind)
 let size = load64(buffer("capture_state", 24) + 8)
 do edcopy(buffer("editor_response", 1048576), buffer("capture_bytes", 1048576), size)
 do edcapture()
 do say("HTTP/1.1 ")
 do say(status)
 if eq(status, "303 See Other")
  do say("\r\nLocation: /")
 end
 do say("\r\nConnection: close\r\nCache-Control: no-store\r\nX-Content-Type-Options: nosniff\r\nReferrer-Policy: same-origin\r\nCross-Origin-Resource-Policy: same-origin\r\nContent-Security-Policy: default-src 'none'; style-src 'unsafe-inline'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'\r\nContent-Type: ")
 if kind == 1
  do say("application/json\r\nContent-Disposition: attachment; filename=invoice.rf2.json")
 else
  if kind == 2
   do say("application/pdf\r\nContent-Disposition: attachment; filename=invoice-worksheet.pdf")
  else
   do say("text/html; charset=utf-8")
  end
 end
 do say("\r\nContent-Length: ")
 do decimal(size)
 do say("\r\n\r\n")
 do edsend(fd, buffer("capture_bytes", 1048576), edfinish())
 return edsend(fd, buffer("editor_response", 1048576), size)
end
fn edbad(fd, status)
 do edcapture()
 do say("<!doctype html><html lang=en><meta charset=utf-8><title>Request refused</title><h1>Request refused</h1><p>No document was changed. Return to the local workspace and refresh.</p></html>")
 do edfinish()
 return edrespond(fd, status, 0)
end
fn eddecode(p, n, out, limit)
 let i = 0
 let size = 0
 let c = 0
 let h = 0
 let low = 0
 while i < n
  set c = load8(p + i)
  if c == 43
   set c = 32
  else
   if c == 37
    if i + 2 >= n
     return fail(39)
    end
    set h = hex(load8(p + i + 1))
    set low = hex(load8(p + i + 2))
    if (h > 15) | (low > 15)
     return fail(39)
    end
    set c = h * 16 + low
    set i = i + 2
   end
  end
  if (c < 32) | (c > 126) | (size >= limit)
   return fail(39)
  end
  do store8(out + size, c)
  set size = size + 1
  set i = i + 1
 end
 do store8(out + size, 0)
 return size
end
fn edform(p, n, full)
 let pos = 0
 let end = 0
 let sep = 0
 let name = buffer("editor_form_name", 65)
 let val = buffer("editor_form_value", 257)
 let namesize = 0
 let valsize = 0
 let flags = 0
 let fields = 0
 let index = 0
 let number = 0
 let rows = 0
 let i = 0
 let bit = 0
 let seen = buffer("editor_form_seen", 2000)
 while i < 2000
  do store8(seen + i, 0)
  set i = i + 1
 end
 do store64(edg() + 144, 0)
 do store64(edg() + 152, 0)
 do store64(edg() + 160, 0)
 while pos < n
  set end = pos
  while (end < n) & (load8(p + end) != 38)
   set end = end + 1
  end
  set sep = pos
  while (sep < end) & (load8(p + sep) != 61)
   set sep = sep + 1
  end
  if sep == end
   return fail(39)
  end
  set namesize = eddecode(p + pos, sep - pos, name, 64)
  set valsize = eddecode(p + sep + 1, end - sep - 1, val, 256)
  if load64(state()) != 0
   return 0
  end
  set bit = 0
  if eq(name, "token")
   if (valsize != 32) | (eq(val, buffer("editor_nonce", 33)) == 0)
    return fail(39)
   end
   set bit = 1
  else
   if eq(name, "rev")
    if unsigned(val, valsize) != load64(edg() + 16)
     return fail(39)
    end
    set bit = 2
   else
    if full == 0
     return fail(39)
    end
    if eq(name, "rows")
     set rows = unsigned(val, valsize)
     if rows > 1000
      return fail(39)
     end
     do store64(edg() + 160, rows)
     set bit = 4
    else
     if eq(name, "currency")
      if valsize != 3
       return fail(39)
      end
      set i = 0
      while i < 3
       if (load8(val + i) < 65) | (load8(val + i) > 90)
        return fail(39)
       end
       set i = i + 1
      end
      do edcopy(buffer("editor_form_currency", 4), val, 4)
      set bit = 8
     else
      if eq(name, "tax")
       set number = unsigned(val, valsize)
       if number > 10000
        return fail(39)
       end
       do store64(edg() + 168, number)
       set bit = 16
      else
       if eq(name, "action")
        if eq(val, "apply")
         do store64(edg() + 144, 1)
        end
        if eq(val, "add")
         do store64(edg() + 144, 2)
        end
        if (valsize > 7) & (edsame(val, 7, "remove:"))
         do store64(edg() + 144, 3)
         do store64(edg() + 152, unsigned(val + 7, valsize - 7))
        end
        if eq(val, "new")
         do store64(edg() + 144, 4)
        end
        if eq(val, "reset")
         do store64(edg() + 144, 5)
        end
        if load64(edg() + 144) == 0
         return fail(39)
        end
        set bit = 32
       else
        if (namesize < 2) | ((load8(name) != 113) & (load8(name) != 112))
         return fail(39)
        end
        if (namesize > 2) & (load8(name + 1) == 48)
         return fail(39)
        end
        set index = unsigned(name + 1, namesize - 1)
        if index >= 1000
         return fail(39)
        end
        if load8(name) == 112
         set number = edprice(val, valsize)
        else
         set number = unsigned(val, valsize)
        end
        set i = index * 2
        if load8(name) == 112
         set i = i + 1
        end
        if load8(seen + i) != 0
         return fail(39)
        end
        do store8(seen + i, 1)
        do store32(buffer("editor_form_words", 8000) + i * 4, number)
       end
      end
     end
    end
   end
  end
  if bit != 0
   if (flags & bit) != 0
    return fail(39)
   end
   set flags = flags | bit
  end
  set fields = fields + 1
  set pos = end + 1
 end
 if full == 0
  if (flags != 3) | (fields != 2)
   return fail(39)
  end
 else
  set rows = load64(edg() + 160)
  if (flags != 63) | (fields != 6 + rows * 2)
   return fail(39)
  end
  set i = 0
  while i < rows * 2
   if load8(seen + i) == 0
    return fail(39)
   end
   set i = i + 1
  end
 end
 return load64(state()) == 0
end
fn edapply()
 let action = load64(edg() + 144)
 let rows = load64(edg() + 160)
 let removed = load64(edg() + 152)
 let i = 0
 let value = 0
 let words = buffer("editor_form_words", 8000)
 if action == 4
  return 3
 end
 if action == 5
  do edreset()
  return 1
 end
 if action == 2
  if rows >= 1000
   return fail(39)
  end
  do store32(words + rows * 8, 1)
  do store32(words + rows * 8 + 4, 0)
  set rows = rows + 1
 end
 if action == 3
  if removed >= rows
   return fail(39)
  end
  set i = removed
  while i + 1 < rows
   do store64(words + i * 8, load64(words + (i + 1) * 8))
   set i = i + 1
  end
  set rows = rows - 1
 end
 do edcapture()
 do say("{\"format\":\"rf2.invoice.document.v1\",\"plan\":\"rf2 app v1 invoice total currency ")
 do say(buffer("editor_form_currency", 4))
 do say(" tax ")
 do decimal(load64(edg() + 168))
 do say(" bps\",\"lines\":[")
 set i = 0
 while i < rows
  if i != 0
   do say(",")
  end
  do say("{\"quantity\":")
  do decimal(load32(words + i * 8))
  do say(",\"unit_cents\":")
  do decimal(load32(words + i * 8 + 4))
  do say("}")
  set i = i + 1
 end
 do say("]}")
 do edfinish()
 do iwparse(buffer("capture_bytes", 1048576), load64(buffer("capture_state", 24) + 8))
 if load64(state()) != 0
  return 0
 end
 do edcommit()
 return 1
end
fn edmultipart(p, n)
 let boundary = buffer("editor_boundary", 73)
 let bsize = load64(edg() + 104)
 let pos = 0
 let headers = 0
 let end = 0
 let size = 0
 let flags = 0
 let bit = 0
 let q = 0
 let part = 0
 let content = 0
 if (bsize == 0) | (n < bsize + 6)
  return fail(39)
 end
 # delimiter is CRLF + -- + the declared ASCII boundary.
 do edcopy(buffer("editor_delimiter", 78), "\r\n--", 4)
 do edcopy(buffer("editor_delimiter", 78) + 4, boundary, bsize)
 if (load8(p) != 45) | (load8(p + 1) != 45)
  return fail(39)
 end
 if edfind(p + 2, bsize, boundary, bsize) != 1
  return fail(39)
 end
 set pos = bsize + 2
 while pos < n
  if (load8(p + pos) != 13) | (load8(p + pos + 1) != 10)
   return fail(39)
  end
  set headers = pos + 2
  set size = edfind(p + headers, n - headers, "\r\n\r\n", 4)
  if (size == 0) | (size > 1024)
   return fail(39)
  end
  set content = headers + size + 3
  set end = edfind(p + content, n - content, buffer("editor_delimiter", 78), bsize + 4)
  if end == 0
   return fail(39)
  end
  set size = end - 1
  set bit = 0
  if edfind(p + headers, content - headers, "name=\"token\"", 12)
   set bit = 1
   if (size != 32) | (edfind(p + content, size, buffer("editor_nonce", 33), 32) != 1)
    return fail(39)
   end
  else
   if edfind(p + headers, content - headers, "name=\"rev\"", 10)
    set bit = 2
    if unsigned(p + content, size) != load64(edg() + 16)
     return fail(39)
    end
   else
    if edfind(p + headers, content - headers, "name=\"document\"", 15)
     set bit = 4
     if size > 131072
      return fail(39)
     end
     do store64(edg() + 176, p + content)
     do store64(edg() + 184, size)
