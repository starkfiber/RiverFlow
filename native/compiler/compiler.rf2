end
fn line_trim(p, end, i)
 while i < end
  if (load8(p + i) != 32) & (load8(p + i) != 9) & (load8(p + i) != 13)
   return i
  end
  set i = i + 1
 end
 return i
end
fn line_starts(p, end, start, text)
 let n = length(text)
 if start + n > end
  return 0
 end
 return same(p + start, n, text, n)
end
fn module_path_check(p, n)
 do require((n >= 5) & (n <= 240), "module path length")
