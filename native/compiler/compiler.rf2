end
fn object(i)
 do require(i < 8192, "object bound")
 return buffer("objects", 327680) + i * 40
end
fn intern(kind, t, size)
 let i = 0
 let n = load64(state() + 72)
 let p = 0
 let offset = 0
 while i < n
  set p = object(i)
  if load64(p) == kind
   if name_equal(load64(p + 8), t)
    do require(load64(p + 16) == size, "inconsistent buffer size")
    return i
   end
  end
  set i = i + 1
 end
