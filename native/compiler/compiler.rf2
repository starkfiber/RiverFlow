  set selected = 0
  if (load64(state() + 152) != 0) & (load64(token(rhs)) == 2) & (precedence(rhs + 1) <= p) & (tmatch(rhs + 1, ".") == 0)
   set selected = numeric_operation(op, load64(token(rhs) + 24))
   if selected == 0
    do emit(2852127713)
