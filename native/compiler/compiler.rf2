 do imm(2, 3)
 do imm(16, 74)
 do emit(3556773889)
 let good = next_label()
 do jump(good, 3)
 do emit(2852127713)
 do imm(0, 1)
 do emit(2432713727)
 do jump(done, 16)
 do label(good)
 return 0
end
fn invoke_vector(name, depth)
 do require(load64(state() + 200) == 0, "vector operations while view is live")
 let f = load64(state() + 32)
 let slot = local_index(advance())
 let id = load64(local_type(f, slot))
 do require(id != 0, "vector owner required")
 do require(load64(record_info(id) + 144) == 7, "vector owner required")
 let bad = next_label()
 let invalid = next_label()
 let range = next_label()
 let done = next_label()
 let same = next_label()
 let ready = next_label()
 let large = next_label()
 let clamped = next_label()
 do access_local(0, slot + 1, 0)
 do emit(4043309087)
 do jump(bad, 0)
