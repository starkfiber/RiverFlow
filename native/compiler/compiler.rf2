end
fn precedence(i)
 if load64(token(i)) != 4
  return 0
 end
 if tmatch(i, "==") | tmatch(i, "!=") | tmatch(i, "<") | tmatch(i, ">") | tmatch(i, "<=") | tmatch(i, ">=")
  return 1
 end
 if tmatch(i, "|")
  return 2
 end
 if tmatch(i, "^")
  return 3
 end
 if tmatch(i, "&")
  return 4
 end
 if tmatch(i, "<<") | tmatch(i, ">>")
  return 5
 end
 if tmatch(i, "+") | tmatch(i, "-")
  return 6
 end
 if tmatch(i, "*") | tmatch(i, "//")
  return 7
 end
 return 0
end
fn operation(i)
