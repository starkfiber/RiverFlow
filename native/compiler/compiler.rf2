  do require(used < 524289, "combined module source bound")
  set amount = read(fd, arena + used, 524289 - used)
  do require(amount < 9223372036854775808, "module read failed")
  if amount == 0
   do require(used <= 524288, "combined module source bound")
   do close(fd)
   do store64(module_info(count), arena + start)
