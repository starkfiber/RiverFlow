end
fn expression(minimum, depth)
 let i = load64(state() + 24)
 let kind = load64(token(i))
 let op = 0
 let p = 0
 let comparison = 0
 let lhs_type = 0
 let rhs = 0
 let selected = 0
 let slot = 0
 let id = 0
 do store64(state() + 136, 0)
 do store64(state() + 232, 0)
 do require(depth < 64, "expression depth bound")
 if match("-") | match("~")
  do advance()
  do scalar_expression(8, depth + 1)
  if tmatch(i, "-")
   do emit(3405775840)
  else
   do emit(2854224864)
  end
 else
  if match("(")
   do advance()
   do expression(1, depth + 1)
   do expect(")")
  else
   if kind == 2
    do advance()
    do imm(0, load64(token(i) + 24))
   else
    if kind == 3
     do advance()
     do address(0, intern(1, i, load64(token(i) + 16) + 1))
    else
     do require(kind == 1, "expected expression")
     do advance()
     if tmatch(i, "true") | tmatch(i, "false")
      do imm(0, tmatch(i, "true"))
     else
     if match("(")
      do advance()
      do invoke(i, depth + 1)
     else
      set slot = local_index(i)
      set id = load64(local_type(load64(state() + 32), slot))
      if id != 0
       do require(load64(local_ready(load64(state() + 32), slot)) != 0, "record used before initialization")
      end
      if id != 0
       do require((load64(record_info(id) + 144) != 6) & (load64(record_info(id) + 144) < 8), "owner cannot be used as a value")
       if load64(record_info(id) + 144) == 7
        do require(match("[") | match("."), "vector owner cannot be used as a value")
       end
      end
      do access_local(0, slot, 0)
      do store64(state() + 136, id)
      do store64(state() + 232, load64(local_binding(load64(state() + 32), slot)))
     end
     end
    end
   end
  end
 end
 while match(".") | match("[")
  set id = load64(state() + 136)
  do require(id != 0, "structured value required")
  do require(load64(record_info(id) + 144) != 3, "result requires exhaustive handle")
  if match("[")
   do require((load64(record_info(id) + 144) == 1) | (load64(record_info(id) + 144) == 2) | (load64(record_info(id) + 144) == 4) | (load64(record_info(id) + 144) == 5) | (load64(record_info(id) + 144) == 7), "index requires array/view")
   do advance()
   do push()
   do scalar_expression(1, depth + 1)
   do expect("]")
   do pop1()
   do array_address(id)
   if load64(record_info(id) + 144) == 5
    do store64(state() + 136, 0)
   else
   if load64(record_info(id) + 144) != 1
    do emit(960495616)
   else
    do emit(4181721088)
   end
   end
  else
   do advance()
   if load64(record_info(id) + 144)
    if load64(record_info(id) + 144) == 7
     do emit(4181721088 | 1)
     do emit(4043309087 | (1 << 5))
     do jump(bounds_failure_label(), 0)
     if match("length")
      do advance()
      do emit(4181721088 | (2 << 10))
     else
      if match("capacity")
       do advance()
       do emit(4181721088 | (3 << 10))
      else
       do expect("limit")
       do imm(0, load64(record_info(id) + 8))
      end
     end
    else
    if load64(record_info(id) + 144) == 5
     if match("byte_length")
      do advance()
      do emit(4181721088 | (1 << 10))
     else
      do expect("length")
      do emit(4181721088 | (2 << 10))
     end
    else
