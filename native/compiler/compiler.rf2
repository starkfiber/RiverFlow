  return emit(2332033056)
 end
 if tmatch(i, "-")
  return emit(3405774880)
 end
 if tmatch(i, "*")
  return emit(2600500256)
 end
 if tmatch(i, "&")
  return emit(2315255840)
 end
 if tmatch(i, "|")
  return emit(2852126752)
 end
 if tmatch(i, "^")
  return emit(3388997664)
 end
 if tmatch(i, "<<")
  return emit(2596282400)
 end
 if tmatch(i, ">>")
  return emit(2596283424)
 end
 if tmatch(i, "//")
  return emit(2596276256)
