 while (match("let")|match("set"))&valid
  set declaring = match("let")
  do advance()
  set slot = reuse_local_slot(f,load64(state()+24))
  if (slot==0)|(load64(token(load64(state()+24)))!=1)
   set valid = 0
  else
   set slot = slot-1
   if declaring
    if load64(reuse_ready(slot))|(slot<load64(p+8))
     set valid = 0
    end
   else
    if load64(reuse_ready(slot))==0
     set valid = 0
    end
   end
   do advance()
   if match("=")==0
    set valid = 0
   else
    do advance()
    if reuse_expression(f,1,0)==0
     set valid = 0
