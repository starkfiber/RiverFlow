  set arity = 1
 end
 if tmatch(name, "load64")
  set builtin = 4181721088
  set arity = 1
 end
 if tmatch(name, "store8")
  set builtin = 956301313
  set arity = 2
 end
 if tmatch(name, "store32")
  set builtin = 3103784961
  set arity = 2
 end
 if tmatch(name, "store64")
  set builtin = 4177526785
