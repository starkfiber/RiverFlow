end
fn block(depth)
 let i = 0
 let target = 0
 let other = 0
 let done = 0
 let start = 0
 do require(depth < 64, "block depth bound")
 while 1
  set i = load64(state() + 24)
  if load64(token(i)) == 5
   do advance()
  else
   if match("end")
    do advance()
    do newline()
    return 0
   end
   if match("else")
    do advance()
    do newline()
    return 1
   end
   if match("let") | match("set")
    do advance()
    set target = local_index(advance())
    do expect("=")
    do expression(1, 0)
    do access_local(0, target, 1)
    do newline()
   else
    if match("do")
     do advance()
     do expression(1, 0)
     do newline()
    else
     if match("return")
      do advance()
      do expression(1, 0)
      do jump(load64(state() + 88), 16)
