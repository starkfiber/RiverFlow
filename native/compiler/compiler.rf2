# VM owners are noncopyable function-local resources; parent relations are static.
fn emit_vm_api(symbol)
 let t = add_token(3, symbol, length(symbol), 0)
 do address(16, platform_object(t))
 do emit(4181721616)
 do emit(3594453504)
 do emit(3544186880 | (31 << 10))
 return 0
end
fn local_pointer(r, slot)
