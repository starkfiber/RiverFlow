 do cp(buffer("module_sources", 524289), src, n)
 do store64(module_info(0), buffer("module_sources", 524289))
 do store64(module_info(0) + 8, n)
 do module_append("profile RF2_SYSTEM_A64_V1\n", 26)
 do module_walk(0, 0)
 do store64(state(), buffer("module_expanded", 524289))
 do store64(state() + 8, load64(module_state() + 24))
 return load64(state())
end
fn main(argc, argv)
 let src = 0
 let digest = 0
 let dataoff = 0
 let datasize = 0
 if (argc != 3) & (argc != 4)
  do write(2, "rf2c source.rf2 new-output [--opt]\n", 35)
  return 1
 end
 if argc == 4
  do require(same(load64(argv + 24), length(load64(argv + 24)), "--opt", 5), "unknown compiler option")
