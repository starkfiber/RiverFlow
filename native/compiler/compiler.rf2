 let path_size = syscall6(336,2,syscall6(20,0,0,0,0,0,0),11,0,self,1024)
 do require(((path_size>>63)==0)&(load8(self)==47)&(load8(self+1023)==0),"compiler process path unavailable")
 let fd = open(self,0x1000104,0)
 do require((fd>>63)==0,"compiler process file unavailable")
 do require(syscall6(339,fd,stat,0,0,0,0)==0,"compiler identity stat failed")
 let n = load64(stat+96)
 do require(((load32(stat+4)&61440)==32768)&(n>0)&(n<=67108864),"compiler identity size bound")
 let ptr = syscall6(197,0,n,1,2,fd,0)
 do require(ptr!=18446744073709551615,"compiler identity mapping failed")
 do cp(reuse_state()+32,sha256(ptr,n),32)
 do require(syscall6(73,ptr,n,0,0,0,0)==0,"compiler identity unmap failed")
 do require(close(fd)==0,"compiler identity close failed")
 do store64(reuse_state(),root+1)
 do cp(reuse_state()+64,map_context_digest(),32)
 if load64(reuse_state()+104)
  do reuse_pack_load()
 end
 return 0
end
# Parse the same precedence/comparison rules without generating instructions.
# Only own scalar parameters and numeric literals are admitted as atoms.
# A pack is an optional container of the same independently checked function units.
# Its namespace binds compiler, declaration context and both image options.
fn reuse_pack_key()
 let key = buffer("reuse_pack_key",80)
 do cp(key,reuse_state()+32,64)
 do store64(key+64,load64(state()+152))
 do store64(key+72,load64(image_options()))
