 end
 if kind == 5
  do emit(2852127712 | (0 << 16) | 2)
  do emit(4181721088 | (2 << 10) | (1 << 5) | 3)
  do emit(3942645791 | (3 << 16) | (2 << 5))
  do jump(failure, 2)
  do emit(4181721088 | (1 << 10) | (1 << 5) | 3)
  do emit(4181721088 | (1 << 5) | 0)
  do emit(2852127712 | (3 << 16) | 1)
