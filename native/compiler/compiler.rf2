   end
   do advance()
   do store64(state() + 136, 0)
  else
   if (load64(state() + 152) != 0) & (load64(token(rhs)) == 1) & (precedence(rhs + 1) <= p) & (tmatch(rhs + 1, ".") == 0) & (tmatch(rhs + 1, "(") == 0) & (tmatch(rhs + 1, "[") == 0) & (logical_name(rhs) == 0)
    set slot = local_index(advance())
    do require(load64(local_type(load64(state() + 32), slot)) == 0, "scalar expression required")
