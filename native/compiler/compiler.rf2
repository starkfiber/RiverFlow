end
fn reuse_expression(f,minimum,depth)
 if depth>=64
  return 0
 end
 let i = load64(state()+24)
 let slot = 0
 let found = 0
 let comparison = 0
 let precedence_value = 0
 if match("-")|match("~")
  do advance()
  if reuse_expression(f,8,depth+1)==0
   return 0
  end
 else
  if match("(")
   do advance()
   if reuse_expression(f,1,depth+1)==0
    return 0
   end
   if match(")")==0
    return 0
   end
   do advance()
  else
   if load64(token(i))==2
    do advance()
   else
    if load64(token(i))!=1
     return 0
    end
    set slot = reuse_local_slot(f,i)
    if slot==0
     return 0
    end
    if load64(reuse_ready(slot-1))==0
