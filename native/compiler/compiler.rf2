 while i < n - 4
  set c = load8(p + i)
  if c == 47
   do require(segment != 0, "empty module path segment")
   set segment = 0
  else
   do require(letter(c) | digit(c) | (c == 45), "module path must use local identifier segments")
   set segment = segment + 1
  end
  set i = i + 1
