 do append32(72)
 do append_bytes(name, n)
 do header_zero(16 - n)
 do append64(vm)
 do append64(size)
 do append64(off)
 do append64(file_size)
 do append32(prot)
 do append32(prot)
 do append32(0)
 do append32(0)
