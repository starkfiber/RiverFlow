  do store64(flag+8,4)
  let answer = buffer("sha_feature_answer",8)
  do store64(answer,0)
  let rc = syscall6(274,"hw.optional.arm.FEAT_SHA256",27,answer,flag+8,0,0)
  if (rc == 0) & (load64(flag+8) == 4) & (load32(answer) == 1)
   do store64(flag,1)
  else
   do store64(flag,2)
  end
