end
fn arguments(depth)
 let count = 0
 let done = 0
 while done == 0
  do expression(1, depth + 1)
  do push()
  set count = count + 1
  do require(count <= 8, "argument bound")
  if match(",")
   do advance()
  else
   set done = 1
  end
 end
