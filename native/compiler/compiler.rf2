end
# Trusted private cache, deliberately limited to scalar single-expression helpers.
fn reuse_state()
 return buffer("reuse_state",128)
end
fn reuse_unit(f)
 return buffer("reuse_units",32768)+f*128
end
fn reuse_read(fd,p,max)
 let stat = buffer("reuse_stat",144)
 let n = 0
 let got = 0
 if syscall6(339,fd,stat,0,0,0,0)!=0
  do close(fd)
  return -1
 end
 if ((load32(stat+4)&61440)!=32768)|(load64(stat+96)>max)
  do close(fd)
  return -1
 end
 if (load32(stat+16)!=syscall6(24,0,0,0,0,0,0))|((load32(stat+4)&511)!=384)|((load32(stat+4)>>16)!=1)
  do close(fd)
  return -1
 end
 while n<=max
  set got = read(fd,p+n,max+1-n)
  if got>>63
   do close(fd)
   return -1
  end
  if got==0
   do close(fd)
   return n
  end
  set n = n+got
 end
 do close(fd)
 return -1
end
fn reuse_init(path)
