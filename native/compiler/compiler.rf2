 do require(fd<9223372036854775808,"function map output exists or cannot be created")
 do output(fd,"RF2_FUNCTION_MAP_V1\n",20)
 do map_number(fd,load64(state()+152))
 do output(fd," ",1)
 do map_number(fd,load64(image_options()))
 do output(fd," ",1)
 do map_hex(fd,map_context_digest(),32)
 do output(fd,"\n",1)
 let f = 0
 let t = 0
 let i = 0
 let fixup = 0
 let target = 0
 let found = 0
 let g = 0
 let start = 0
 let size = 0
 while f<load64(state()+40)
  set t = load64(ftable(f))
  set start = load64(function_code(f))
  set size = load64(function_code(f)+8)
  do output(fd,"F ",2)
  do output(fd,load64(token(t)+8),load64(token(t)+16))
  do output(fd," ",1)
  do map_number(fd,start)
  do output(fd," ",1)
  do map_number(fd,size)
  do output(fd," ",1)
  do map_hex(fd,map_token_digest(t-1,load64(ftable(f)+24)),32)
  do output(fd,"\n",1)
  set i = 0
  while i<load64(state()+64)
   set fixup = buffer("fixups",1048576)+i*24
   if (load64(fixup)>=start)&(load64(fixup)<start+size)
    do output(fd,"R ",2)
    do map_number(fd,load64(fixup)-start)
    do output(fd," ",1)
    do map_number(fd,load64(fixup+8))
    do output(fd," ",1)
    do map_number(fd,load64(fixup+16))
    do output(fd,"\n",1)
    # Direct call dependencies use checked symbol names rather than positional IDs.
    if (load64(fixup+8)==1)&((load32(buffer("code",1048576)+load64(fixup))>>26)==37)
     set target = load64(fixup+16)
     set g = 0
     set found = 0
     while g<load64(state()+40)
      if load64(ftable(g)+40)==target
       set found = 1
       set t = load64(ftable(g))
       do output(fd,"C ",2)
       do output(fd,load64(token(t)+8),load64(token(t)+16))
       do output(fd,"\n",1)
      end
      set g = g+1
     end
     do require(found,"function map unresolved direct call")
    end
   end
   set i = i+1
  end
  set f = f+1
