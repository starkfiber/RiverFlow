  do expect(",")
  do scalar_expression(1, depth + 1)
  do expect(")")
  if tmatch(name, "buffer_get")
   do access_local(1, slot + 3, 0)
   do emit(3942645791 | (1 << 16))
   do jump(range, 2)
   do access_local(1, slot + 2, 0)
   do emit(2332033024 | (0 << 16) | (1 << 5) | 0)
   do emit(960495616 | 1)
   do imm(0, 0)
   do jump(done, 16)
  else
   if tmatch(name, "buffer_reserve")
    do imm(1, load64(record_info(id) + 8))
    do emit(3942645791 | (1 << 16))
    do jump(invalid, 8)
    do access_local(1, slot + 4, 0)
    do emit(3942645791 | (1 << 16))
    do jump(same, 9)
    do push()
    do emit(4181721088 | (31 << 5) | 1)
    do vector_protect(slot, done)
    do pop1()
    do access_local(1, slot + 4, 1)
    do label(same)
    do imm(0, 0)
    do jump(done, 16)
   else
    do require(tmatch(name, "buffer_push"), "unknown vector operation")
    do imm(1, 255)
    do emit(3942645791 | (1 << 16))
    do jump(invalid, 8)
    do access_local(2, slot + 3, 0)
    do imm(1, load64(record_info(id) + 8))
    do emit(3942645791 | (1 << 16) | (2 << 5))
    do jump(invalid, 2)
    do push()
    do access_local(1, slot + 4, 0)
    do emit(3942645791 | (1 << 16) | (2 << 5))
    do jump(ready, 3)
    do imm(3, 1)
    do emit(2596282368 | (3 << 16) | (1 << 5) | 1)
    do imm(3, 16)
    do emit(3942645791 | (3 << 16) | (1 << 5))
    do jump(large, 2)
    do imm(1, 16)
    do label(large)
    do imm(3, load64(record_info(id) + 8))
    do emit(3942645791 | (3 << 16) | (1 << 5))
    do jump(clamped, 9)
    do emit(2852127712 | (3 << 16) | 1)
    do label(clamped)
    do emit(4177526784 | (1 << 10) | (31 << 5) | 1)
    do vector_protect(slot, done)
    do emit(4181721088 | (1 << 10) | (31 << 5) | 1)
