 let slot = 0
 let declaring = 0
 let valid = 1
 if tmatch(load64(p),"main")|(load64(function_result(f))!=0)|(load64(cleanup_count(f))!=0)
  return 0
 end
 while i<load64(p+32)
  if load64(local_type(f,i))!=0
   return 0
  end
  do store64(reuse_ready(i),i<load64(p+8))
  set i = i+1
 end
