  return 0
 end
 if (load64(token(i - 2)) != 2) | (tmatch(i - 3, ",") == 0)
  return 0
 end
 let n = load64(token(i - 2) + 24)
 let off = 0
 if tmatch(name,"fill_zero")
  if n > 256
   return 0
  end
  if n >= 16
   do emit(1325458432)
  end
  while off + 16 <= n
   do emit(1031798784 | ((off // 16) << 10))
   set off = off + 16
  end
  while off < n
   do emit(956301343 | (off << 10))
   set off = off + 1
  end
