 do require((root>>63)==0,"function cache requires existing private directory")
 let stat = buffer("reuse_stat",144)
 do require(syscall6(339,root,stat,0,0,0,0)==0,"function cache stat failed")
 do require((load32(stat+4)&61440)==16384,"function cache requires directory")
 do require(load32(stat+16)==syscall6(24,0,0,0,0,0,0),"function cache owner mismatch")
 do require((load32(stat+4)&63)==0,"function cache permissions must exclude group and other")
 do require(syscall6(131,root,6,0,0,0,0)==0,"function cache busy")
