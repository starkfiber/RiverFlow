profile RF2_SYSTEM_A64_V1
# Native trusted seed compiler. No uploaded source is accepted over MCP.
# Buffers are bounded; emitted zero-filled objects are streamed, not materialized.
fn state()
 return buffer("compiler_state", 256)
end
fn die(text)
 do write(2, text, length(text))
 do write(2, "\n", 1)
 do diagnostic_position()
 do exit(1)
 return 0
end
# Diagnostics are separate from compiler state and inactive outside source checks.
# Columns count source bytes; expanded module input is labelled honestly.
fn diagnostic_number(value)
 let digits = buffer("diagnostic_digits",32)
 let n = 0
 while 1
  do store8(digits+n,48+(value-(value//10)*10))
  set n = n+1
  set value = value//10
  if value==0
   while n
    set n = n-1
    do write(2,digits+n,1)
   end
   return 0
  end
 end
 return 0
end
fn diagnostic_position()
 let d = buffer("diagnostic_state",64)
 let phase = load64(d)
 if phase==0
  return 0
 end
 let source = load64(state())
 let size = load64(state()+8)
 let offset = load64(d+8)
 if phase==2
  let cursor = load64(state()+24)
  if cursor<load64(state()+16)
   set offset = load32(buffer("token_positions",262144)+cursor*4)
  else
   set offset = size
  end
 end
 if offset>size
  set offset = size
 end
 let line = 1
 let column = 1
 let i = 0
 while i<offset
  if load8(source+i)==10
   set line = line+1
   set column = 1
  else
   set column = column+1
  end
  set i = i+1
 end
 if load64(d+24)
  do write(2,"near expanded-source ",21)
 else
  do write(2,"near source ",12)
 end
 do diagnostic_number(line)
 do write(2,":",1)
 do diagnostic_number(column)
 do write(2," (line:byte-column; entry ",26)
 let path = load64(d+16)
 set i = 0
 while (i<256)&(load8(path+i)!=0)
  let c = load8(path+i)
  if (c<32)|(c>126)
   do write(2,"?",1)
  else
   do write(2,path+i,1)
  end
  set i = i+1
 end
 if i==256
  do write(2,"...",3)
 end
 do write(2,")\n",2)
 return 0
end
fn require(ok, text)
 if ok == 0
  do die(text)
 end
 return 0
end
fn length(p)
 let n = 0
 while load8(p + n) != 0
  set n = n + 1
 end
 return n
end
fn same(a, an, b, bn)
 let i = 0
 if an != bn
  return 0
 end
 while i < an
  if load8(a + i) != load8(b + i)
   return 0
  end
  set i = i + 1
 end
 return 1
end
fn cp(dst, src, n)
 let i = 0
 while i < n
  do store8(dst + i, load8(src + i))
  set i = i + 1
 end
 return dst
end
fn digit(c)
 if c < 48
  return 0
 end
 return c <= 57
end
fn letter(c)
 if c == 95
  return 1
 end
 if c >= 65
  if c <= 90
   return 1
  end
 end
 if c >= 97
  return c <= 122
 end
 return 0
end
fn token(i)
 do require(i < 65536, "token bound")
 return buffer("tokens", 2097152) + i * 32
end
fn add_token(kind, p, n, value)
 let s = state()
 let i = load64(s + 16)
 let t = token(i)
 do store32(buffer("token_positions",262144)+i*4,load64(buffer("diagnostic_state",64)+8))
 do store64(t, kind)
 do store64(t + 8, p)
 do store64(t + 16, n)
 do store64(t + 24, value)
 do store64(s + 16, i + 1)
 return i
end
fn tmatch(i, text)
 let t = token(i)
 return same(load64(t + 8), load64(t + 16), text, length(text))
end
# Shared compiler policy: bit1 reserved arithmetic, bit2 inline leaf, bit4 raw argument ABI.
# Length buckets avoid scanning impossible keyword matches. Unknown names stay conservative.
fn intrinsic_flags(i)
 let n = load64(token(i) + 16)
 if n == 3
  if tmatch(i,"all") | tmatch(i,"any") | tmatch(i,"not")
   return 2
  end
 end
 if n == 4
  if tmatch(i,"exit") | tmatch(i,"open") | tmatch(i,"read")
   return 4
  end
 end
 if n == 5
  if tmatch(i,"ror32")
   return 3
  end
 end
 if n == 5
  if tmatch(i,"close") | tmatch(i,"write")
   return 4
  end
 end
 if n == 5
  if tmatch(i,"load8")
   return 6
  end
 end
 if n == 6
  if tmatch(i,"buffer") | tmatch(i,"load32") | tmatch(i,"load64") | tmatch(i,"store8")
   return 6
  end
 end
 if n == 7
  if tmatch(i,"bswap32") | tmatch(i,"bswap64")
   return 3
  end
 end
 if n == 7
  if tmatch(i,"store32") | tmatch(i,"store64")
   return 6
  end
 end
 if n == 8
  if tmatch(i,"syscall6")
   return 4
  end
 end
 if n == 9
  if tmatch(i,"fill_zero")
   return 7
  end
 end
 if n == 12
  if tmatch(i,"fork_process")
   return 4
  end
 end
 if n == 12
  if tmatch(i,"bswap32_copy")
   return 7
  end
 end
 if n == 18
  if tmatch(i,"sha256_chain_armv8")
   return 7
  end
 end
 if n == 19
  if tmatch(i,"sha256_blocks_armv8")
   return 7
  end
 end
 return 0
end
fn match(text)
 let i = load64(state() + 24)
 let k = load64(token(i))
 if (k != 1) & (k != 4)
  return 0
 end
 return tmatch(i, text)
end
fn advance()
 let p = load64(state() + 24)
 do require(p < load64(state() + 16), "unexpected EOF")
 do store64(state() + 24, p + 1)
 return p
end
fn expect(text)
 if match(text) == 0
  do write(2, "expected: ", 10)
  do write(2, text, length(text))
  do write(2, " got: ", 6)
  let t = token(load64(state()+24))
  let p = load64(t+8)
  let n = load64(t+16)
  let i = 0
  while (i<n)&(i<80)
   let c = load8(p+i)
   if (c<32)|(c>126)
    do write(2,"?",1)
   else
    do write(2,p+i,1)
   end
   set i = i+1
  end
  if n>80
   do write(2,"...",3)
  end
  do die(" unexpected token")
 end
 return advance()
end
fn newline()
 let i = load64(state() + 24)
 do require(load64(token(i)) == 5, "expected newline")
 do advance()
 return 0
end
fn tokenize_tail(src, n, i, used)
 let c = 0
 let start = 0
 let value = 0
 let out = buffer("strings", 524288)
 let j = 0
 let stop = 0
 let quote = 0
 let h = 0
 let radix = 10
 while i < n
  do store64(buffer("diagnostic_state",64)+8,i)
  set c = load8(src + i)
  if c == 35
   set i = comment_end(src, n, i)
  else
   if c == 10
    do add_token(5, src + i, 1, 0)
    set i = i + 1
   else
    if c == 32
     set i = i + 1
    else
     if c == 9
      set i = i + 1
     else
      if c == 13
       set i = i + 1
      else
       set start = i
       if letter(c)
        set i = identifier_end(src, n, i)
        do add_token(1, src + start, i - start, 0)
       else
        if digit(c)
         set value = 0
         set radix = 10
         if i + 2 <= n
          if c == 48
           set h = load8(src + i + 1)
           if h == 120
            set radix = 16
            set i = i + 2
           end
          end
         end
         set stop = i
         set i = number_end(src, n, i, radix)
         do require(i > stop, "empty number")
         set j = stop
         while j < i
          set h = hex(load8(src + j))
          do require(value <= (18446744073709551615-h)//radix, "integer literal exceeds u64")
          set value = value * radix + h
          set j = j + 1
         end
         do add_token(2, src + start, i - start, value)
        else
         if c == 34
          set i = i + 1
          set j = used
          set stop = 0
          while stop == 0
           do require(i < n, "unterminated string")
           set c = load8(src + i)
           set i = i + 1
           if c == 34
            set stop = 1
           else
            do require(c >= 32, "raw control in string")
            if c == 92
             do require(i < n, "unterminated escape")
             set c = load8(src + i)
             set i = i + 1
             if c == 110
              set c = 10
             else
              if c == 114
               set c = 13
              else
               if c == 116
                set c = 9
               else
                if c == 98
                 set c = 8
                else
                 if c == 102
                  set c = 12
                 else
                  do require((c == 92) | (c == 34), "unsupported string escape")
                 end
                end
               end
              end
             end
            end
            do require(used < 524287, "string arena bound")
            do store8(out + used, c)
            set used = used + 1
           end
          end
          do add_token(3, out + j, used - j, 0)
          do store8(out + used, 0)
          set used = used + 1
         else
          set i = i + 1
          if i < n
           set h = load8(src + i)
           if c == h
            if (c == 47) | (c == 60) | (c == 62) | (c == 61)
             set i = i + 1
            end
           else
            if h == 61
             if (c == 33) | (c == 60) | (c == 62)
              set i = i + 1
             end
            end
           end
          end
          do add_token(4, src + start, i - start, 0)
         end
        end
       end
      end
     end
    end
   end
  end
 end
 do store64(buffer("diagnostic_state",64)+8,n)
 if load64(state() + 16) != 0
  if load64(token(load64(state() + 16) - 1)) != 5
   do add_token(5, "\n", 1, 0)
  end
 end
 do add_token(0, "", 0, 0)
 return 0
end
fn comment_end(src, n, i)
 while i < n
  if load8(src + i) == 10
   return i
  end
  set i = i + 1
 end
 return i
end
fn identifier_end(src, n, i)
 while i < n
  if letter(load8(src + i)) == 0
   if digit(load8(src + i)) == 0
    return i
   end
  end
  set i = i + 1
 end
 return i
end
fn hex(c)
 if digit(c)
  return c - 48
 end
 if c >= 65
  if c <= 70
   return c - 55
  end
 end
 if c >= 97
  if c <= 102
   return c - 87
  end
 end
 return 256
end
fn number_end(src, n, i, radix)
 while i < n
  if hex(load8(src + i)) >= radix
   return i
  end
  set i = i + 1
 end
 return i
end
fn ftable(i)
 do require(i < 256, "function bound")
 return buffer("functions", 12288) + i * 48
end
fn local(i, j)
 do require(j < 256, "local bound")
 return buffer("locals", 524288) + (i * 256 + j) * 8
end
fn name_equal(a, b)
 return same(load64(token(a) + 8), load64(token(a) + 16), load64(token(b) + 8), load64(token(b) + 16))
end
fn logical_name(tok)
 return tmatch(tok, "all") | tmatch(tok, "any") | tmatch(tok, "not") | tmatch(tok, "true") | tmatch(tok, "false")
end
fn add_local(f, tok)
 do require(logical_name(tok) == 0, "reserved logical name")
 let n = load64(ftable(f) + 32)
 let j = 0
 do require(load64(token(tok)) == 1, "local name required")
 while j < n
  if load64(local(f, j)) != 0
   do require(name_equal(load64(local(f, j)), tok) == 0, "duplicate local")
  end
  set j = j + 1
 end
 do store64(local(f, n), tok)
 do store64(ftable(f) + 32, n + 1)
 return n
end
fn find_local(tok)
 let f = load64(state() + 32)
 let j = 0
 while j < load64(ftable(f) + 32)
  if load64(local(f, j)) != 0
   if name_equal(load64(local(f, j)), tok)
    return j
   end
  end
  set j = j + 1
 end
 do die("unknown local")
 return 0
end
fn local_scope(f, slot)
 return buffer("local_scope", 524288) + (f * 256 + slot) * 8
end
fn local_binding(f, slot)
 return buffer("local_binding", 524288) + (f * 256 + slot) * 8
end
fn local_index(tok)
 let slot = find_local(tok)
 do require(load64(local_ready(load64(state() + 32), slot)), "local used before initialization or outside scope")
 return slot
end
fn leave_scope(depth)
 let f = load64(state() + 32)
 let i = load64(ftable(f) + 8)
 if depth == 0
  return 0
 end
 while i < load64(ftable(f) + 32)
  if load64(local_scope(f, i)) == depth
   do store64(local_ready(f, i), 0)
  end
  set i = i + 1
 end
 return 0
end
fn function_result(f)
 return buffer("function_result", 2048) + f * 8
end
fn function_index(tok)
 let i = 0
 while i < load64(state() + 40)
  if name_equal(load64(ftable(i)), tok)
   return i
  end
  set i = i + 1
 end
 do die("unknown function")
 return 0
end
fn record_info(id)
 do require((id > 0) & (id <= 32), "record bound")
 return buffer("record_info", 5120) + (id - 1) * 160
end
fn record_index(tok)
 let id = 1
 while id <= load64(state() + 128)
  if name_equal(load64(record_info(id)), tok)
   return id
  end
  set id = id + 1
 end
 return 0
end
fn local_type(f, slot)
 return buffer("local_types", 524288) + (f * 256 + slot) * 8
end
fn local_ready(f, slot)
 return buffer("local_ready", 524288) + (f * 256 + slot) * 8
end
fn field_index(id, tok)
 let r = record_info(id)
 let i = 0
 while i < load64(r + 8)
  if name_equal(load64(r + 16 + i * 8), tok)
   return i
  end
  set i = i + 1
 end
 do die("unknown record field")
 return 0
end
fn scan_record()
 let is_array = match("array")
 let is_result = match("result")
 let is_view = match("view") | match("textview")
 let is_text = match("textview")
 let is_resource = match("resource")
 let is_vector = match("vector")
 do advance()
 let t = advance()
 do require(load64(token(t)) == 1, "record name required")
 do require((tmatch(t, "mapping_store32") | tmatch(t, "mapping_read64") | tmatch(t, "vm_map_owned") | tmatch(t, "vm_unmap_owned") | tmatch(t, "vm_protect_owned") | tmatch(t, "vcpu_set_owned") | tmatch(t, "vcpu_sys_owned") | tmatch(t, "vcpu_read_owned") | tmatch(t, "vcpu_run_owned") | tmatch(t, "vcpu_cancel_owned") | tmatch(t, "vcpu_offset_owned") | tmatch(t, "vcpu_timer_owned") | tmatch(t, "vm_clock_ticks") | tmatch(t, "clock_timebase")) == 0, "reserved platform name")
 do require(record_index(t) == 0, "duplicate record")
 do require(logical_name(t) == 0, "reserved logical name")
 do require((intrinsic_flags(t) & 1) == 0, "reserved arithmetic name")
 do require((tmatch(t, "read_bytes") | tmatch(t, "write_bytes") | tmatch(t, "buffer") | tmatch(t, "load8") | tmatch(t, "load32") | tmatch(t, "load64") | tmatch(t, "store8") | tmatch(t, "store32") | tmatch(t, "store64") | tmatch(t, "read") | tmatch(t, "write") | tmatch(t, "open") | tmatch(t, "close") | tmatch(t, "exit") | tmatch(t, "read_owned") | tmatch(t, "write_owned") | tmatch(t, "release") | tmatch(t, "buffer_reserve") | tmatch(t, "buffer_push") | tmatch(t, "buffer_get") | tmatch(t, "buffer_clear") | tmatch(t, "syscall6") | tmatch(t, "fork_process")) == 0, "reserved record name")
 let id = load64(state() + 128) + 1
 let r = record_info(id)
 let f = 0
 while f < load64(state() + 40)
  do require(name_equal(load64(ftable(f)), t) == 0, "record collides with function")
  set f = f + 1
 end
 do store64(r, t)
 do expect("(")
 let n = 0
 let field = 0
 let j = 0
 if is_result
  do require((tmatch(t, "u64") | tmatch(t, "u8")) == 0, "reserved result name")
  set field = advance()
  if tmatch(field, "u64") == 0
   set field = record_index(field)
   do require(field != 0, "unknown result payload type")
   do require(load64(record_info(field) + 144) == 0, "result payload requires scalar record")
   do require(load64(record_info(field) + 8) <= 4, "result record payload field bound")
   do store64(r + 152, field)
  end
  do expect(",")
  do expect("u64")
  do expect(")")
  do store64(r + 8, 2)
  do store64(r + 144, 3)
  do store64(state() + 128, id)
  return newline()
 end
 if is_vector
  set field = record_index(advance())
  do require(field != 0, "vector result type required")
  do require(load64(record_info(field) + 144) == 3, "vector requires result type")
  do require(load64(record_info(field) + 152) == 0, "vector requires scalar IO result")
  do store64(r + 152, field)
  do expect(",")
  set field = advance()
  do require(load64(token(field)) == 2, "vector limit literal required")
  set n = load64(token(field) + 24)
  do require((n > 0) & (n <= 1048576), "vector limit bound")
  do require((load64(token(field) + 16) <= 7) & (load8(load64(token(field) + 8)) >= 49) & (load8(load64(token(field) + 8)) <= 57), "vector limit canonical decimal required")
  do store64(r + 8, n)
  do store64(r + 144, 7)
  do store64(state() + 128, id)
  do expect(")")
  return newline()
 end
 if is_resource
  set field = record_index(advance())
  do require(field != 0, "resource result type required")
  do require(load64(record_info(field) + 144) == 3, "resource requires result type")
  do require(load64(record_info(field) + 152) == 0, "resource requires scalar IO result")
  let resource_kind = 6
  if match(",")
   do advance()
   if match("vm")
    set resource_kind = 8
   else
    if match("mapping")
     do advance()
     set resource_kind = 10
    else
     do expect("vcpu")
     set resource_kind = 9
    end
   end
   if resource_kind == 8
    do advance()
   end
  end
  do expect(")")
  do store64(r + 8, 2 + (resource_kind == 9) * 2 + (resource_kind == 10) * 3)
  do store64(r + 144, resource_kind)
  do store64(r + 152, field)
  do store64(state() + 128, id)
  return newline()
 end
 if is_view
  set field = record_index(advance())
  do require(field != 0, "view source type required")
  do require(load64(record_info(field) + 144) == 2, "view requires byte array type")
  do expect(")")
  do store64(r + 8, 2 + is_text)
  do store64(r + 144, 4 + is_text)
  do store64(r + 152, field)
  do store64(state() + 128, id)
  return newline()
 end
 if is_array
  do require(tmatch(t, "u64") == 0, "reserved array name")
  do require(match("u64") | match("u8"), "array element type required")
  do store64(r + 144, 1 + match("u8"))
  do advance()
  do expect(",")
  set field = advance()
  do require(load64(token(field)) == 2, "array length literal required")
  set n = load64(token(field) + 24)
  do require((n > 0) & (n <= 255), "array length bound")
  do require((load64(token(field) + 16) <= 3) & (load8(load64(token(field) + 8)) != 48), "array length canonical decimal required")
  do store64(r + 8, n)
  do store64(state() + 128, id)
  do expect(")")
  return newline()
 end
 while match(")") == 0
  do require(n < 16, "record field bound")
  set field = advance()
  do require(load64(token(field)) == 1, "field name required")
  set j = 0
  while j < n
   do require(name_equal(load64(r + 16 + j * 8), field) == 0, "duplicate field")
   set j = j + 1
  end
  do expect(":")
  do expect("u64")
  do store64(r + 16 + n * 8, field)
  set n = n + 1
  if match(",")
   do advance()
   do require(match(")") == 0, "trailing field comma")
  else
   do require(match(")"), "expected field comma")
  end
 end
 do require(n > 0, "empty record")
 do store64(r + 8, n)
 do store64(state() + 128, id)
 do expect(")")
 return newline()
end
fn scalar_expression(minimum, depth)
 do expression(minimum, depth)
 return require(load64(state() + 136) == 0, "scalar expression required")
end
fn construct_record(target, depth)
 do require(depth == 0, "record declarations must be function-level")
 let f = load64(state() + 32)
 let id = load64(local_type(f, target))
 do require((load64(record_info(id) + 144) != 6) & (load64(record_info(id) + 144) != 7) & (load64(record_info(id) + 144) < 8), "resource requires own declaration")
 do require(load64(record_info(id) + 144) != 3, "result values require handle")
 if load64(record_info(id) + 144) >= 4
  return construct_view(target, depth)
 end
 do require(target >= load64(ftable(f) + 8), "record parameter rebinding refused")
 do require(record_index(advance()) == id, "record constructor type mismatch")
 do expect("(")
 let i = 0
 let n = load64(record_info(id) + 8)
 if load64(record_info(id) + 144)
  if load64(record_info(id) + 144) == 2
   set n = (n + 7) // 8
  end
  do expect(")")
  do imm(0, 0)
  while i < n
   do access_local(0, target + 1 + i, 1)
   set i = i + 1
  end
 else
 while i < n
  if i != 0
   do expect(",")
  end
  do scalar_expression(1, 0)
  do access_local(0, target + 1 + i, 1)
  set i = i + 1
 end
 do expect(")")
 end
 do emit(2432697248 | (((target + 1) * 8) << 10))
 do access_local(0, target, 1)
 do store64(local_ready(f, target), 1)
 return 0
end
fn next_label()
 let n = load64(state() + 48)
 do require(n < 65536, "label bound")
 do store64(state() + 48, n + 1)
 do store64(buffer("labels", 524288) + n * 8, 18446744073709551615)
 return n
end
fn label(n)
 let p = buffer("labels", 524288) + n * 8
 do require(load64(p) == 18446744073709551615, "duplicate label")
 do store64(p, load64(state() + 56))
 return 0
end
fn emit(w)
 let s = state()
 let n = load64(s + 56)
 let target = load64(s + 168)
 let top = w >> 24
 let use_source = 0
 let use_right = 0
 let narrow = load64(s + 176)
 let immr = 0
 let imms = 0
 if target != 0
  if (top == 210) | (top == 242)
   set use_source = 0
  else
   if (top == 145) | (top == 209) | (top == 211) | (top == 249) | (top == 241)
    set use_source = 1
   else
    do require((top == 139) | (top == 203) | (top == 138) | (top == 170) | (top == 202) | (top == 235) | (top == 155) | (top == 154), "unsupported coalesced instruction")
    set use_source = 1
    set use_right = 1
   end
  end
  if (w & 31) == 0
