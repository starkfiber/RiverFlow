fn invoke_byte_io(name, depth)
 let id = 0
 let go = next_label()
 let done = next_label()
 do scalar_expression(1, depth + 1)
 do push()
 do expect(",")
 do expression(1, depth + 1)
 set id = load64(state() + 136)
 do require(id != 0, "byte IO requires byte array")
 do require(load64(record_info(id) + 144) == 2, "byte IO requires byte array")
 do push()
 do expect(",")
 do scalar_expression(1, depth + 1)
 do push()
 do expect(")")
 do emit(4181722082)
 do emit(2432713727)
 do emit(4181722081)
 do emit(2432713727)
 do emit(4181722080)
 do emit(2432713727)
 do imm(3, load64(record_info(id) + 8))
 do emit(3942645791 | (3 << 16) | (2 << 5))
 do jump(go, 9)
 do imm(0, 18446744073709551594)
 do jump(done, 16)
 do label(go)
 if tmatch(name, "read_bytes")
  do imm(16, 3)
 else
  do imm(16, 4)
 end
 do emit(3556773889)
 do jump(done, 3)
 do emit(3405775840)
 do label(done)
 do store64(state() + 136, 0)
 return 0
end
fn invoke_logic(name, depth)
 let skip = next_label()
 let done = next_label()
 do scalar_expression(1, depth + 1)
 do emit(4043309087)
 if tmatch(name, "not")
  do expect(")")
  do emit(2594113504 | (1 << 12))
 else
  do expect(",")
  do jump(skip, tmatch(name, "any"))
  do scalar_expression(1, depth + 1)
  do expect(")")
  do emit(4043309087)
  do emit(2594113504)
  do jump(done, 16)
  do label(skip)
  do imm(0, tmatch(name, "any"))
  do label(done)
 end
 do store64(state() + 136, 0)
 return 0
end
# Explicit CLI-only platform imports; scalar ABI and fixed system framework only.
fn platform_state()
 return buffer("platform_state",24)
end
fn platform_import(i)
 do require(i<32,"platform import bound")
 return buffer("platform_imports",768)+i*24
end
fn platform_arity(t)
 if tmatch(t,"hv_vm_create") | tmatch(t,"hv_vm_get_max_vcpu_count") | tmatch(t,"hv_vcpu_destroy") | tmatch(t,"hv_vcpu_run")
  return 2
 end
 if tmatch(t,"hv_vm_destroy")
  return 1
 end
 if tmatch(t,"hv_vm_map")
  return 5
 end
 if tmatch(t,"hv_vm_unmap") | tmatch(t,"hv_vcpus_exit") | tmatch(t,"hv_vcpu_set_vtimer_mask") | tmatch(t,"hv_vcpu_set_vtimer_offset")
  return 3
 end
 if tmatch(t,"hv_vm_protect") | tmatch(t,"hv_vcpu_create") | tmatch(t,"hv_vcpu_set_reg") | tmatch(t,"hv_vcpu_get_reg") | tmatch(t,"hv_vcpu_set_sys_reg")
  return 4
 end
 return 0
end
fn platform_object(t)
 let i = 0
 let n = load64(platform_state())
 while i<n
  if name_equal(load64(platform_import(i)),t)
   return load64(platform_import(i)+8)
  end
  set i = i+1
 end
 do require(n<32,"platform import bound")
 let obj = intern(3,t,8)
 do store64(platform_import(n),t)
 do store64(platform_import(n)+8,obj)
 do store64(platform_import(n)+16,2)
 do store64(platform_state(),n+1)
 return obj
end
fn invoke_platform(depth)
 let library = advance()
 do require(load64(token(library))==3,"platform library literal required")
 do require(tmatch(library,"Hypervisor"),"unsupported platform library")
 do expect(",")
 let symbol = advance()
 do require(load64(token(symbol))==3,"platform symbol literal required")
 let arity = platform_arity(symbol)
 do require(arity!=0,"unsupported platform symbol")
 let count = 0
 if match(",")
  do advance()
  set count = arguments(depth,0)
 end
 do expect(")")
 do require(count+1==arity,"platform call arity")
 let i = count
 while i!=0
  set i = i-1
  do emit(4181722080|i)
  do emit(2432713727)
 end
 do address(16,platform_object(symbol))
 do emit(4181721616)
 # LDR X16,[X16]; BLR X16. Imported functions follow the system scalar ABI.
 do emit(3594453504)
 do emit(3544186880|(31<<10))
 do store64(state()+136,0)
 return 0
end
fn bind_byte(v)
 let n = load64(platform_state()+8)
 do require(n<16384,"platform bind bound")
 do store8(buffer("platform_bind",16384)+n,v)
 do store64(platform_state()+8,n+1)
 return 0
end
fn bind_uleb(v)
 while v>=128
  do bind_byte((v&127)|128)
  set v = v>>7
 end
 return bind_byte(v)
end
fn platform_bindings()
 let i = 0
 let j = 0
 let t = 0
 let raw = 0
 while i<load64(platform_state())
  set t = token(load64(platform_import(i)))
  do bind_byte(16 | load64(platform_import(i)+16))
  do bind_byte(64)
  do bind_byte(95)
  set j = 0
  set raw = load64(t+8)
  while j<load64(t+16)
   do bind_byte(load8(raw+j))
   set j = j+1
  end
  do bind_byte(0)
  do bind_byte(81)
  do bind_byte(114)
  do bind_uleb(load64(object(load64(platform_import(i)+8))+24))
  do bind_byte(144)
  set i = i+1
 end
 if i!=0
  do bind_byte(0)
 end
 return load64(platform_state()+8)
end
