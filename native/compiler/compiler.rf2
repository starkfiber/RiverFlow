fn array_address(id)
 do require(id != 0, "index requires array/view")
 let kind = load64(record_info(id) + 144)
 do require((kind == 1) | (kind == 2) | (kind == 4) | (kind == 5) | (kind == 7), "index requires array/view")
 let failure = bounds_failure_label()
 if kind == 7
  do emit(4181721088 | (1 << 5) | 2)
  do emit(4043309087 | (2 << 5))
  do jump(failure, 0)
  do emit(4181721088 | (2 << 10) | (1 << 5) | 2)
  do emit(3942645791 | (2 << 16))
  do jump(failure, 2)
  do emit(4181721088 | (1 << 10) | (1 << 5) | 1)
