profile RF2_SYSTEM_A64_V1
# Native trusted seed compiler. No uploaded source is accepted over MCP.
# Buffers are bounded; emitted zero-filled objects are streamed, not materialized.
fn state()
 return buffer("compiler_state", 256)
end
fn die(text)
 do write(2, text, length(text))
 do write(2, "\n", 1)
 do exit(1)
 return 0
end
fn require(ok, text)
 if ok == 0
  do die(text)
 end
 return 0
end
fn length(p)
 let n = 0
 while load8(p + n) != 0
  set n = n + 1
 end
 return n
end
fn same(a, an, b, bn)
 let i = 0
 if an != bn
  return 0
 end
 while i < an
  if load8(a + i) != load8(b + i)
   return 0
  end
  set i = i + 1
 end
 return 1
end
fn cp(dst, src, n)
 let i = 0
 while i < n
  do store8(dst + i, load8(src + i))
  set i = i + 1
 end
 return dst
end
fn digit(c)
 if c < 48
  return 0
 end
 return c <= 57
end
fn letter(c)
 if c == 95
  return 1
 end
 if c >= 65
  if c <= 90
   return 1
  end
 end
 if c >= 97
  return c <= 122
 end
 return 0
end
fn token(i)
 do require(i < 65536, "token bound")
 return buffer("tokens", 2097152) + i * 32
end
fn add_token(kind, p, n, value)
 let s = state()
 let i = load64(s + 16)
 let t = token(i)
 do store64(t, kind)
 do store64(t + 8, p)
 do store64(t + 16, n)
 do store64(t + 24, value)
 do store64(s + 16, i + 1)
 return i
end
fn tmatch(i, text)
 let t = token(i)
 return same(load64(t + 8), load64(t + 16), text, length(text))
end
fn match(text)
 let i = load64(state() + 24)
 let k = load64(token(i))
 if (k != 1) & (k != 4)
  return 0
 end
 return tmatch(i, text)
end
fn advance()
 let p = load64(state() + 24)
 do require(p < load64(state() + 16), "unexpected EOF")
 do store64(state() + 24, p + 1)
 return p
end
fn expect(text)
 if match(text) == 0
  do write(2, "expected: ", 10)
  do write(2, text, length(text))
  do write(2, " got: ", 6)
  do write(2, load64(token(load64(state() + 24)) + 8), load64(token(load64(state() + 24)) + 16))
  do die(" unexpected token")
 end
 return advance()
end
fn newline()
 let i = load64(state() + 24)
 do require(load64(token(i)) == 5, "expected newline")
 do advance()
 return 0
end
fn tokenize_tail(src, n, i, used)
 let c = 0
 let start = 0
 let value = 0
 let out = buffer("strings", 524288)
 let j = 0
 let stop = 0
 let quote = 0
 let h = 0
 let radix = 10
 while i < n
  set c = load8(src + i)
  if c == 35
   set i = comment_end(src, n, i)
  else
   if c == 10
    do add_token(5, src + i, 1, 0)
    set i = i + 1
   else
    if c == 32
     set i = i + 1
    else
     if c == 9
      set i = i + 1
     else
      if c == 13
       set i = i + 1
      else
       set start = i
       if letter(c)
        set i = identifier_end(src, n, i)
        do add_token(1, src + start, i - start, 0)
       else
        if digit(c)
         set value = 0
         set radix = 10
         if i + 2 <= n
          if c == 48
           set h = load8(src + i + 1)
           if h == 120
            set radix = 16
            set i = i + 2
           end
          end
         end
         set stop = i
         set i = number_end(src, n, i, radix)
         do require(i > stop, "empty number")
         set j = stop
         while j < i
          set h = hex(load8(src + j))
          set value = value * radix + h
          set j = j + 1
         end
         do add_token(2, src + start, i - start, value)
        else
         if c == 34
          set i = i + 1
          set j = used
          set stop = 0
          while stop == 0
           do require(i < n, "unterminated string")
           set c = load8(src + i)
           set i = i + 1
           if c == 34
            set stop = 1
           else
            do require(c >= 32, "raw control in string")
            if c == 92
             do require(i < n, "unterminated escape")
             set c = load8(src + i)
             set i = i + 1
             if c == 110
              set c = 10
             else
              if c == 114
               set c = 13
              else
               if c == 116
                set c = 9
               else
                if c == 98
                 set c = 8
                else
                 if c == 102
                  set c = 12
                 else
                  do require((c == 92) | (c == 34), "unsupported string escape")
                 end
                end
               end
              end
             end
            end
            do require(used < 524287, "string arena bound")
            do store8(out + used, c)
            set used = used + 1
           end
          end
          do add_token(3, out + j, used - j, 0)
          do store8(out + used, 0)
          set used = used + 1
         else
          set i = i + 1
          if i < n
           set h = load8(src + i)
           if c == h
            if (c == 47) | (c == 60) | (c == 62) | (c == 61)
             set i = i + 1
            end
           else
            if h == 61
             if (c == 33) | (c == 60) | (c == 62)
              set i = i + 1
             end
            end
           end
          end
          do add_token(4, src + start, i - start, 0)
         end
        end
       end
      end
     end
    end
   end
  end
 end
 if load64(state() + 16) != 0
  if load64(token(load64(state() + 16) - 1)) != 5
   do add_token(5, "\n", 1, 0)
  end
 end
 do add_token(0, "", 0, 0)
 return 0
end
fn comment_end(src, n, i)
 while i < n
  if load8(src + i) == 10
   return i
  end
  set i = i + 1
 end
 return i
end
fn identifier_end(src, n, i)
 while i < n
  if letter(load8(src + i)) == 0
   if digit(load8(src + i)) == 0
    return i
   end
  end
  set i = i + 1
 end
 return i
end
fn hex(c)
 if digit(c)
  return c - 48
 end
 if c >= 65
  if c <= 70
   return c - 55
  end
 end
 if c >= 97
  if c <= 102
   return c - 87
  end
 end
 return 256
end
fn number_end(src, n, i, radix)
 while i < n
  if hex(load8(src + i)) >= radix
   return i
  end
  set i = i + 1
 end
 return i
end
fn ftable(i)
 do require(i < 256, "function bound")
 return buffer("functions", 12288) + i * 48
end
fn local(i, j)
 do require(j < 256, "local bound")
 return buffer("locals", 524288) + (i * 256 + j) * 8
end
fn name_equal(a, b)
 return same(load64(token(a) + 8), load64(token(a) + 16), load64(token(b) + 8), load64(token(b) + 16))
end
fn add_local(f, tok)
 let n = load64(ftable(f) + 32)
 let j = 0
 do require(load64(token(tok)) == 1, "local name required")
 while j < n
  if load64(local(f, j)) != 0
   do require(name_equal(load64(local(f, j)), tok) == 0, "duplicate local")
  end
  set j = j + 1
 end
 do store64(local(f, n), tok)
 do store64(ftable(f) + 32, n + 1)
 return n
end
fn find_local(tok)
 let f = load64(state() + 32)
 let j = 0
 while j < load64(ftable(f) + 32)
  if load64(local(f, j)) != 0
   if name_equal(load64(local(f, j)), tok)
    return j
   end
  end
  set j = j + 1
 end
 do die("unknown local")
 return 0
end
fn local_scope(f, slot)
 return buffer("local_scope", 524288) + (f * 256 + slot) * 8
end
fn local_binding(f, slot)
 return buffer("local_binding", 524288) + (f * 256 + slot) * 8
end
fn local_index(tok)
 let slot = find_local(tok)
 do require(load64(local_ready(load64(state() + 32), slot)), "local used before initialization or outside scope")
 return slot
end
fn leave_scope(depth)
 let f = load64(state() + 32)
 let i = load64(ftable(f) + 8)
 if depth == 0
  return 0
 end
 while i < load64(ftable(f) + 32)
  if load64(local_scope(f, i)) == depth
   do store64(local_ready(f, i), 0)
  end
  set i = i + 1
 end
 return 0
end
fn function_result(f)
 return buffer("function_result", 2048) + f * 8
end
fn function_index(tok)
 let i = 0
 while i < load64(state() + 40)
  if name_equal(load64(ftable(i)), tok)
   return i
  end
  set i = i + 1
 end
 do die("unknown function")
 return 0
end
fn record_info(id)
 do require((id > 0) & (id <= 32), "record bound")
 return buffer("record_info", 5120) + (id - 1) * 160
end
fn record_index(tok)
 let id = 1
 while id <= load64(state() + 128)
  if name_equal(load64(record_info(id)), tok)
   return id
  end
  set id = id + 1
 end
 return 0
end
fn local_type(f, slot)
 return buffer("local_types", 524288) + (f * 256 + slot) * 8
end
fn local_ready(f, slot)
 return buffer("local_ready", 524288) + (f * 256 + slot) * 8
end
fn field_index(id, tok)
 let r = record_info(id)
 let i = 0
 while i < load64(r + 8)
  if name_equal(load64(r + 16 + i * 8), tok)
   return i
  end
  set i = i + 1
 end
 do die("unknown record field")
 return 0
end
fn scan_record()
 let is_array = match("array")
 let is_result = match("result")
 let is_view = match("view") | match("textview")
 let is_text = match("textview")
 do advance()
 let t = advance()
 do require(load64(token(t)) == 1, "record name required")
 do require(record_index(t) == 0, "duplicate record")
 do require((tmatch(t, "read_bytes") | tmatch(t, "write_bytes") | tmatch(t, "buffer") | tmatch(t, "load8") | tmatch(t, "load32") | tmatch(t, "load64") | tmatch(t, "store8") | tmatch(t, "store32") | tmatch(t, "store64") | tmatch(t, "read") | tmatch(t, "write") | tmatch(t, "open") | tmatch(t, "close") | tmatch(t, "exit") | tmatch(t, "syscall6") | tmatch(t, "fork_process")) == 0, "reserved record name")
 let id = load64(state() + 128) + 1
 let r = record_info(id)
 let f = 0
 while f < load64(state() + 40)
  do require(name_equal(load64(ftable(f)), t) == 0, "record collides with function")
  set f = f + 1
 end
 do store64(r, t)
 do expect("(")
 let n = 0
 let field = 0
 let j = 0
 if is_result
  do require((tmatch(t, "u64") | tmatch(t, "u8")) == 0, "reserved result name")
  do expect("u64")
  do expect(",")
  do expect("u64")
  do expect(")")
  do store64(r + 8, 2)
  do store64(r + 144, 3)
  do store64(state() + 128, id)
  return newline()
 end
 if is_view
  set field = record_index(advance())
  do require(field != 0, "view source type required")
  do require(load64(record_info(field) + 144) == 2, "view requires byte array type")
  do expect(")")
  do store64(r + 8, 2 + is_text)
  do store64(r + 144, 4 + is_text)
  do store64(r + 152, field)
  do store64(state() + 128, id)
  return newline()
 end
 if is_array
  do require(tmatch(t, "u64") == 0, "reserved array name")
  do require(match("u64") | match("u8"), "array element type required")
  do store64(r + 144, 1 + match("u8"))
  do advance()
  do expect(",")
  set field = advance()
  do require(load64(token(field)) == 2, "array length literal required")
  set n = load64(token(field) + 24)
  do require((n > 0) & (n <= 255), "array length bound")
  do require((load64(token(field) + 16) <= 3) & (load8(load64(token(field) + 8)) != 48), "array length canonical decimal required")
  do store64(r + 8, n)
  do store64(state() + 128, id)
  do expect(")")
  return newline()
 end
 while match(")") == 0
  do require(n < 16, "record field bound")
  set field = advance()
  do require(load64(token(field)) == 1, "field name required")
  set j = 0
  while j < n
   do require(name_equal(load64(r + 16 + j * 8), field) == 0, "duplicate field")
   set j = j + 1
  end
  do expect(":")
  do expect("u64")
  do store64(r + 16 + n * 8, field)
  set n = n + 1
  if match(",")
   do advance()
   do require(match(")") == 0, "trailing field comma")
  else
   do require(match(")"), "expected field comma")
  end
 end
 do require(n > 0, "empty record")
 do store64(r + 8, n)
 do store64(state() + 128, id)
 do expect(")")
 return newline()
end
fn scalar_expression(minimum, depth)
 do expression(minimum, depth)
 return require(load64(state() + 136) == 0, "scalar expression required")
end
fn construct_record(target, depth)
 do require(depth == 0, "record declarations must be function-level")
 let f = load64(state() + 32)
 let id = load64(local_type(f, target))
 do require(load64(record_info(id) + 144) != 3, "result values require handle")
 if load64(record_info(id) + 144) >= 4
  return construct_view(target, depth)
 end
 do require(target >= load64(ftable(f) + 8), "record parameter rebinding refused")
 do require(record_index(advance()) == id, "record constructor type mismatch")
 do expect("(")
 let i = 0
 let n = load64(record_info(id) + 8)
 if load64(record_info(id) + 144)
  if load64(record_info(id) + 144) == 2
   set n = (n + 7) // 8
  end
  do expect(")")
  do imm(0, 0)
  while i < n
   do access_local(0, target + 1 + i, 1)
   set i = i + 1
  end
 else
 while i < n
  if i != 0
   do expect(",")
  end
  do scalar_expression(1, 0)
  do access_local(0, target + 1 + i, 1)
  set i = i + 1
 end
 do expect(")")
 end
 do emit(2432697248 | (((target + 1) * 8) << 10))
 do access_local(0, target, 1)
 do store64(local_ready(f, target), 1)
 return 0
end
fn next_label()
 let n = load64(state() + 48)
 do require(n < 65536, "label bound")
 do store64(state() + 48, n + 1)
 do store64(buffer("labels", 524288) + n * 8, 18446744073709551615)
 return n
end
fn label(n)
 let p = buffer("labels", 524288) + n * 8
 do require(load64(p) == 18446744073709551615, "duplicate label")
 do store64(p, load64(state() + 56))
 return 0
end
fn emit(w)
 let s = state()
 let n = load64(s + 56)
 let target = load64(s + 168)
 let top = w >> 24
 let use_source = 0
 let use_right = 0
 let narrow = load64(s + 176)
 let immr = 0
 let imms = 0
 if target != 0
  if (top == 210) | (top == 242)
   set use_source = 0
  else
   if (top == 145) | (top == 209) | (top == 211) | (top == 249) | (top == 241)
    set use_source = 1
   else
    do require((top == 139) | (top == 203) | (top == 138) | (top == 170) | (top == 202) | (top == 235) | (top == 155) | (top == 154), "unsupported coalesced instruction")
    set use_source = 1
    set use_right = 1
   end
  end
  if (w & 31) == 0
   set w = w | target
  end
  if use_source & (((w >> 5) & 31) == 0)
   set w = w | (target << 5)
  end
  if use_right & (((w >> 16) & 31) == 0)
   set w = w | (target << 16)
  end
  if w == (2852127712 | (target << 16) | target)
   return 0
  end
  if narrow
   if top == 249
    if ((w >> 22) & 1) & ((w & 31) == target)
     do store64(s + 184, 0)
    end
   else
    if ((top == 145) | (top == 209)) & (((w & 31) == 31) | (((w >> 5) & 31) == 31))
     set narrow = 0
    end
    if narrow
     if (top == 242) & (((w >> 21) & 3) >= 2)
      return 0
     end
     if top == 211
      set immr = (w >> 16) & 63
      set imms = (w >> 10) & 63
      if (immr == 0) & (imms >= 31)
       if load64(s + 184)
        return 0
       end
       set w = 704644064 | (target << 16) | target
      else
       if imms + 1 == immr
        do require(immr > 32, "invalid narrowed left shift")
        set w = (w & 4290774015) | ((immr - 32) << 16) | ((imms - 32) << 10)
       else
        do require((immr < 32) & (imms < 32), "unsupported narrowed bitfield")
       end
       set w = w & 2143289343
      end
     else
      set w = w & 2147483647
     end
     if (w & 31) == target
      do store64(s + 184, 1)
     end
    end
   end
  end
 end
 do require(n < 1048576, "code bound")
 do store32(buffer("code", 1048576) + n, w)
 do store64(s + 56, n + 4)
 return 0
end
fn fix(kind, target)
 let n = load64(state() + 64)
 let p = buffer("fixups", 1048576) + n * 24
 do require(n < 43690, "fixup bound")
 do store64(p, load64(state() + 56))
 do store64(p + 8, kind)
 do store64(p + 16, target)
 do store64(state() + 64, n + 1)
 return 0
end
fn jump(target, cond)
 if cond == 16
  do fix(1, target)
  do emit(335544320)
 else
  do fix(2, target)
  do emit(1409286144 | cond)
 end
 return 0
end
fn imm(r, n)
 let i = 1
 let v = 0
 do emit(3531603968 | ((n & 65535) << 5) | r)
 while i < 4
  set v = (n >> (i * 16)) & 65535
  if v != 0
   do emit(4068474880 | (i << 21) | (v << 5) | r)
  end
  set i = i + 1
 end
 return 0
end
fn push()
 do emit(3506455551)
 return emit(4177527776)
end
fn pop1()
 do emit(4181722081)
 return emit(2432713727)
end
fn function_leaf(f)
 return buffer("function_leaf", 2048) + f * 8
end
fn mark_call(f, i)
 if (load64(token(i)) == 1) & tmatch(i + 1, "(")
  do store64(function_leaf(f), 0)
 end
 return 0
end
fn mapped_local(i)
 if (load64(state() + 152) != 0) & (i < 8)
  if load64(local(load64(state() + 32), i)) != 0
   if load64(function_leaf(load64(state() + 32)))
    if i < 7
     return 9 + i
    end
    return 0
   end
   return 19 + i
  end
 end
 return 0
end
fn access_local(r, i, writing)
 let reg = mapped_local(i)
 if reg != 0
  if writing
   return emit(2852127712 | (r << 16) | reg)
  end
  return emit(2852127712 | (reg << 16) | r)
 end
 if writing
  return emit(4177526784 | (i << 10) | (29 << 5) | r)
 end
 return emit(4181721088 | (i << 10) | (29 << 5) | r)
end
fn object(i)
 do require(i < 8192, "object bound")
 return buffer("objects", 327680) + i * 40
end
fn intern(kind, t, size)
 let i = 0
 let n = load64(state() + 72)
 let p = 0
 let offset = 0
 while i < n
  set p = object(i)
  if load64(p) == kind
   if name_equal(load64(p + 8), t)
    do require(load64(p + 16) == size, "inconsistent buffer size")
    return i
   end
  end
  set i = i + 1
 end
 set offset = (load64(state() + 80) + 7) & 18446744073709551608
 do require(size < 134217728, "object size bound")
 do require(offset + size < 134217728, "data size bound")
 set p = object(n)
 do store64(p, kind)
 do store64(p + 8, t)
 do store64(p + 16, size)
 do store64(p + 24, offset)
 do store64(state() + 80, offset + size)
 do store64(state() + 72, n + 1)
 return n
end
fn address(r, obj)
 do fix(3, obj)
 do emit(2415919104 | r)
 return emit(2432696320 | (r << 5) | r)
end
fn scan_functions()
 do expect("profile")
 do expect("RF2_SYSTEM_A64_V1")
 do newline()
 return scan_functions_more(0)
end
fn scan_functions_more(f)
 let t = 0
 let params = 0
 let other = 0
 let done = 0
 while load64(token(load64(state() + 24))) != 0
  if load64(token(load64(state() + 24))) == 5
   do advance()
  else
   if match("record") | match("array") | match("result") | match("view") | match("textview")
    do scan_record()
   else
   do expect("fn")
   set t = advance()
   do require(load64(token(t)) == 1, "function name required")
   do require((tmatch(t, "read_bytes") | tmatch(t, "write_bytes")) == 0, "reserved byte IO name")
   do require(record_index(t) == 0, "function collides with record")
   set other = 0
   while other < f
    do require(name_equal(load64(ftable(other)), t) == 0, "duplicate function")
    set other = other + 1
   end
   do store64(ftable(f), t)
   do store64(ftable(f) + 40, next_label())
   do expect("(")
   set params = 0
   set done = match(")")
   while done == 0
    set t = add_local(f, advance())
    do store64(local_ready(f, t), 1)
    if match(":")
     do advance()
     set other = advance()
     if tmatch(other, "u64") == 0
      set other = record_index(other)
      do require(other != 0, "unknown parameter type")
      do require(load64(record_info(other) + 144) < 3, "result/view parameters unsupported")
      do store64(local_type(f, t), other)
      do store64(local_ready(f, t), 1)
     end
    end
    set params = params + 1
    do require(params <= 8, "parameter bound")
    if match(",")
     do advance()
    else
     set done = 1
    end
   end
   do expect(")")
   if match(":")
    do advance()
    set other = record_index(advance())
    do require(other != 0, "result return type required")
    do require(load64(record_info(other) + 144) == 3, "return annotation requires result type")
    do store64(function_result(f), other)
   end
   do scan_body(f, params)
   set f = f + 1
   do store64(state() + 40, f)
   end
  end
 end
 return 0
end
fn scan_body(f, params)
 let depth = 1
 let i = 0
 let slot = 0
 let id = 0
 let count = 0
 do newline()
 do store64(ftable(f) + 8, params)
 do store64(ftable(f) + 16, load64(state() + 24))
 do store64(function_leaf(f), 1)
 while depth != 0
  set i = load64(state() + 24)
  do mark_call(f, i)
  do require(load64(token(i)) != 0, "missing end")
  if load64(token(i)) == 5
   do advance()
  else
  if match("if") | match("while") | match("handle")
   set depth = depth + 1
   do require(depth <= 64, "block depth bound")
  end
  if match("end")
   set depth = depth - 1
