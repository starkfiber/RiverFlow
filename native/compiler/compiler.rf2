  return 0
 end
 do store64(unit+40,start)
 do store64(unit+48,n)
 do store64(unit+56,load64(buffer("labels",524288)+exit_label*8)-start)
 do store64(unit+64,load64(fixup)-start)
 do cp(buffer("reuse_pending",1048576)+start,buffer("code",1048576)+start,n)
 do store64(unit,3)
 return 0
end
fn reuse_finish(path)
 if load64(reuse_state())==0
  return 0
 end
 let root = load64(reuse_state())-1
 let f = 0
 let unit = 0
 let entry = buffer("reuse_entry",65641)
 let name = buffer("reuse_publish_name",128)
 let fd = 0
 let n = 0
 if load64(reuse_state()+104)
  do reuse_pack_finish(root)
 else
 while f<load64(state()+40)
  set unit = reuse_unit(f)
  if load64(unit)==3
   set n = load64(unit+48)
   do cp(entry,"RF2FN002",8)
   do cp(entry+8,unit+8,32)
   do cp(entry+104,buffer("reuse_pending",1048576)+load64(unit+40),n)
   do store64(entry+72,n)
   do store64(entry+80,load64(unit+56))
   do store64(entry+88,load64(unit+64))
   do store64(entry+96,load64(ftable(f)+32))
   do cp(entry+40,sha256(entry+72,n+32),32)
   do cp(name,reuse_name(unit+8),67)
   do cp(name+67,".tmp",5)
   # A held private-directory lock excludes cooperative competing writers.
   do syscall6(472,root,name,0,0,0,0)
   set fd = syscall6(463,root,name,0x1000b01,384,0,0)
   do require((fd>>63)==0,"function unit temporary create failed")
   do output(fd,entry,n+104)
   do require(close(fd)==0,"function unit close failed")
   do require(syscall6(465,root,name,root,reuse_name(unit+8),0,0)==0,"function unit commit failed")
  end
  set f = f+1
 end
 end
 set n = length(path)
 do require(n+12<1024,"reuse report path bound")
 let report_path = buffer("reuse_report_path",1024)
 do cp(report_path,path,n)
 do cp(report_path+n,".reuse.json",12)
 set fd = open(report_path,3585,384)
 do require((fd>>63)==0,"reuse report exists or cannot be created")
 do output(fd,"{\"schema\":\"rf2.function.reuse.v1\",\"reused\":",43)
 do map_number(fd,load64(reuse_state()+8))
 do output(fd,",\"compiled\":",12)
 do map_number(fd,load64(reuse_state()+16))
 do output(fd,",\"ineligible\":",14)
 do map_number(fd,load64(reuse_state()+24))
 do output(fd,",\"validationReused\":",20)
 do map_number(fd,load64(reuse_state()+8))
 do output(fd,",\"fullValidationChecks\":",24)
 do map_number(fd,load64(reuse_state()+96))
 do output(fd,",\"unitContainerReads\":",22)
 do map_number(fd,load64(reuse_state()+120))
 do output(fd,",\"packed\":",10)
 do map_number(fd,load64(reuse_state()+104))
 do output(fd,",\"unitFormat\":\"RF2FN002\"",24)
 do output(fd,",\"compilerSHA256\":\"",19)
 do map_hex(fd,reuse_state()+32,32)
 do output(fd,"\"}\n",3)
 do require(close(fd)==0,"reuse report close failed")
 do close(root)
 return 0
end
fn main(argc, argv)
 let src = 0
 let digest = 0
 let dataoff = 0
 let datasize = 0
 do require((argc>=3)&(argc<=8),"rf2c source new-output [--opt] [--compact] [--functions] [--reuse-cache directory | --reuse-pack directory]")
 let reuse_path = 0
 let option = 3
 while option<argc
  let text = load64(argv+option*8)
  if same(text,length(text),"--reuse-cache",13)|same(text,length(text),"--reuse-pack",12)
   do store64(reuse_state()+104,same(text,length(text),"--reuse-pack",12))
   do require((reuse_path==0)&(option+1<argc),"function cache option requires one directory")
   set option = option+1
   set reuse_path = load64(argv+option*8)
  else
  if same(text,length(text),"--opt",5)
   do require(load64(state()+152)==0,"duplicate compiler option")
   do store64(state()+152,1)
  else
   if same(text,length(text),"--functions",11)
    do require(load64(image_options()+16)==0,"duplicate compiler option")
    do store64(image_options()+16,1)
   else
    do require(same(text,length(text),"--compact",9),"unknown compiler option")
    do require(load64(image_options())==0,"duplicate compiler option")
    do store64(image_options(),1)
   end
  end
  end
  set option = option+1
 end
 do store64(buffer("diagnostic_state",64)+16,load64(argv+8))
 set src = read_source(load64(argv + 8))
 set src = expand_modules(load64(argv + 8), src)
 do store64(buffer("diagnostic_state",64)+24,load64(module_state()))
 do store64(buffer("diagnostic_state",64),1)
 do tokenize_tail(src, load64(state() + 8), 0, 0)
 do store64(buffer("diagnostic_state",64),2)
 do scan_functions()
 do store64(buffer("diagnostic_state",64),0)
 if reuse_path
  do reuse_init(reuse_path)
 end
 do store64(buffer("diagnostic_state",64),2)
 do generate()
 do store64(buffer("diagnostic_state",64),0)
 do layout_image_objects()
 set dataoff = (16384 + load64(state() + 56) + 16383) & 18446744073709535232
 set datasize = (load64(state() + 80) + 16383) & 18446744073709535232
 do resolve(dataoff)
 set digest = sha256(src, load64(state() + 8))
 do image_header(dataoff, datasize, digest)
 do image(load64(argv + 16), dataoff, datasize)
 do reuse_finish(load64(argv+16))
 if load64(image_options()+16)
  do write_function_map(load64(argv+16))
 end
 if load64(state() + 160) != 0
  do write(2, "RF2 opt: guarded periodic sum reduction applied\n", 48)
 end
 do write(1, "RF2 native image emitted; apply macOS code signing before execution.\n", 68)
 return 0
end

# Included by the parent compiler. Reservation-backed, bounded byte vectors.
fn construct_vector(f, slot, id)
 do require(record_index(advance()) == id, "vector constructor mismatch")
 do expect("(")
 do expect(")")
 do imm(0, 0)
 do imm(1, load64(record_info(id) + 8))
 do imm(2, 0)
 do imm(3, 4098)
 do imm(4, 18446744073709551615)
 do imm(5, 0)
 do imm(16, 197)
 do emit(3556773889)
 let good = next_label()
 do jump(good, 3)
 do emit(2852127713)
 do imm(0, 1)
 do jump(load64(state() + 88), 16)
 do label(good)
 do access_local(0, slot + 2, 1)
 do imm(0, 0)
 do access_local(0, slot + 3, 1)
 do access_local(0, slot + 4, 1)
 do imm(0, 1)
 do access_local(0, slot + 1, 1)
 do emit(2432697248 | (((slot + 1) * 8) << 10))
 do access_local(0, slot, 1)
 return 0
end
fn vector_error(number, done)
 do imm(0, 1)
 do imm(1, number)
 return jump(done, 16)
end
fn vector_protect(slot, done)
