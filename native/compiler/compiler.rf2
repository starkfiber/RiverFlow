  set count = 0
  do store64(local_ready(f, slot), 0)
 else
  if tmatch(name, "mapping_store32")
   set count = 2
  end
  while n < count
   do expect(",")
   do scalar_expression(1, depth + 1)
   do push()
   set n = n + 1
  end
 end
 do expect(")")
 do access_local(0, slot + 1, 0)
 do emit(4043309087)
 do jump(bad, 0)
 if tmatch(name, "release") | tmatch(name, "mapping_store32")
  do emit_children_guard(f, parent, 1, busy)
 end
 if count == 0
  do imm(0, 0)
  do access_local(0, slot + 1, 1)
  do emit_mapping_drop(slot)
  do emit(4043309087)
  do jump(success, 0)
  do emit(2852127713)
  do imm(0, 1)
  do jump(done, 16)
 else
  set n = count
  while n != 0
   set n = n - 1
   do emit(4181722080 | n)
   do emit(2432713727)
  end
  do access_local(2, slot + 3, 0)
  do imm(3, 8 - (count == 2) * 4)
  do emit(3405774848 | (3 << 16) | (2 << 5) | 2)
  do emit(3942645791 | (2 << 16))
  do jump(invalid, 8)
  do imm(3, 7 - (count == 2) * 4)
  do emit(2315255808 | (3 << 16) | (0 << 5) | 3)
  do emit(4043309087 | (3 << 5))
  do jump(invalid, 1)
  do access_local(2, slot + 2, 0)
  do emit(2332033024 | (0 << 16) | (2 << 5) | 2)
  if count == 2
   do imm(3, 4294967295)
   do emit(3942645791 | (3 << 16) | (1 << 5))
   do jump(invalid, 8)
   do emit(3103784960 | (2 << 5) | 1)
  else
   do emit(4181721088 | (2 << 5) | 1)
   do imm(0, 0)
   do jump(done, 16)
  end
 end
 do label(success)
 do imm(0, 0)
 do imm(1, 0)
 do jump(done, 16)
 do label(busy)
 if count != 0
  do emit(2432697343 | ((count * 16) << 10))
 end
 do imm(0, 1)
 do imm(1, 16)
 do jump(done, 16)
 do label(bad)
 if count != 0
  do emit(2432697343 | ((count * 16) << 10))
 end
 do imm(0, 1)
 do imm(1, 9)
 do jump(done, 16)
 do label(invalid)
 do imm(0, 1)
 do imm(1, 22)
 do label(done)
 do store64(state() + 136, load64(record_info(id) + 152))
 return 0
end
