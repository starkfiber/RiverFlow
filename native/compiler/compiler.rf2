  if n > 64
   return 0
  end
  while off + 4 <= n
   do emit(1035993120 | ((off // 4) << 10))
   do emit(1847592960)
   do emit(1031798784 | ((off // 4) << 10))
   set off = off + 4
  end
  while off < n
   do emit(3107979299 | (off << 10))
   do emit(1522534499)
   do emit(3103784963 | (off << 10))
   set off = off + 1
  end
 end
 do imm(0,0)
 return 1
end
