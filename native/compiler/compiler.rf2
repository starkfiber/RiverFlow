    do emit(2432713727)
    do access_local(1, slot + 2, 0)
    do access_local(2, slot + 3, 0)
    do emit(2332033024 | (2 << 16) | (1 << 5) | 1)
    do emit(956301344)
    do emit(2432696320 | (1 << 10) | (2 << 5) | 1)
