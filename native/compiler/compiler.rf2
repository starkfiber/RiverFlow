fn expression(minimum, depth)
 let i = load64(state() + 24)
 let kind = load64(token(i))
 let op = 0
 let p = 0
 let comparison = 0
 do require(depth < 64, "expression depth bound")
 if match("-") | match("~")
  do advance()
  do expression(8, depth + 1)
  if tmatch(i, "-")
   do emit(3405775840)
  else
   do emit(2854224864)
  end
 else
  if match("(")
   do advance()
   do expression(1, depth + 1)
   do expect(")")
  else
   if kind == 2
    do advance()
    do imm(0, load64(token(i) + 24))
   else
    if kind == 3
     do advance()
     do address(0, intern(1, i, load64(token(i) + 16) + 1))
    else
     do require(kind == 1, "expected expression")
     do advance()
     if match("(")
      do advance()
      do invoke(i, depth + 1)
     else
      do access_local(0, local_index(i), 0)
     end
    end
   end
  end
 end
 set i = load64(state() + 24)
 set p = precedence(i)
 while p >= minimum
  do require(p != 0, "operator required")
