 do expression(1, 0)
 do require(load64(state() + 136) == load64(record_info(id) + 152), "view owner type mismatch")
 do push()
 do expect(",")
 do scalar_expression(1, 0)
 do push()
 do expect(",")
 do scalar_expression(1, 0)
 do push()
 do expect(")")
