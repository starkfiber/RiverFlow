 do imm(0, 7959390383684863570)
 do emit(4177527776)
 do imm(0, 684900)
 do emit(4177527776 | (1 << 10))
 do imm(0, 2)
 do emit(2432697313)
 do imm(2, 11)
 do imm(16, 4)
 do emit(3556773889)
 do imm(0, 2)
 do imm(16, 1)
 do emit(3556773889)
