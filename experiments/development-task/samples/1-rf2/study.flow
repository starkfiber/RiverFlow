module study_rooms
use "lib/store.flow"
use "lib/ui.flow"
use "lib/app-server.flow"
use "lib/json.flow"
fn app_path()
 return load64(buffer("selected_path",8))
end
fn number(p):IO
 handle text_parse_u64(p,io_size(p),18446744073709551615)
 ok n1
  return ok(n1)
 err e2
  return err(22)
 end
 return err(22)
end
fn request_values(rev,id,room,date,start,finish,r:StoreRequest):IO
 handle number(rev)
 ok n3
  set r.expected=n3
 err e4
  return err(22)
 end
 handle number(id)
 ok n5
  set r.id=n5
 err e6
  return err(22)
 end
 if r.id==0
  return err(22)
 end
 if r.action==3
  return ok(0)
 end
 handle number(room)
 ok n7
  set r.room=n7
 err e8
  return err(22)
 end
 let key=0
 handle date_parse(date,io_size(date))
 ok n9
  set key=n9
 err e10
  return err(22)
 end
 handle date_ordinal(key)
 ok n11
  set r.day=n11
 err e12
  return err(22)
 end
 handle time_parse(start,io_size(start),0)
 ok n13
  set r.start=n13
 err e14
  return err(22)
 end
 handle time_parse(finish,io_size(finish),1)
 ok n15
  set r.finish=n15
 err e16
  return err(22)
 end
 if (r.room<1)|(r.room>16)|(r.finish<=r.start)
  return err(22)
 end
 return ok(0)
end
fn failure(code)
 let out=Writer(buffer("cli_error",128),128,0,0)
 do writer_text(out,"{\"error\":")
 do writer_number(out,code)
 do writer_text(out,"}\n")
 handle io_write_all(1,out.data,out.used)
 ok n17
 err e18
 end
 return 2
end
fn app_dispatch(fd):IO
 let target=buffer("app_target",32)
 let method=load64(globals()+8)
 let values=FormValues()
 let error=0
 let saved=0
 let r=StoreRequest(0,0,0,0,0,0,0)
 let output=Writer(buffer("web_operation",65536),65536,0,0)
 let out=Writer(buffer("documents_web_output",1048576),1048576,0,0)
 let row=Booking(0,0,0,0,0)
 if method==1
  if same(target,io_size(target),"/")==0
   do app_bad(fd,"404 Not Found")
   return ok(0)
  end
 else
  if same(target,io_size(target),"/action")==0
   do app_bad(fd,"404 Not Found")
   return ok(0)
  end
  let seen=0
  handle form_parse(load64(globals()+16),load64(globals()+24),1215,values)
  ok fields19
   set seen=fields19
  err e20
   do app_bad(fd,"400 Bad Request")
   return ok(0)
  end
  if same(values[4],values[5],"reserve")&(seen==1215)
   set r.action=2
  else
   if same(values[4],values[5],"cancel")&(seen==135)
    set r.action=3
   else
    do app_bad(fd,"400 Bad Request")
    return ok(0)
   end
  end
  handle request_values(values[2],values[14],values[20],values[6],values[8],values[10],r)
  ok parsed21
   handle store_operation(app_path(),r,output)
   ok revision
    set saved=1
   err e23
    set error=e23
   end
  err e24
   set error=e24
  end
 end
 let state=StoreState(0,0,0,0,0,0,0)
 handle store_view(app_path(),state)
 ok own rows:Bookings
  do ui_begin(out,"Bookings")
  do writer_text(out,"<section class=page-heading><h1>Study Rooms</h1><p>Reserve one of 16 rooms. Times use the selected calendar day; adjacent reservations are welcome.</p></section>")
  do ui_notice(out,error,saved)
  do writer_text(out,"<section class=stats>")
  do ui_stat(out,"Saved reservations",rows.length,"Maximum 256")
  do ui_stat(out,"Revision",state.revision,"Forms compare the current saved revision")
  do writer_text(out,"</section><section class=card><h2>Reserve a room</h2><form method=post action=/action>")
  do form_hidden(out,state.revision)
  do writer_text(out,"<input type=hidden name=action value=reserve><input type=hidden name=id value=\"")
  do writer_number(out,ui_next_id(rows))
  do writer_text(out,"\"><label for=room>Room</label><select name=room id=room required>")
  let room=1
  while room<=16
   do writer_text(out,"<option value=\"")
   do writer_number(out,room)
   do writer_text(out,"\"")
   if (error!=0)&(method==2)
    let selected=unsigned(values[20],values[21],16)
    if selected==room
     do writer_text(out," selected")
    end
   end
   do writer_text(out,">Room ")
   do writer_number(out,room)
   do writer_text(out,"</option>")
   set room=room+1
  end
  do writer_text(out,"</select><div class=form-grid>")
  let date=""
  let start="09:00"
  let finish="10:00"
  if (error!=0)&(method==2)&same(values[4],values[5],"reserve")
   set date=values[6]
   set start=values[8]
   set finish=values[10]
  end
  do ui_input(out,"date","Date","date",date,io_size(date),"YYYY-MM-DD, years 0001–9999")
  do ui_input(out,"start","Start","text",start,io_size(start),"24-hour HH:MM")
  do ui_input(out,"end","End","text",finish,io_size(finish),"HH:MM; 24:00 means end of day")
  do writer_text(out,"</div><button class=primary type=submit>Reserve room</button></form></section><section class=card><h2>Saved reservations</h2><div style=\"overflow-x:auto\"><table><thead><tr><th>ID</th><th>Room</th><th>Date</th><th>Start</th><th>End</th><th>Action</th></tr></thead><tbody>")
  let i=0
  while i<rows.length
   handle records_read(rows,i,row)
   ok n25
   err e26
    return err(e26)
   end
   do writer_text(out,"<tr><td>")
   do writer_number(out,row.id)
   do writer_text(out,"</td><td>")
   do writer_number(out,row.room)
   do writer_text(out,"</td><td>")
   do date_format(out,ui_date_key(row.day))
   do writer_text(out,"</td><td>")
   do time_format(out,row.start)
   do writer_text(out,"</td><td>")
   do time_format(out,row.finish)
   do writer_text(out,"</td><td><form method=post action=/action>")
   do form_hidden(out,state.revision)
   do writer_text(out,"<input type=hidden name=action value=cancel><input type=hidden name=id value=\"")
   do writer_number(out,row.id)
   do writer_text(out,"\"><button type=submit>Cancel reservation ")
   do writer_number(out,row.id)
   do writer_text(out,"</button></form></td></tr>")
   set i=i+1
  end
  do writer_text(out,"</tbody></table></div>")
  if rows.length==0
   do writer_text(out,"<p>No reservations yet. Choose a room and time above.</p>")
  end
  do writer_text(out,"</section>")
  do ui_end(out)
  do ui_response(fd,out,"200 OK")
 err e27
  do app_bad(fd,"503 Service Unavailable")
 end
 return ok(0)
end
fn rpc_error(out:Writer,code,message)
 do writer_text(out,",\"error\":{\"code\":")
 do writer_text(out,code)
 do writer_text(out,",\"message\":")
 do writer_json(out,message,io_size(message))
 return writer_text(out,"}}\n")
end
fn object_empty(t)
 if t==0
  return 0
 end
 return (load64(j_token(t))==2)&(load64(j_token(t)+24)==t+1)
end
fn only_fields(t,a,b,c,d)
 if load64(j_token(t))!=2
  return 0
 end
 let i=t+1
 while i<load64(j_token(t)+24)
  if ((j_matches(j_token(i),a)&(io_size(a)>0))|(j_matches(j_token(i),b)&(io_size(b)>0))|(j_matches(j_token(i),c)&(io_size(c)>0))|(j_matches(j_token(i),d)&(io_size(d)>0)))==0
   return 0
  end
  set i=load64(j_token(i+1)+24)
 end
 return 1
end
fn rpc_line(p,n,oversize):IO
 let state=Writer(buffer("rpc_state",65536),65536,0,0)
 let req=StoreRequest(0,0,0,0,0,0,0)
 let out=Writer(buffer("rpc_output",131072),131072,0,0)
 let valid=j_json_parse(p,n)&(oversize==0)
 let id=0
 if valid
  set id=j_field(0,"id")
 end
 do writer_text(out,"{\"jsonrpc\":\"2.0\",\"id\":")
 if (id!=0)&((load64(j_token(id))==1)|(load64(j_token(id))==7)|(load64(j_token(id))==6))
  if load64(j_token(id))==1
   do writer_text(out,"\"")
   do writer_bytes(out,load64(j_token(id)+8),load64(j_token(id)+16))
   do writer_text(out,"\"")
  else
   do writer_bytes(out,load64(j_token(id)+8),load64(j_token(id)+16))
  end
 else
  do writer_text(out,"null")
 end
 if valid==0
  do rpc_error(out,"-32700","Invalid JSON or oversized request")
 else
  let method=j_field(0,"method")
  let params=j_field(0,"params")
  if (only_fields(0,"jsonrpc","id","method","params")==0)|(j_matches(j_token(j_field(0,"jsonrpc")),"2.0")==0)|(load64(j_token(method))!=1)|((id!=0)&((load64(j_token(id))!=1)&(load64(j_token(id))!=7)&(load64(j_token(id))!=6)))
   do rpc_error(out,"-32600","Invalid request")
  else
   if id==0
    return ok(0)
   end
   if j_matches(j_token(method),"initialize")
    if (params==0)|(only_fields(params,"protocolVersion","capabilities","clientInfo","")==0)|(j_matches(j_token(j_field(params,"protocolVersion")),"2025-11-25")==0)
     do rpc_error(out,"-32602","Expected protocolVersion 2025-11-25")
    else
     do writer_text(out,",\"result\":{\"protocolVersion\":\"2025-11-25\",\"capabilities\":{\"tools\":{\"listChanged\":false}},\"serverInfo\":{\"name\":\"study-rooms\",\"version\":\"1.0\"}}}\n")
    end
   else
    if j_matches(j_token(method),"ping")|j_matches(j_token(method),"tools/list")
     if (params!=0)&(object_empty(params)==0)
      do rpc_error(out,"-32602","Expected empty parameters")
     else
      if j_matches(j_token(method),"ping")
       do writer_text(out,",\"result\":{}}\n")
      else
       do writer_text(out,",\"result\":{\"tools\":[{\"name\":\"booking_list\",\"description\":\"Read saved study room reservations\",\"inputSchema\":{\"type\":\"object\",\"properties\":{},\"additionalProperties\":false}}]}}\n")
      end
     end
    else
     if j_matches(j_token(method),"tools/call")
      if (params==0)|(only_fields(params,"name","arguments","","")==0)|(j_matches(j_token(j_field(params,"name")),"booking_list")==0)|(object_empty(j_field(params,"arguments"))==0)
       do writer_text(out,",\"result\":{\"isError\":true,\"content\":[{\"type\":\"text\",\"text\":\"Expected booking_list with explicit empty arguments\"}]}}\n")
      else
       handle store_operation(app_path(),req,state)
       ok revision28
        do writer_text(out,",\"result\":{\"isError\":false,\"content\":[{\"type\":\"text\",\"text\":\"Saved study room reservations\"}],\"structuredContent\":")
        do writer_bytes(out,state.data,state.used-1)
        do writer_text(out,"}}\n")
       err e29
        do writer_text(out,",\"result\":{\"isError\":true,\"content\":[{\"type\":\"text\",\"text\":\"Workspace read failed: ")
        do writer_number(out,e29)
        do writer_text(out,"\"}]}}\n")
       end
      end
     else
      do rpc_error(out,"-32601","Unknown method")
     end
    end
   end
  end
 end
 handle io_write_all(1,out.data,out.used)
 ok written30
  return ok(0)
 err e31
  return err(e31)
 end
 return err(5)
end
fn mcp_run():IO
 let p=buffer("rpc_line",65537)
 let byte=buffer("rpc_byte",1)
 let n=0
 let overflow=0
 while 1
  let got=read(0,byte,1)
  if got>>63
   return err(5)
  end
  if got==0
   if n|overflow
    handle rpc_line(p,n,overflow)
    ok done32
    err e33
     return err(e33)
    end
   end
   return ok(0)
  end
  if load8(byte)==10
   handle rpc_line(p,n,overflow)
   ok done34
   err e35
    return err(e35)
   end
   set n=0
   set overflow=0
  else
   if n<65536
    do store8(p+n,load8(byte))
    set n=n+1
   else
    set overflow=1
   end
  end
 end
 return ok(0)
end
fn app_main(argc,argv)
 if argc<3
  return failure(22)
 end
 let command=load64(argv+8)
 let path=load64(argv+16)
 do store64(buffer("selected_path",8),path)
 let r=StoreRequest(0,0,0,0,0,0,0)
 if same(command,io_size(command),"reserve")&(argc==9)
  set r.action=2
  handle request_values(load64(argv+24),load64(argv+32),load64(argv+40),load64(argv+48),load64(argv+56),load64(argv+64),r)
  ok parsed36
  err e37
   return failure(e37)
  end
 else
  if same(command,io_size(command),"cancel")&(argc==5)
   set r.action=3
   handle request_values(load64(argv+24),load64(argv+32),0,0,0,0,r)
   ok parsed38
   err e39
    return failure(e39)
   end
  else
   if argc!=3
    return failure(22)
   end
   if same(command,io_size(command),"init")
    set r.action=1
   else
    if (same(command,io_size(command),"list")|same(command,io_size(command),"serve")|same(command,io_size(command),"mcp"))==0
     return failure(22)
    end
   end
  end
 end
 let out=Writer(buffer("cli_output",65536),65536,0,0)
 handle store_operation(path,r,out)
 ok revision40
 err e41
  return failure(e41)
 end
 if same(command,io_size(command),"serve")
  handle form_session()
  ok initialized42
  err e43
   return failure(e43)
  end
  handle app_serve()
  ok done44
   return 0
  err e45
   return failure(e45)
  end
 end
 if same(command,io_size(command),"mcp")
  handle mcp_run()
  ok done46
   return 0
  err e47
   return 2
  end
 end
 handle io_write_all(1,out.data,out.used)
 ok written48
  return 0
 err e49
  return 2
 end
 return 2
end
