profile RF2_SYSTEM_A64_V1
use "@rf2/v1/text.flow"
fn emit_begin(out:Writer,format,title,n)
 if format==0
  do writer_text(out,"{\"title\":")
  do writer_json(out,title,n)
  do writer_text(out,",\"fields\":[")
 else
  do writer_text(out,"<!doctype html><html lang=\"en\"><meta charset=\"utf-8\"><title>")
  do writer_html(out,title,n)
  do writer_text(out,"</title><main><h1>")
  do writer_html(out,title,n)
  do writer_text(out,"</h1><dl>")
 end
 return 0
end
fn emit_start(out:Writer,format,index,name,n)
 if format==0
  if index
   do writer_text(out,",")
  end
  do writer_text(out,"{\"name\":")
  do writer_json(out,name,n)
  do writer_text(out,",\"value\":")
 else
  do writer_text(out,"<dt>")
  do writer_html(out,name,n)
  do writer_text(out,"</dt><dd>")
 end
 return 0
end
fn emit_finish(out:Writer,format)
 if format==0
  do writer_text(out,"}")
 else
  do writer_text(out,"</dd>")
 end
 return 0
end
fn emit_number(out:Writer,format,index,name,n,value)
 do emit_start(out,format,index,name,n)
 do writer_number(out,value)
 return emit_finish(out,format)
end
fn emit_text(out:Writer,format,index,name,n,value,m)
 do emit_start(out,format,index,name,n)
 if format==0
  do writer_json(out,value,m)
 else
  do writer_html(out,value,m)
 end
 return emit_finish(out,format)
end
fn emit_end(out:Writer,format)
 if format==0
  do writer_text(out,"]}\n")
 else
  do writer_text(out,"</dl></main></html>\n")
 end
 return 0
end
fn severity_token(p,n,token,m)
 if n<m
  return 0
 end
 if text_equal(p,m,token,m)==0
  return 0
 end
 if n==m
  return 1
 end
 let after=load8(p+m)
 return (after==32)|(after==9)
end
fn severity(data,span:TextSpan)
 let offset=0
 while all(offset<span.length,(load8(data+span.start+offset)==32)|(load8(data+span.start+offset)==9))
  set offset=offset+1
 end
 let p=data+span.start+offset
 let n=span.length-offset
 if severity_token(p,n,"INFO",4)
  return 1
 end
 if severity_token(p,n,"WARN",4)
  return 2
 end
 if severity_token(p,n,"ERROR",5)
  return 3
 end
 return 0
end
fn work(path,format):IO
 let info=TextInfo(0,0,0,0)
 let cursor=TextCursor(0,0,0,0)
 let span=TextSpan(0,0)
 let out=Writer(buffer("golden_output",32768),32768,0,0)
 let data=buffer("golden_input",4097)
 let n=try io_regular(path,data,4096)
 do text_measure(data,n,info)
 if info.status
  return err(info.status)
 end
 let lines=0
 let infos=0
 let warns=0
 let errors=0
 let others=0
 let more=text_next_line(data,n,cursor,span)
 while more
  set lines=lines+1
  let level=severity(data,span)
  if level==1
   set infos=infos+1
  else
   if level==2
    set warns=warns+1
   else
    if level==3
     set errors=errors+1
    else
     set others=others+1
    end
   end
  end
  set more=text_next_line(data,n,cursor,span)
 end
 if cursor.status
  return err(cursor.status)
 end
 do emit_begin(out,format,"Log severity",12)
 do emit_text(out,format,0,"Path",4,path,io_size(path))
 do emit_number(out,format,1,"Lines",5,lines)
 do emit_number(out,format,2,"INFO",4,infos)
 do emit_number(out,format,3,"WARN",4,warns)
 do emit_number(out,format,4,"ERROR",5,errors)
 do emit_number(out,format,5,"Other",5,others)
 do emit_end(out,format)
 if out.error
  return err(out.error)
 end
 do try io_write_no_sigpipe(1,out.data,out.used)
 return ok(0)
end
fn main(argc,argv)
 if argc!=3
  return 2
 end
 let mode=load64(argv+8)
 let format=0
 if text_equal(mode,io_size(mode),"json",4)==0
  if text_equal(mode,io_size(mode),"html",4)==0
   return 2
  end
  set format=1
 end
 handle work(load64(argv+16),format)
 ok value
  return 0
 err cause
  return 2
 end
 return 2
end
