profile RF2_SYSTEM_A64_V1
use "@rf2/v1/text-report-cli.flow"
fn severity_token(p,n,token,m)
 if n<m
  return 0
 end
 if text_equal(p,m,token,m)==0
  return 0
 end
 if n==m
  return 1
 end
 let after=load8(p+m)
 return (after==32)|(after==9)
end
fn severity(data,span:TextSpan)
 let offset=0
 while all(offset<span.length,(load8(data+span.start+offset)==32)|(load8(data+span.start+offset)==9))
  set offset=offset+1
 end
 let p=data+span.start+offset
 let n=span.length-offset
 if severity_token(p,n,"INFO",4)
  return 1
 end
 if severity_token(p,n,"WARN",4)
  return 2
 end
 if severity_token(p,n,"ERROR",5)
  return 3
 end
 return 0
end
fn text_report_fields(input:TextReportInput,report:Report,out:Writer):IO
 let cursor=TextCursor(0,0,0,0)
 let span=TextSpan(0,0)
 let data=input.data
 let n=input.size
 let path=input.path
 let lines=0
 let infos=0
 let warns=0
 let errors=0
 let others=0
 let more=text_next_line(data,n,cursor,span)
 while more
  set lines=lines+1
  let level=severity(data,span)
  if level==1
   set infos=infos+1
  else
   if level==2
    set warns=warns+1
   else
    if level==3
     set errors=errors+1
    else
     set others=others+1
    end
   end
  end
  set more=text_next_line(data,n,cursor,span)
 end
 if cursor.status
  return err(cursor.status)
 end
 do report_text(report,out,"Path",4,path,io_size(path))
 do report_number(report,out,"Lines",5,lines)
 do report_number(report,out,"INFO",4,infos)
 do report_number(report,out,"WARN",4,warns)
 do report_number(report,out,"ERROR",5,errors)
 do report_number(report,out,"Other",5,others)
 if out.error
  return err(out.error)
 end
 return ok(0)
end
fn main(argc,argv)
 return text_report_entry(argc,argv,"Log severity",12,0)
end
