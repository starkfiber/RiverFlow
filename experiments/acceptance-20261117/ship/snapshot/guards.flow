profile RF2_SYSTEM_A64_V1
# Fixed protected-mode bootstrap emitter, not a general x86 compiler.
fn byte(v)
 let state=buffer("emit_state",8)
 let n=load64(state)
 if n>=4608
  do exit(2)
 end
 do store8(buffer("image",8192)+n,v)
 do store64(state,n+1)
 return 0
end
fn word(v)
 do byte(v&255)
 do byte((v>>8)&255)
 return 0
end
fn port(p,v)
 do byte(0xba)
 do word(p)
 do byte(0xb0)
 do byte(v)
 do byte(0xee)
 return 0
end
fn character(c)
 # Bounded COM1 transmitter-ready polling. Timeout exits via QEMU test port.
 do byte(0xb9)
 do word(65535)
 let start=load64(buffer("emit_state",8))
 do byte(0xba)
 do word(0x3fd)
 do byte(0xec)
 do byte(0x3c)
 do byte(255)
 do byte(0x74)
 do byte(6)
 do byte(0xa8)
 do byte(32)
 do byte(0x75)
 do byte(12)
 do byte(0xe2)
 let after=load64(buffer("emit_state",8))+1
 do byte((start+256-after)&255)
 do port(0xf4,18)
 do byte(0xfa)
 do byte(0xf4)
 do byte(0xeb)
 do byte(252)
 do port(0x3f8,c)
 return 0
end
fn text(p,n)
 let i=0
 while i<n
  do character(load8(p+i))
  set i=i+1
 end
 return 0
end
fn position()
 return load64(buffer("emit_state",8))
end
fn dword(v)
 do word(v&65535)
 do word(v>>16)
 return 0
end
fn patch16(at,v)
 do store8(buffer("image",8192)+at,v&255)
 do store8(buffer("image",8192)+at+1,(v>>8)&255)
 return 0
end
fn gate(at,target)
 do patch16(at,target)
 do patch16(at+2,8)
 do store8(buffer("image",8192)+at+4,0)
 do store8(buffer("image",8192)+at+5,142)
 do patch16(at+6,0)
 return 0
end
fn main(argc,argv)
 let mode=0
 if argc==2
  set mode=load8(load64(argv+8))
  if all(mode!=114,all(mode!=119,all(mode!=97,mode!=115)))
   return 2
  end
 else
  if argc!=1
   return 2
  end
 end
