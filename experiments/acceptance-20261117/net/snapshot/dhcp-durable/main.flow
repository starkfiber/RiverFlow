profile RF2_SYSTEM_A64_V1
use "store.flow"
# init PATH: stdin40bytes, five LEu64 reservation MACs,0=dynamic.
# serve PATH: caller supplies trusted absolute UTC seconds in the old stream format.
# No implicit initialization. No output reply until snapshot append+fsync succeeds.
fn main(argc,argv)
 if argc!=3
  return 2
 end
 if syscall6(92,1,73,1,0,0,0)!=0
  return 3
 end
 let command=load64(argv+8)
 let path=load64(argv+16)
 let create=0
 if all(load8(command)==105,all(load8(command+1)==110,all(load8(command+2)==105,all(load8(command+3)==116,load8(command+4)==0))))
  set create=1
 else
  if any(load8(command)!=115,any(load8(command+1)!=101,any(load8(command+2)!=114,any(load8(command+3)!=118,any(load8(command+4)!=101,load8(command+5)!=0)))))
   return 2
  end
 end
 let reserved=LeaseReserve()
 let states=LeaseState()
 let owners=LeaseOwner()
 let until=LeaseUntil()
 let xids=LeaseXid()
 let clock=LeaseClock()
 let p=DhcpPacket()
 let m=DhcpMeta()
 let record=buffer("lease_record",256)
 let saved=buffer("lease_saved",256)
 let input=buffer("lease_input",577)
 let h=buffer("lease_header",6)
 let response=buffer("lease_response",4)
 let gen=0
 let bytes=0
 let i=0
 let got=0
 if create==1
  if lease_read(0,input,40)==0
   return 2
  end
  if read(0,input+40,1)!=0
   return 2
  end
  while i<5
   set reserved[i]=load64(input+i*8)
   set i=i+1
  end
  do lease_pack(record,1,reserved,states,owners,until,xids,clock)
  if lease_unpack(record,1,reserved,states,owners,until,xids,clock)==0
   return 2
  end
 end
 let fd=lease_file_open(path,create)
 if fd==18446744073709551615
  return 4
 end
 if create==1
  let committed=lease_commit(fd,record,0)
  let synced=lease_parent_sync(path)
  do close(fd)
  if any(committed==0,synced==0)
   return 6
  end
  return 0
 end
 # Every historical snapshot is checked. Partial or corrupt records fail closed.
 let loading=1
 while loading==1
  set got=read(fd,record,1)
  if got==0
   set loading=0
  else
   if any(got>>63,gen==4096)
    do close(fd)
    return 5
   end
   if lease_read(fd,record+1,255)==0
    do close(fd)
    return 5
   end
   set gen=gen+1
   if lease_unpack(record,gen,reserved,states,owners,until,xids,clock)==0
    do close(fd)
    return 5
   end
   set bytes=bytes+256
  end
 end
 if gen==0
  do close(fd)
  return 5
 end
 let count=0
 while 1
  set got=read(0,h,1)
  if got==0
   do close(fd)
   return 0
  end
  if any(got>>63,any(count==4096,gen==4096))
   do close(fd)
   return 2
  end
  if lease_read(0,h+1,5)==0
   do close(fd)
   return 2
  end
  let n=load8(h)+load8(h+1)*256
  if n>576
   do close(fd)
   return 2
  end
  let now=load8(h+2)+load8(h+3)*256+load8(h+4)*65536+load8(h+5)*16777216
  if lease_read(0,input,n)==0
   do close(fd)
   return 2
  end
  set i=0
  while i<n
   set p[i]=load8(input+i)
   set i=i+1
  end
  let answer=dhcp_parse(p,n,m)
  if answer==0
   do lease_pack(saved,gen,reserved,states,owners,until,xids,clock)
   set answer=dhcp_lease(m,now,states,owners,until,xids,clock,reserved)
   do lease_pack(record,gen+1,reserved,states,owners,until,xids,clock)
   # Only changed state is appended. Transient metadata and reply bytes are not state.
   let changed=0
   set i=16
   while i<232
    if load8(saved+i)!=load8(record+i)
     set changed=1
    end
    set i=i+1
   end
   if changed==1
    if lease_commit(fd,record,bytes)==0
     do close(fd)
     return 6
    end
    set gen=gen+1
    set bytes=bytes+256
   end
  end
  let size=0
  if any(answer==2,any(answer==5,answer==6))
   set size=dhcp_reply(p,m,answer)
  end
  do store8(response,answer&255)
  do store8(response+1,(answer>>8)&255)
  do store8(response+2,size&255)
  do store8(response+3,(size>>8)&255)
  if lease_write(1,response,4)==0
   do close(fd)
   return 3
  end
  set i=0
  while i<size
   do store8(input+i,p[i])
   set i=i+1
  end
  if lease_write(1,input,size)==0
   do close(fd)
   return 3
  end
  set count=count+1
 end
 return 0
end
