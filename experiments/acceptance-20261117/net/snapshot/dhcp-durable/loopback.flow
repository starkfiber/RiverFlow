profile RF2_SYSTEM_A64_V1
use "store.flow"
# init PATH: stdin40bytes, five LEu64 reservation MACs,0=dynamic.
# serve PATH: caller supplies trusted absolute UTC seconds in the old stream format.
# No implicit initialization. No output reply until snapshot append+fsync succeeds.
fn main(argc,argv)
 if argc!=3
  return 2
 end
 if syscall6(92,1,73,1,0,0,0)!=0
  return 3
 end
 let command=load64(argv+8)
 let path=load64(argv+16)
 let create=0
 if all(load8(command)==105,all(load8(command+1)==110,all(load8(command+2)==105,all(load8(command+3)==116,load8(command+4)==0))))
  set create=1
 else
  if any(load8(command)!=115,any(load8(command+1)!=101,any(load8(command+2)!=114,any(load8(command+3)!=118,any(load8(command+4)!=101,load8(command+5)!=0)))))
   return 2
  end
 end
 let reserved=LeaseReserve()
 let states=LeaseState()
 let owners=LeaseOwner()
 let until=LeaseUntil()
 let xids=LeaseXid()
 let clock=LeaseClock()
 let p=DhcpPacket()
 let m=DhcpMeta()
 let record=buffer("lease_record",256)
 let saved=buffer("lease_saved",256)
 let input=buffer("lease_input",577)
 let h=buffer("lease_header",6)
 let response=buffer("lease_response",4)
 let gen=0
 let bytes=0
 let i=0
 let got=0
 if create==1
  if lease_read(0,input,40)==0
   return 2
  end
  if read(0,input+40,1)!=0
   return 2
  end
  while i<5
   set reserved[i]=load64(input+i*8)
   set i=i+1
  end
  do lease_pack(record,1,reserved,states,owners,until,xids,clock)
  if lease_unpack(record,1,reserved,states,owners,until,xids,clock)==0
   return 2
  end
 end
 let storefd=lease_file_open(path,create)
 if storefd==18446744073709551615
  return 4
 end
 if create==1
  let committed=lease_commit(storefd,record,0)
  let synced=lease_parent_sync(path)
  do close(storefd)
  if any(committed==0,synced==0)
   return 6
  end
  return 0
 end
 # Every historical snapshot is checked. Partial or corrupt records fail closed.
 let loading=1
 while loading==1
  set got=read(storefd,record,1)
  if got==0
   set loading=0
  else
   if any(got>>63,gen==4096)
    do close(storefd)
    return 5
   end
   if lease_read(storefd,record+1,255)==0
    do close(storefd)
    return 5
   end
   set gen=gen+1
   if lease_unpack(record,gen,reserved,states,owners,until,xids,clock)==0
    do close(storefd)
    return 5
   end
   set bytes=bytes+256
  end
 end
 if gen==0
  do close(storefd)
  return 5
 end
 let fd=syscall6(97,2,2,17,0,0,0)
 if fd>>63
  do close(storefd)
  return 4
 end
 let addr=buffer("dhcp_bind",16)
 do store8(addr,16)
 do store8(addr+1,2)
 do store8(addr+4,127)
 do store8(addr+7,1)
 if syscall6(104,fd,addr,16,0,0,0)!=0
  do close(fd)
  do close(storefd)
  return 4
 end
 let tv=buffer("dhcp_timeout",16)
 do store64(tv,3)
 if syscall6(105,fd,65535,4102,tv,16,0)!=0
  do close(fd)
  do close(storefd)
  return 4
 end
 let len=buffer("dhcp_socklen",8)
 do store64(len,16)
 if syscall6(32,fd,addr,len,0,0,0)!=0
  do close(fd)
  do close(storefd)
  return 4
 end
 if write(1,addr+2,2)!=2
  do close(fd)
  do close(storefd)
  return 3
 end
 let peer=buffer("dhcp_peer",16)
 let count=0
 let tvclock=buffer("lease_utc",16)
 while count<32
  do store64(len,16)
  let n=syscall6(29,fd,input,577,0,peer,len)
  if n>>63
   do close(fd)
   do close(storefd)
   return 4
  end
  if any(load8(peer+1)!=2,any(load8(peer+4)!=127,any(load8(peer+5)!=0,any(load8(peer+6)!=0,load8(peer+7)!=1))))
   do close(fd)
   do close(storefd)
   return 4
  end
  let answer=10
  if n<=576
   set i=0
   while i<n
    set p[i]=load8(input+i)
    set i=i+1
   end
   set answer=dhcp_parse(p,n,m)
   if answer==0
    if syscall6(116,tvclock,0,0,0,0,0)!=0
     do close(fd)
     do close(storefd)
     return 5
    end
    let now=load64(tvclock)
    if any(now>4294967295,gen==4096)
     do close(fd)
     do close(storefd)
     return 5
    end
    do lease_pack(saved,gen,reserved,states,owners,until,xids,clock)
    set answer=dhcp_lease(m,now,states,owners,until,xids,clock,reserved)
    do lease_pack(record,gen+1,reserved,states,owners,until,xids,clock)
    let changed=0
    set i=16
    while i<232
     if load8(saved+i)!=load8(record+i)
      set changed=1
     end
     set i=i+1
    end
    if changed==1
     if lease_commit(storefd,record,bytes)==0
      do close(fd)
      do close(storefd)
      return 6
     end
     set gen=gen+1
     set bytes=bytes+256
    end
   end
  end
  if any(answer==2,any(answer==5,answer==6))
   let size=dhcp_reply(p,m,answer)
   set i=0
   while i<size
    do store8(input+i,p[i])
    set i=i+1
   end
   if syscall6(133,fd,input,size,0,peer,16)!=size
    do close(fd)
    do close(storefd)
    return 4
   end
  end
  set count=count+1
 end
 let a=close(fd)
 let b=close(storefd)
 if any(a!=0,b!=0)
  return 4
 end
 return 0
end
