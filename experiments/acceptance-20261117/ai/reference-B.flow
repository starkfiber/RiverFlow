profile RF2_SYSTEM_A64_V1
use "@rf2/v1/report.flow"
fn work(path,query,format):IO
 let info=TextInfo(0,0,0,0)
 let qi=TextInfo(0,0,0,0)
 let prefix=TextPrefix()
 let matches=TextMatches(0,0,0,0)
 let out=Writer(buffer("reference_output",32768),32768,0,0)
 let report=Report(0,0,0)
 let data=buffer("reference_data",4097)
 let m=io_size(query)
 if (m==0)|(m>128)
  return err(22)
 end
 do text_measure(query,m,qi)
 if qi.status
  return err(qi.status)
 end
 let n=try io_regular(path,data,4096)
 do text_measure(data,n,info)
 if info.status
  return err(info.status)
 end
 if text_search_overlapping(data,n,query,m,0,prefix,matches)==0
  return err(22)
 end
 if matches.status
  return err(matches.status)
 end
 do report_begin(report,out,format,"Match metrics",13)
 do report_text(report,out,"Path",4,path,io_size(path))
 do report_text(report,out,"Query",5,query,m)
 do report_number(report,out,"Matches",7,matches.count)
 if matches.count
  do report_number(report,out,"First byte",10,matches.first)
  do report_number(report,out,"Last byte",9,matches.last)
 else
  do report_text(report,out,"First byte",10,"none",4)
  do report_text(report,out,"Last byte",9,"none",4)
 end
 do report_end(report,out)
 if out.error
  return err(out.error)
 end
 do try io_write_no_sigpipe(1,out.data,out.used)
 return ok(0)
end
fn main(argc,argv)
 if argc!=4
  return 2
 end
 let mode=load64(argv+8)
 let format=0
 if text_equal(mode,io_size(mode),"json",4)==0
  if text_equal(mode,io_size(mode),"html",4)==0
   return 2
  end
  set format=1
 end
 handle work(load64(argv+16),load64(argv+24),format)
 ok value
  return 0
 err cause
  return 2
 end
 return 2
end
