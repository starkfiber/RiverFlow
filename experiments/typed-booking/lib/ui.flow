module booking_ui
use "lib/forms.flow"
use "lib/datetime.flow"
fn ui_begin(out:Writer,title)
 do writer_reset(out)
 do writer_text(out,"<!doctype html><html lang=en class=\"")
 do writer_text(out,ui_theme_class())
 do writer_text(out,"\"><head><meta charset=utf-8><meta name=viewport content=\"width=device-width,initial-scale=1\"><title>")
 do writer_text(out,title)
 do writer_text(out," | RF2 Booking</title><style>")
 do writer_text(out,ui_css())
 do writer_text(out,"</style></head><body><a class=skip href=#main>Skip to bookings</a><div class=shell><aside class=sidebar><a class=brand href=/ aria-label=\"RF2 Booking home\"><svg aria-hidden=true viewBox=\"0 0 32 32\"><path d=\"M4 9h15c8 0 8 12 0 12H4m7-6h13M4 27l7-12-7-12\" /></svg><span>RF²<span class=brand-sub>Booking</span></span></a><p class=nav-label>YOUR WORKSPACE</p><nav aria-label=\"Main navigation\"><a class=nav-link href=/")
 if text_equal(title,io_size(title),"Bookings",8)
  do writer_text(out," aria-current=page")
 end
 do writer_text(out,"><svg aria-hidden=true viewBox=\"0 0 24 24\"><rect x=3 y=5 width=18 height=16 rx=3 /><path d=\"M3 10h18M8 2v6m8-6v6\" /></svg> Bookings</a><a class=nav-link href=/storage")
 if text_equal(title,io_size(title),"Storage",7)
  do writer_text(out," aria-current=page")
 end
 do writer_text(out,"><svg aria-hidden=true viewBox=\"0 0 24 24\"><rect x=3 y=3 width=18 height=18 rx=3 /><path d=\"M7 8h10M7 12h10m-10 4h6\" /></svg> Storage &amp; recovery</a></nav><div class=sidebar-note><span class=status-dot></span><strong>Local by design</strong><p>Your bookings stay in the file you chose on this Mac.</p></div></aside><main id=main><header class=topbar><span class=breadcrumb>Workspace <span aria-hidden=true>/</span> ")
 do writer_text(out,title)
 do writer_text(out,"</span><div class=topbar-actions><span class=local-badge><span class=status-dot></span> On this Mac</span>")
 do ui_appearance(out)
 return writer_text(out,"</div></header>")
end
fn ui_end(out:Writer)
 return writer_text(out,"<footer>RF² Booking <span>Written in RiverFlow. Saved in your workspace.</span></footer></main></div></body></html>")
end
fn ui_stat(out:Writer,label,value,detail)
 do writer_text(out,"<div class=stat><span class=stat-label>")
 do writer_text(out,label)
 do writer_text(out,"</span><strong>")
 do writer_number(out,value)
 do writer_text(out,"</strong><span class=stat-detail>")
 do writer_text(out,detail)
 return writer_text(out,"</span></div>")
end
fn ui_notice(out:Writer,error,saved)
 if error
  do writer_text(out,"<section class=\"notice warning\" role=alert><strong>")
  if error==9002
   do writer_text(out,"Check the saved bookings before trying again.</strong><p>The last save could not be confirmed. It may already be there. Refresh this workspace first.")
  else
   if error==409
    do writer_text(out,"This booking could not be saved.</strong><p>The room may already be booked, or this page was open while another change was saved. We have loaded the current bookings below. Check the time and try again.")
   else
    if error==35
     do writer_text(out,"The workspace is busy.</strong><p>Another change is being saved. Refresh in a moment before trying again.")
    else
     if error==22
      do writer_text(out,"Check the booking details.</strong><p>Choose a room, a valid date and an end time after the start. Use the same calendar day.")
     else
      if error==17
       do writer_text(out,"This reservation number is already in use.</strong><p>Refresh to get a new number. No new booking was confirmed.")
      else
       if error==404
        do writer_text(out,"That booking is no longer here.</strong><p>It may already have been cancelled. The current bookings are shown below.")
       else
        if error==27
         do writer_text(out,"This workspace has reached its storage limit.</strong><p>No new save was confirmed. Keep this file and start another workspace when you are ready.")
        else
         do writer_text(out,"We could not complete that change.</strong><p>No confirmation was issued. Review the saved bookings before trying again. Reference ")
         do writer_number(out,error)
         do writer_text(out,".")
        end
       end
      end
     end
    end
   end
  end
  do writer_text(out,"</p><a class=storage-link href=/>Refresh saved bookings</a></section>")
 else
  if saved
   do writer_text(out,"<section class=\"notice success\" role=status><strong>Saved to your workspace.</strong><p>The current saved bookings are shown below.</p></section>")
  end
 end
 return 0
end
fn ui_input(out:Writer,name,label,kind,value,bytes,hint)
 do writer_text(out,"<label class=field for=\"")
 do writer_text(out,name)
 do writer_text(out,"\">")
 do writer_text(out,label)
 do writer_text(out,"</label><input required id=\"")
 do writer_text(out,name)
 do writer_text(out,"\" name=\"")
 do writer_text(out,name)
 do writer_text(out,"\" type=\"")
 do writer_text(out,kind)
 do writer_text(out,"\" value=\"")
 do writer_html(out,value,bytes)
 do writer_text(out,"\"")
 if text_equal(kind,io_size(kind),"date",4)
  do writer_text(out," min=0001-01-01 max=9999-12-31")
 else
  do writer_text(out," maxlength=5 pattern=\"[0-2][0-9]:[0-5][0-9]\" inputmode=numeric placeholder=\"09:00\"")
 end
 do writer_text(out," aria-describedby=\"")
 do writer_text(out,name)
 do writer_text(out,"-hint\">")
 do writer_text(out,"<small class=hint id=\"")
 do writer_text(out,name)
 do writer_text(out,"-hint\">")
 do writer_text(out,hint)
 return writer_text(out,"</small>")
end
fn ui_action(out:Writer,revision,action,label)
 do writer_text(out,"<form action=/action method=post>")
 do form_hidden(out,revision)
 do writer_text(out,"<input type=hidden name=action value=\"")
 do writer_text(out,action)
 do writer_text(out,"\"><button type=submit class=primary>")
 do writer_text(out,label)
 return writer_text(out,"</button></form>")
end
fn ui_response(fd,out:Writer,status)
 if out.error
  return app_bad(fd,"500 Internal Server Error")
 end
 do store64(globals()+80,out.used)
 do store64(globals()+88,0)
 return respond(fd,status,"text/html; charset=utf-8")
end
fn app_bad(fd,status)
 do reset_output()
 do text("<!doctype html><html lang=en><meta charset=utf-8><meta name=viewport content=\"width=device-width,initial-scale=1\"><title>Request refused | RF2</title><h1>This request could not be accepted.</h1><p>No action was confirmed. Refresh the workspace and review its current state before trying again.</p><a href= />Return to bookings</a></html>")
 return respond(fd,status,"text/html; charset=utf-8")
end
fn ui_date_key(ordinal)
 if (ordinal==0)|(ordinal>3652059)
  return 0
 end
 let low=1
 let high=10000
 while low+1<high
  let middle=(low+high)//2
  let prior=middle-1
  let days=prior*365+prior//4-prior//100+prior//400
  if days<ordinal
   set low=middle
  else
   set high=middle
  end
 end
 let before=low-1
 let day=ordinal-(before*365+before//4-before//100+before//400)
 let month=1
 while day>date_month_days(low,month)
  set day=day-date_month_days(low,month)
  set month=month+1
 end
 return low*10000+month*100+day
end
fn ui_next_id(rows:Bookings)
 let row=Booking(0,0,0,0,0)
 let candidate=1
 while candidate<=257
  let used=0
  let i=0
  while i<rows.length
   handle records_read(rows,i,row)
   ok fields
   err read_error
    return 0
   end
   if row.id==candidate
    set used=1
    set i=rows.length
   else
    set i=i+1
   end
  end
  if used==0
   return candidate
  end
  set candidate=candidate+1
 end
 return 0
end

fn ui_css()
 return "\n:root{color-scheme:light dark;--bg:#f5f7fb;--surface:#fff;--ink:#182d45;--muted:#53667b;--line:#e0e6ef;--soft:#edf3fc;--blue:#245cd5;--blue-hover:#1949ae;--green:#187052;--success:#edf8f2;--warning:#fff4e8;--warning-line:#d9b58c;--red:#a62e34;--ring:#245cd5;--radius:18px;--space:24px}*{box-sizing:border-box}body{margin:0;color:var(--ink);background:var(--bg);font:16px/1.55 -apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif}a{color:var(--blue);text-underline-offset:3px}button,input,select{font:inherit}button,a,input,select,summary{touch-action:manipulation}button,summary,select{cursor:pointer}a:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible,summary:focus-visible{outline:3px solid var(--ring);outline-offset:4px}.skip{position:absolute;left:16px;top:-100px;background:var(--surface);padding:12px;z-index:5}.skip:focus{top:12px}.shell{display:grid;grid-template-columns:220px minmax(0,1fr);min-height:100vh}.sidebar{background:var(--surface);border-right:1px solid var(--line);padding:34px 22px;display:flex;flex-direction:column}.brand{min-height:44px;display:flex;align-items:center;gap:13px;text-decoration:none;color:var(--ink);font-size:25px;font-weight:750;letter-spacing:-1px}.brand svg{width:37px;height:37px;stroke:var(--blue);fill:none;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}.brand-sub{display:block;font-size:12px;letter-spacing:1px;color:var(--muted);font-weight:550;text-transform:uppercase;margin-top:-5px}.nav-label{font-size:10px;letter-spacing:1.8px;color:var(--muted);font-weight:700;margin:49px 9px 14px}.nav-link{display:flex;gap:12px;align-items:center;text-decoration:none;color:var(--muted);font-size:14px;font-weight:600;padding:12px 11px;border-radius:10px;min-height:46px}.nav-link:hover{background:var(--soft);color:var(--blue)}.nav-link span{font-size:21px;width:22px}.sidebar-note{margin-top:auto;padding:22px 8px 2px;font-size:12px;color:var(--muted)}.sidebar-note strong{font-size:13px;color:var(--ink);font-weight:650}.sidebar-note p{margin:10px 0;line-height:1.8}.status-dot{width:7px;height:7px;border-radius:50%;background:var(--green);display:inline-block;margin-right:6px}.sidebar-note .status-dot{width:6px;height:6px}main{min-width:0;max-width:1550px;padding:0 46px 22px}.topbar{height:87px;display:flex;align-items:center;justify-content:space-between;gap:16px;border-bottom:1px solid var(--line);margin-bottom:37px}.breadcrumb{font-size:13px;color:var(--muted)}.breadcrumb span{padding:0 10px;color:#8796a8}.local-badge{font-size:12px;border:1px solid var(--line);padding:6px 11px;border-radius:25px;background:var(--surface);white-space:nowrap}.page-heading{display:flex;justify-content:space-between;align-items:center;gap:18px;margin-bottom:30px}h1{font-size:36px;font-weight:720;letter-spacing:-1.4px;line-height:1.18;margin:0 0 9px}h2{font-size:20px;letter-spacing:-.4px;line-height:1.3;margin:0 0 7px}h3{font-size:17px;margin:0 0 5px}.subtle{color:var(--muted);margin:0;font-size:14px}.eyebrow{color:var(--blue);font-size:11px;letter-spacing:1.6px;font-weight:700;margin:0 0 12px}.primary,button{border:0;background:var(--blue);color:white;min-height:46px;padding:11px 17px;border-radius:10px;font-weight:650;font-size:14px;transition:background 180ms ease,transform 180ms ease}.primary{text-decoration:none;display:inline-flex;align-items:center;justify-content:center;white-space:nowrap}.primary:hover,button:hover{background:var(--blue-hover)}button:active,.primary:active{transform:translateY(1px)}.stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:17px;margin-bottom:27px}.stat{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);padding:20px 23px;display:flex;flex-direction:column}.stat-label{font-size:12px;font-weight:650;color:var(--muted)}.stat strong{font-size:33px;letter-spacing:-1px;line-height:1.2;margin:10px 0 7px;font-weight:680;font-variant-numeric:tabular-nums}.stat-detail{font-size:11px;color:var(--muted)}.content-grid{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(290px,.85fr);gap:26px;align-items:start}.panel{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);padding:25px;min-width:0}.panel-heading{display:flex;align-items:start;justify-content:space-between;gap:12px;margin-bottom:16px}.count-badge{border-radius:25px;background:var(--soft);color:var(--blue);font-size:12px;font-weight:650;padding:5px 10px;white-space:nowrap}.booking{display:grid;grid-template-columns:45px minmax(0,1fr) auto;gap:15px;padding:20px 0;border-top:1px solid var(--line);align-items:start}.room-icon{display:grid;place-items:center;width:44px;height:45px;border-radius:12px;background:var(--soft);color:var(--blue);font-size:18px;font-weight:650;font-variant-numeric:tabular-nums}.booking-meta{display:flex;flex-wrap:wrap;gap:5px 12px;color:var(--muted);font-size:12px}.booking-meta .identifier{overflow-wrap:anywhere}.booking-time{font-size:14px;font-weight:650;color:var(--ink);margin:0 0 4px;font-variant-numeric:tabular-nums}.booking-date{color:var(--muted);font-size:12px;margin:0 0 5px}.cancel{font-size:12px;color:var(--muted);text-align:right;max-width:170px}.cancel summary{min-height:44px;padding:9px 0;list-style:none;text-decoration:underline;text-underline-offset:4px}.cancel summary::-webkit-details-marker{display:none}.cancel p{font-size:12px;text-align:left}.cancel button{background:var(--surface);color:var(--red);border:1px solid var(--line);font-size:12px;padding:8px 12px;min-height:44px}.cancel button:hover{background:var(--warning)}.empty{padding:55px 18px;text-align:center;border-top:1px solid var(--line);color:var(--muted)}.empty svg{width:60px;height:60px;stroke:var(--blue);fill:var(--soft);stroke-width:1.5;margin-bottom:15px}.empty h3{color:var(--ink);font-size:17px}.empty p{font-size:13px;max-width:270px;margin:8px auto}.form-panel{scroll-margin-top:24px}.field{display:block;font-size:13px;font-weight:650;margin:18px 0 7px}input,select{width:100%;min-height:46px;background:var(--surface);border:1px solid #a2b1c3;border-radius:9px;color:var(--ink);padding:10px 12px;font-size:14px}input:focus,select:focus{border-color:var(--blue)}input::placeholder{color:var(--muted)}.hint{display:block;margin:6px 0 0;color:var(--muted);font-size:11px;line-height:1.6}.form-row{display:grid;grid-template-columns:1fr 1fr;gap:13px}.form-panel button{width:100%;margin-top:23px}.form-note{margin:14px 0 0;font-size:11px;color:var(--muted);line-height:1.8}.notice{border-radius:12px;border:1px solid var(--line);padding:17px 20px;margin:0 0 25px;font-size:13px}.notice strong{font-size:14px}.notice p{margin:5px 0 8px;max-width:800px}.success{background:var(--success);border-color:#a2c9b5}.warning{background:var(--warning);border-color:var(--warning-line)}.storage-detail{margin-top:24px;padding:24px}.storage-detail dl{display:grid;grid-template-columns:150px minmax(0,1fr);gap:10px;font-size:13px}.storage-detail dt{color:var(--muted)}.storage-detail dd{margin:0;overflow-wrap:anywhere}.storage-actions{display:flex;flex-wrap:wrap;gap:16px;margin-top:20px}.storage-actions button{margin:0}.storage-actions p{font-size:13px;max-width:600px;color:var(--muted)}footer{font-size:11px;color:var(--muted);display:flex;justify-content:space-between;gap:18px;margin-top:35px;padding-top:22px;border-top:1px solid var(--line)}.storage-link{min-height:44px;align-items:center;font-size:12px;display:inline-flex;margin-top:20px}.wide-panel{max-width:900px}.setup{padding:38px;max-width:640px}.setup p{color:var(--muted);font-size:14px;line-height:1.8}.setup button{margin-top:18px}@media(max-width:1150px){main{padding:0 28px 22px}.shell{grid-template-columns:190px minmax(0,1fr)}.sidebar{padding:30px 15px}.content-grid{grid-template-columns:minmax(0,1fr) 300px;gap:18px}.panel{padding:21px}.booking{grid-template-columns:38px minmax(0,1fr);gap:12px}.room-icon{width:36px;height:40px}.cancel{grid-column:2;text-align:left;max-width:none}.cancel summary{padding:4px 0;min-height:44px}}@media(max-width:950px){.content-grid{grid-template-columns:1fr}.shell{grid-template-columns:170px minmax(0,1fr)}.sidebar{padding:28px 12px}.nav-link{font-size:12px;gap:8px}.nav-label{font-size:9px;letter-spacing:1px}.brand{font-size:22px}.brand svg{width:30px}.stats{gap:10px}.stat{padding:18px 15px}.stat strong{font-size:29px}.booking{grid-template-columns:44px minmax(0,1fr) auto}.cancel{grid-column:auto;text-align:right}.form-panel .form-row{gap:16px}}@media(max-width:650px){.shell{display:block}.sidebar{border-right:0;border-bottom:1px solid var(--line);padding:17px 20px;display:flex;flex-direction:row;align-items:center;justify-content:space-between;gap:10px}.brand{font-size:21px;gap:8px}.brand-sub{font-size:9px;letter-spacing:1px}.brand svg{width:29px;height:29px}.nav-label,.sidebar-note{display:none}.sidebar nav{display:flex;gap:5px}.nav-link{font-size:11px;padding:10px 8px;min-height:44px}.nav-link span{display:none}main{padding:0 20px 20px}.topbar{height:68px;margin-bottom:26px}.local-badge{font-size:10px;padding:5px 8px}.breadcrumb{font-size:11px}.breadcrumb span{padding:0 5px}h1{font-size:30px;letter-spacing:-1px}.page-heading{align-items:start;flex-direction:column;gap:17px;margin-bottom:23px}.page-heading .primary{font-size:12px;min-height:44px}.stats{grid-template-columns:1fr 1fr;gap:10px}.stat:last-child{grid-column:1/-1;flex-direction:row;align-items:center;gap:15px;padding:13px 16px}.stat:last-child strong{font-size:22px;margin:0}.stat:last-child .stat-detail{margin-left:auto}.stat{padding:16px}.stat strong{font-size:29px}.stat-label{font-size:11px}.stat-detail{font-size:10px}.panel{padding:21px 18px}.content-grid{gap:20px}.booking{grid-template-columns:36px minmax(0,1fr);gap:12px}.booking h3{font-size:16px}.cancel{grid-column:2;text-align:left}.cancel summary{min-height:44px;padding:10px 0}.form-row{gap:11px}.notice{padding:16px}.storage-detail dl{grid-template-columns:1fr;gap:4px}.storage-detail dd{margin-bottom:10px}footer{font-size:10px;flex-direction:column;gap:4px}.setup{padding:25px}.empty{padding:38px 7px}}@media(prefers-color-scheme:dark){:root{--bg:#111c2c;--surface:#17263a;--ink:#e8eef8;--muted:#b3c1d3;--line:#35465c;--soft:#213b61;--blue:#8bb6ff;--blue-hover:#b4cfff;--green:#75d1a9;--success:#203c36;--warning:#403021;--warning-line:#96734c;--red:#ffb0b5;--ring:#a1c2ff}.primary,button{background:#326ad4;color:white}.primary:hover,button:hover{background:#2658b8}.cancel button{color:var(--red);background:var(--surface)}.success{border-color:#50836d}input,select{border-color:#7890aa}.brand svg{stroke:var(--blue)}}@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important;scroll-behavior:auto!important}}\n\nhtml.light{color-scheme:light;--bg:#f5f7fb;--surface:#fff;--ink:#182d45;--muted:#53667b;--line:#e0e6ef;--soft:#edf3fc;--blue:#245cd5;--blue-hover:#1949ae;--green:#187052;--success:#edf8f2;--warning:#fff4e8;--warning-line:#d9b58c;--red:#a62e34;--ring:#245cd5}html.dark{color-scheme:dark;--bg:#111c2c;--surface:#17263a;--ink:#e8eef8;--muted:#b3c1d3;--line:#35465c;--soft:#213b61;--blue:#8bb6ff;--blue-hover:#b4cfff;--green:#75d1a9;--success:#203c36;--warning:#403021;--warning-line:#96734c;--red:#ffb0b5;--ring:#a1c2ff}.light .primary,.light button{background:#245cd5;color:white}.light .primary:hover,.light button:hover{background:#1949ae}.dark .primary,.dark button{background:#326ad4;color:white}.dark .primary:hover,.dark button:hover{background:#2658b8}.light .cancel button,.dark .cancel button{background:var(--surface);color:var(--red)}.light .cancel button:hover,.dark .cancel button:hover{background:var(--warning)}.topbar-actions{display:flex;align-items:center;gap:16px}.appearance{display:flex;gap:6px;margin:0;align-items:center}.appearance select{font-size:12px;width:92px;min-height:44px;padding:8px;background:var(--surface)}.appearance button,.light .appearance button,.dark .appearance button{font-size:12px;background:var(--soft);color:var(--blue);padding:9px 12px;min-height:44px}.nav-link svg{width:19px;height:19px;stroke:currentColor;fill:none;stroke-width:1.6;flex:none}.light .success{border-color:#a2c9b5}.dark .success{border-color:#50836d}@media(max-width:650px){.topbar{height:auto;min-height:78px;flex-wrap:wrap;padding:12px 0}.topbar-actions{gap:9px}.appearance select{width:82px}.appearance button{padding:8px 10px}.nav-link svg{display:none}.local-badge{display:none}}\n\n.nav-link[aria-current=page]{color:var(--blue);background:var(--soft);font-weight:700}\n"
end

fn ui_theme_class()
 if load64(globals()+104)==1
  return "light"
 end
 if load64(globals()+104)==2
  return "dark"
 end
 return "system"
end
fn ui_appearance(out:Writer)
 do writer_text(out,"<form action=/action method=post class=appearance>")
 do form_hidden(out,0)
 do writer_text(out,"<input type=hidden name=action value=appearance><select id=appearance name=appearance aria-label=\"Appearance\">")
 let i=0
 while i<3
  let value="system"
  let label="System"
  if i==1
   set value="light"
   set label="Light"
  end
  if i==2
   set value="dark"
   set label="Dark"
  end
  do writer_text(out,"<option value=\"")
  do writer_text(out,value)
  do writer_text(out,"\"")
  if i==load64(globals()+104)
   do writer_text(out," selected")
  end
  do writer_text(out,">")
  do writer_text(out,label)
  do writer_text(out,"</option>")
  set i=i+1
 end
 return writer_text(out,"</select><button type=submit>Apply</button></form>")
end
