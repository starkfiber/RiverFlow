module native_forms
use "lib/transport.flow"
array FormValues(u64,32)
fn form_request(fd)
 let data = buffer("app_request",36865)
 let n = 0
 let got = 0
 let end = 0
 let first = 0
 let sep = 0
 let space = 0
 let pos = 0
 let line = 0
 let colon = 0
 let value = 0
 let length = 0
 let host = 0
 let origin = 0
 let length_seen = 0
 let type_seen = 0
 let total = 0
 let body = 0
 let i = 0
 let c = 0
 let start = vm_clock_ticks()
 do store64(globals()+104,0)
 do store64(globals()+112,0)
 do store64(globals()+120,0)
 do store64(globals()+8,0)
 do store64(globals()+16,0)
 do store64(globals()+24,0)
 do store64(globals()+32,0)
 while (end==0)&(n<4096)
  set got = receive(fd,data+n,4096-n,start)
  if got==0
   return 0
  end
  set n = n+got
  do store64(globals()+32,n)
  set end = find(data,n,"\r\n\r\n",4)
 end
 if end==0
  return 0
 end
 set body = end+3
 set first = find(data,body,"\r\n",2)
 if (first==0)|(first>256)
  return 0
 end
 set sep = find(data,first-1," ",1)
 if sep==0
  return 0
 end
 if same(data,sep-1,"GET")
  do store64(globals()+8,1)
 else
  if same(data,sep-1,"POST")
   do store64(globals()+8,2)
  else
   return 0
  end
 end
 set space = find(data+sep,first-sep-1," ",1)
 if (space==0)|(space>31)
  return 0
 end
 set i = 0
 while i<space-1
  set c = load8(data+sep+i)
  if (c<33)|(c>126)
   return 0
  end
  set i = i+1
 end
 do copy(buffer("app_target",32),data+sep,space-1)
 do store8(buffer("app_target",32)+space-1,0)
 if same(data+sep+space,first-1-sep-space,"HTTP/1.1")==0
  return 0
 end
 set pos = first+1
 while pos<end-1
  set line = find(data+pos,body-pos,"\r\n",2)
  if (line==0)|(line>1024)
   return 0
  end
  set line = line-1
  set colon = find(data+pos,line,":",1)
  if (colon==0)|(colon==1)
   return 0
  end
  set i = 0
  while i<colon-1
   set c = load8(data+pos+i)
   if ((c<65)|(c>90))&((c<97)|(c>122))&((c<48)|(c>57))&(c!=45)
    return 0
   end
   set i = i+1
  end
  set value = pos+colon
  set length = line-colon
  while (length>0)&((load8(data+value)==32)|(load8(data+value)==9))
   set value = value+1
   set length = length-1
  end
  set i = 0
  while i<length
   set c = load8(data+value+i)
   if ((c<32)&(c!=9))|(c>126)
    return 0
   end
   set i = i+1
  end
  if key(data+pos,colon-1,"cookie")
   if form_theme_cookie(data+value,length)==0
    return 0
   end
  end
  if key(data+pos,colon-1,"host")
   if host
    return 0
   end
   set host = 1
   if same(data+value,length,buffer("documents_web_host",64))==0
    return 0
   end
  end
  if key(data+pos,colon-1,"origin")
   if origin
    return 0
   end
   set origin = 1
   if same(data+value,length,buffer("documents_web_url",96))==0
    return 0
   end
  end
  if key(data+pos,colon-1,"content-length")
   if length_seen
    return 0
   end
   set length_seen = 1
   set total = unsigned(data+value,length,32768)
   if total>>63
    return 0
   end
  end
  if key(data+pos,colon-1,"content-type")
   if type_seen
    return 0
   end
   set type_seen = 1
   if same(data+value,length,"application/x-www-form-urlencoded")==0
    return 0
   end
  end
  if key(data+pos,colon-1,"transfer-encoding")|key(data+pos,colon-1,"expect")
   return 0
  end
  set pos = pos+line+2
 end
 if host==0
  return 0
 end
 if load64(globals()+8)==2
  if (origin==0)|(length_seen==0)|(type_seen==0)
   return 0
  end
 else
  if (total!=0)|type_seen
   return 0
  end
 end
 if n>body+total
  return 0
 end
 while n<body+total
  set got = receive(fd,data+n,body+total-n,start)
  if got==0
   return 0
  end
  set n = n+got
 end
 do store64(globals()+16,data+body)
 do store64(globals()+24,total)
 return 1
end
fn form_token()
 return buffer("app_csrf_token",33)
end
fn form_session():IO
 let nonce=buffer("app_nonce",16)
 let fd=open("/dev/urandom",0,0)
 if fd>>63
  return err(5)
 end
 let i=0
 while i<16
  let n=read(fd,nonce+i,16-i)
  if (n==0)|(n>>63)
   do close(fd)
   return err(5)
  end
  set i=i+n
 end
 if close(fd)>>63
  return err(5)
 end
 let hex="0123456789abcdef"
 set i=0
 while i<16
  do store8(form_token()+i*2,load8(hex+(load8(nonce+i)>>4)))
  do store8(form_token()+i*2+1,load8(hex+(load8(nonce+i)&15)))
  set i=i+1
 end
 return ok(0)
end
fn form_key(p,n)
 if same(p,n,"appearance")
  return 11
 end
 if same(p,n,"room")
  return 10
 end
 if same(p,n,"token")
  return 0
 end
 if same(p,n,"rev")
  return 1
 end
 if same(p,n,"action")
  return 2
 end
 if same(p,n,"date")
  return 3
 end
 if same(p,n,"start")
  return 4
 end
 if same(p,n,"end")
  return 5
 end
 if same(p,n,"name")
  return 6
 end
 if same(p,n,"id")
  return 7
 end
 if same(p,n,"source")
  return 8
 end
 if same(p,n,"data")
  return 9
 end
 return 32
end
fn form_unquote(p,n,dst,cap,multiline):IO
 let pass=0
 let used=0
 while pass<2
  let i=0
  set used=0
  while i<n
   let c=load8(p+i)
   if c==43
    set c=32
   else
    if c==37
     if i+2>=n
      return err(22)
     end
     let a=text_hex(load8(p+i+1))
     let b=text_hex(load8(p+i+2))
     if (a>15)|(b>15)
      return err(22)
     end
     set c=a*16+b
     set i=i+2
    end
   end
   if (c<32)|(c==127)
    if (multiline==0)|((c!=9)&(c!=10)&(c!=13))
     return err(22)
    end
   end
   if all(used<cap,cap-used>1)==0
    return err(28)
   end
   if pass
    do store8(dst+used,c)
   end
   set used=used+1
   set i=i+1
  end
  if used>=cap
   return err(28)
  end
  set pass=pass+1
 end
 do store8(dst+used,0)
 return ok(used)
end
fn form_parse(p,n,allowed,values:FormValues):IO
 if (n==0)|(n>32768)
  return err(22)
 end
 let i=0
 while i<32
  set values[i]=0
  set i=i+1
 end
 let output=buffer("app_decoded_form",32769)
 let used=0
 let pos=0
 let seen=0
 let info=TextInfo(0,0,0,0)
 while pos<n
  let end=pos
  while all(end<n,load8(p+end)!=38)
   set end=end+1
  end
  let sep=pos
  while all(sep<end,load8(p+sep)!=61)
   set sep=sep+1
  end
  if (sep==end)|(end+1==n)
   return err(22)
  end
  let key=form_key(p+pos,sep-pos)
  if key>11
   return err(22)
  end
  let bit=1<<key
  if ((allowed&bit)==0)|((seen&bit)!=0)
   return err(22)
  end
  let bytes=0
  let cap=257
  if key>=8
   set cap=4097
  end
  if cap>32769-used
   return err(28)
  end
  handle form_unquote(p+sep+1,end-sep-1,output+used,cap,key>=8)
  ok decoded
   set bytes=decoded
  err decode_error
   return err(decode_error)
  end
  do text_measure(output+used,bytes,info)
  if info.status
   return err(84)
  end
  set values[key*2]=output+used
  set values[key*2+1]=bytes
  set used=used+bytes+1
  set seen=seen|bit
  set pos=end+1
 end
 if (seen&7)!=7
  return err(22)
 end
 if text_equal(values[0],values[1],form_token(),32)==0
  return err(403)
 end
 return ok(seen)
end
fn form_hidden(out:Writer,revision)
 do writer_text(out,"<input type=hidden name=token value=\"")
 do writer_text(out,form_token())
 do writer_text(out,"\"><input type=hidden name=rev value=\"")
 do writer_number(out,revision)
 return writer_text(out,"\">")
end

fn form_theme_cookie(p,n)
 let i=0
 let seen=0
 while i<n
  while all(i<n,(load8(p+i)==32)|(load8(p+i)==59))
   set i=i+1
  end
  let end=i
  while all(end<n,load8(p+end)!=59)
   set end=end+1
  end
  let prefix="rf2_booking_theme="
  if all(end-i>=18,text_equal(p+i,18,prefix,18))
   if seen|load64(globals()+120)
    return 0
   end
   set seen=1
   do store64(globals()+120,1)
   let value=p+i+18
   let bytes=end-i-18
   let mode=0
   if same(value,bytes,"light")
    set mode=1
   else
    if same(value,bytes,"dark")
     set mode=2
    else
     if same(value,bytes,"system")==0
      return 0
     end
    end
   end
   do store64(globals()+104,mode)
  end
  set i=end+1
 end
 return 1
end
