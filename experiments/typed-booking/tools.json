{
  "readOnly": [
    {
      "name": "booking_list",
      "title": "Read saved bookings",
      "description": "Read the one journal selected when this native server was launched. Returns an exact revision and snapshot digest. No path argument, network request or code execution.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "outcome": {
            "type": "string",
            "enum": [
              "read",
              "confirmed",
              "failed",
              "uncertain"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "version": {
            "type": "integer",
            "enum": [
              1,
              2
            ]
          },
          "bookings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]{0,19}$"
                },
                "room": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 16
                },
                "day": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 3652059
                },
                "start": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1439
                },
                "finish": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1440
                }
              },
              "required": [
                "id",
                "room",
                "day",
                "start",
                "finish"
              ],
              "additionalProperties": false
            },
            "maxItems": 256
          },
          "snapshot_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "errorCode": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "outcome"
        ],
        "additionalProperties": false
      }
    }
  ],
