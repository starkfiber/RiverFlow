profile RF2_SYSTEM_A64_V1
use "lib/store.flow"
use "lib/ui.flow"
use "lib/app-server.flow"
array BookingOrder(u64,256)
fn web_path()
 return load64(buffer("typed_booking_web_path",8))
end
fn web_order(rows:Bookings,order:BookingOrder)
 let keys=BookingOrder()
 let row=Booking(0,0,0,0,0)
 let i=0
 while i<rows.length
  handle records_read(rows,i,row)
  ok fields
  err read_error
   return 0
  end
  set order[i]=i
  set keys[i]=(row.day*1440+row.start)*16+row.room
  set i=i+1
 end
 set i=1
 while i<rows.length
  let chosen=order[i]
  let j=i
  while all(j>0,keys[order[j-1]]>keys[chosen])
   set order[j]=order[j-1]
   set j=j-1
  end
  set order[j]=chosen
  set i=i+1
 end
 return 1
end
fn web_cancel(out:Writer,revision,id)
 do writer_text(out,"<details class=cancel><summary>Cancel booking</summary><p>Remove this reservation from the saved bookings?</p><form action=/action method=post>")
 do form_hidden(out,revision)
 do writer_text(out,"<input type=hidden name=action value=cancel><input type=hidden name=id value=\"")
 do writer_number(out,id)
 return writer_text(out,"\"><button type=submit>Confirm cancellation</button></form></details>")
end
fn web_reservation(out:Writer,row:Booking,revision)
 do writer_text(out,"<article class=booking><div class=room-icon aria-hidden=true>")
 do writer_number(out,row.room)
 do writer_text(out,"</div><div><h3>Room ")
 do writer_number(out,row.room)
 do writer_text(out,"</h3><p class=booking-date>")
 do date_format(out,ui_date_key(row.day))
 do writer_text(out,"</p><p class=booking-time>")
 do time_format(out,row.start)
 do writer_text(out," <span aria-label=to>→</span> ")
 do time_format(out,row.finish)
 do writer_text(out,"</p><div class=booking-meta><span class=identifier>Reservation #")
 do writer_number(out,row.id)
 do writer_text(out,"</span></div></div>")
 do web_cancel(out,revision,row.id)
 return writer_text(out,"</article>")
end
fn web_form(out:Writer,rows:Bookings,state:StoreState,values:FormValues,error)
 do writer_text(out,"<section class=\"panel form-panel\" id=booking-form aria-labelledby=form-heading><p class=eyebrow>MAKE SOME SPACE</p><h2 id=form-heading>New booking</h2><p class=subtle>One room. One day. Your time.</p>")
 if rows.length>=256
  return writer_text(out,"<p>This workspace has 256 saved reservations. Cancel one before adding another.</p></section>")
 end
 do writer_text(out,"<form action=/action method=post>")
 do form_hidden(out,state.revision)
 do writer_text(out,"<input type=hidden name=action value=reserve><input type=hidden name=id value=\"")
 do writer_number(out,ui_next_id(rows))
 do writer_text(out,"\"><label class=field for=room>Room</label><select id=room name=room required>")
 let room=1
 while room<=16
  do writer_text(out,"<option value=\"")
  do writer_number(out,room)
  do writer_text(out,"\"")
  if error&(values[21]!=0)
   handle text_parse_u64(values[20],values[21],16)
   ok selected
    if selected==room
     do writer_text(out," selected")
    end
   err invalid_selection
   end
  end
  do writer_text(out,">Room ")
  do writer_number(out,room)
  do writer_text(out,"</option>")
  set room=room+1
 end
 do writer_text(out,"</select>")
 let day=0
 let day_bytes=0
 let start=0
 let start_bytes=0
 let finish=0
 let finish_bytes=0
 if error
  set day=values[6]
  set day_bytes=values[7]
  set start=values[8]
  set start_bytes=values[9]
  set finish=values[10]
  set finish_bytes=values[11]
 end
 do ui_input(out,"date","Date","date",day,day_bytes,"Calendar date, without timezone conversion.")
 do writer_text(out,"<div class=form-row><div>")
 do ui_input(out,"start","Start time","text",start,start_bytes,"Use 24-hour time: 09:00.")
 do writer_text(out,"</div><div>")
 do ui_input(out,"end","End time","text",finish,finish_bytes,"24:00 means the end of the day.")
 return writer_text(out,"</div></div><button type=submit>Save booking</button><p class=form-note>The room is checked again before saving. Adjacent bookings are allowed. An overlapping reservation will not be saved.</p></form></section>")
end
fn web_storage(out:Writer,state:StoreState)
 do writer_text(out,"<section class=\"panel storage-detail\"><h2>Saved in your workspace</h2><p class=subtle>A checked file, with a record of each confirmed change.</p><dl><dt>Workspace file</dt><dd>")
 do writer_html(out,web_path(),io_size(web_path()))
 do writer_text(out,"</dd><dt>Saved revision</dt><dd>")
 do writer_number(out,state.revision)
 do writer_text(out,"</dd><dt>Storage format</dt><dd>Version ")
 do writer_number(out,state.version)
 do writer_text(out,"</dd><dt>Verified file bytes</dt><dd>")
 do writer_number(out,state.bytes)
 do writer_text(out,"</dd></dl>")
 if state.version==1
  do writer_text(out,"<div class=storage-actions><div><h3>Enable multiple rooms</h3><p>Update this workspace to the current room format. Existing reservations stay in Room 1. The previous records stay in the file.</p>")
  do ui_action(out,state.revision,"migrate","Update room format")
  do writer_text(out,"</div></div>")
 end
 return writer_text(out,"<a class=storage-link href=/>Back to bookings</a></section>")
end
fn web_page(fd,rows:Bookings,state:StoreState,values:FormValues,error,saved,storage)
 let out=Writer(buffer("documents_web_output",1048576),1048576,0,0)
 let row=Booking(0,0,0,0,0)
 let order=BookingOrder()
 if web_order(rows,order)==0
  return app_bad(fd,"503 Service Unavailable")
 end
 if storage
  do ui_begin(out,"Storage")
  do writer_text(out,"<div class=page-heading><div><p class=eyebrow>YOUR WORKSPACE FILE</p><h1>Storage &amp; recovery</h1><p class=subtle>Review the saved revision and your recovery options.</p></div><a class=primary href=/>View bookings</a></div>")
 else
  do ui_begin(out,"Bookings")
  do writer_text(out,"<div class=page-heading><div><p class=eyebrow>YOUR SPACE, IN SYNC</p><h1>Bookings</h1><p class=subtle>A clear view of your rooms and reservations.</p></div><a class=primary href=#booking-form>+ New booking</a></div>")
 end
 do ui_notice(out,error,saved)
 if state.version==1
  do writer_text(out,"<section class=notice><strong>This workspace uses the single-room compatibility format.</strong><p>Bookings stay in Room 1 until you update the format.</p><a href=/storage>Review the storage update</a></section>")
 end
 let rooms=0
 let i=0
 while i<rows.length
  handle records_read(rows,i,row)
  ok fields
   set rooms=rooms|(1<<(row.room-1))
  err read_error
   return app_bad(fd,"503 Service Unavailable")
  end
  set i=i+1
 end
 let room_count=0
 while rooms
  set room_count=room_count+(rooms&1)
  set rooms=rooms>>1
 end
 do writer_text(out,"<section class=stats aria-label=\"Workspace summary\">")
 do ui_stat(out,"Saved reservations",rows.length,"Confirmed in this workspace")
 do ui_stat(out,"Rooms booked",room_count,"Across all saved reservations")
 do ui_stat(out,"Saved revision",state.revision,"Checked before each change")
 do writer_text(out,"</section>")
 if storage
  do web_storage(out,state)
 end
 if storage==0
 do writer_text(out,"<div class=content-grid><section class=panel aria-labelledby=saved-heading><div class=panel-heading><div><h2 id=saved-heading>Saved reservations</h2><p class=subtle>Ordered by date, time and room.</p></div><span class=count-badge>")
 do writer_number(out,rows.length)
 do writer_text(out," saved</span></div>")
 set i=0
 while i<rows.length
  handle records_read(rows,order[i],row)
  ok fields2
  err read_error2
   return app_bad(fd,"503 Service Unavailable")
  end
  do web_reservation(out,row,state.revision)
  set i=i+1
 end
 if rows.length==0
  do writer_text(out,"<div class=empty><svg aria-hidden=true viewBox=\"0 0 64 64\"><rect x=12 y=15 width=40 height=38 rx=7/><path d=\"M12 27h40M23 10v11m18-11v11M24 38h16m-8-8v16\"/></svg><h3>Room for your first plan.</h3><p>Choose a room, a date and a time. Your confirmed booking will appear here.</p></div>")
 end
 do writer_text(out,"<a class=storage-link href=/>Refresh saved bookings</a></section>")
 do web_form(out,rows,state,values,error)
 do writer_text(out,"</div>")
 end
 do ui_end(out)
 return ui_response(fd,out,"200 OK")
end
fn web_unavailable(fd,state:StoreState,error,action_error)
 let out=Writer(buffer("documents_web_output",1048576),1048576,0,0)
 do ui_begin(out,"Workspace")
 do ui_notice(out,action_error,0)
 do writer_text(out,"<section class=\"panel setup\">")
 if error==2
  do writer_text(out,"<p class=eyebrow>START HERE</p><h1>A workspace for your bookings.</h1><p>Create an empty booking file at the location you chose. Then add a room reservation and see it saved.</p>")
  do ui_action(out,0,"initialize","Create booking workspace")
 else
  if (error==9003)&(state.bytes!=0)
   do writer_text(out,"<p class=eyebrow>RECOVERY</p><h1>An interrupted save needs attention.</h1><p>The file has an incomplete last change after verified revision ")
   do writer_number(out,state.revision)
   do writer_text(out,". Restore the last verified revision to remove only that incomplete suffix. Complete changes will stay in the file.</p>")
   do ui_action(out,state.revision,"recover","Restore verified revision")
  else
   do writer_text(out,"<p class=eyebrow>WORKSPACE CHECK</p><h1>We could not open these bookings.</h1><p>The file has not been repaired or replaced. Keep it for inspection. Reference ")
   do writer_number(out,error)
   do writer_text(out,".</p><a href=/>Try reading the file again</a>")
  end
 end
 do writer_text(out,"</section>")
 do ui_end(out)
 return ui_response(fd,out,"200 OK")
end
fn web_request(values:FormValues,mask,request:StoreRequest):IO
 handle text_parse_u64(values[2],values[3],18446744073709551615)
 ok revision
  set request.expected=revision
 err revision_error
  return err(22)
 end
 if same(values[4],values[5],"reserve")
  if mask!=1215
   return err(22)
  end
  set request.action=2
  handle text_parse_u64(values[14],values[15],18446744073709551615)
  ok id
   set request.id=id
  err id_error
   return err(22)
  end
  handle text_parse_u64(values[20],values[21],16)
  ok room
   set request.room=room
  err room_error
   return err(22)
  end
  let key=0
  handle date_parse(values[6],values[7])
  ok parsed_date
   set key=parsed_date
  err date_error
   return err(22)
  end
  handle date_ordinal(key)
  ok day
   set request.day=day
  err day_error
   return err(22)
  end
  handle time_parse(values[8],values[9],0)
  ok start
   set request.start=start
  err start_error
   return err(22)
  end
  handle time_parse(values[10],values[11],1)
  ok finish
   set request.finish=finish
  err finish_error
   return err(22)
  end
  return ok(0)
 end
 if same(values[4],values[5],"cancel")
  if mask!=135
   return err(22)
  end
  set request.action=3
  handle text_parse_u64(values[14],values[15],18446744073709551615)
  ok cancel_id
   set request.id=cancel_id
  err cancel_error
   return err(22)
  end
  return ok(0)
 end
 if mask!=7
  return err(22)
 end
 if same(values[4],values[5],"migrate")
  set request.action=4
 else
  if same(values[4],values[5],"recover")
   set request.action=5
  else
   if same(values[4],values[5],"initialize")
    set request.action=1
   else
    return err(22)
   end
  end
 end
 return ok(0)
end
fn app_dispatch(fd):IO
 let target=buffer("app_target",32)
 let values=FormValues()
 let request=StoreRequest(0,0,0,0,0,0,0)
 let state=StoreState(0,0,0,0,0,0,0)
 let json=Writer(buffer("typed_booking_action_json",65536),65536,0,0)
 let error=0
 let saved=0
 if load64(globals()+8)==2
  if same(target,size(target),"/action")==0
   return ok(app_bad(fd,"404 Not Found"))
  end
  let mask=0
  handle form_parse(load64(globals()+16),load64(globals()+24),3263,values)
  ok parsed
   set mask=parsed
  err form_error
   if form_error==403
    return ok(app_bad(fd,"403 Forbidden"))
   end
   return ok(app_bad(fd,"400 Bad Request"))
  end
  if same(values[4],values[5],"appearance")
   if mask!=2055
    return ok(app_bad(fd,"400 Bad Request"))
   end
   let mode=0
   if same(values[22],values[23],"light")
    set mode=1
   else
    if same(values[22],values[23],"dark")
     set mode=2
    else
     if same(values[22],values[23],"system")==0
      return ok(app_bad(fd,"400 Bad Request"))
     end
    end
   end
   do store64(globals()+104,mode)
   do store64(globals()+112,1)
  else
   handle web_request(values,mask,request)
   ok requested
   err request_error
    set error=request_error
   end
   if error==0
    handle store_operation(web_path(),request,json)
    ok committed
     set saved=1
    err operation_error
     set error=operation_error
    end
   end
  end
 else
  if (same(target,size(target),"/")|same(target,size(target),"/storage"))==0
   return ok(app_bad(fd,"404 Not Found"))
  end
 end
 handle store_view(web_path(),state)
 ok own rows:Bookings
  return ok(web_page(fd,rows,state,values,error,saved,same(target,size(target),"/storage")))
 err view_error
  return ok(web_unavailable(fd,state,view_error,error))
 end
 return err(5)
end
fn main(argc,argv)
 if argc!=2
  return 2
 end
 do store64(buffer("typed_booking_web_path",8),load64(argv+8))
 handle form_session()
 ok session
 err session_error
  return 2
 end
 handle app_serve()
 ok served
  return served
 err server_error
  return 2
 end
 return 3
end
