profile RF2_SYSTEM_A64_V1
use "@rf2/v1/text-report-cli.flow"

fn text_report_fields(input:TextReportInput,report:Report,out:Writer):IO
 let cursor=TextCursor(0,0,0,0)
 let span=TextSpan(0,0)
 let lines=0
 let info_count=0
 let warn_count=0
 let error_count=0
 let other_count=0
 let p=input.data
 let n=input.size
 while text_next_line(p,n,cursor,span)
  if cursor.status
   return err(cursor.status)
  end
  set lines=lines+1
  let start=span.start
  let len=span.length
  let i=start
  let line_end=start+len
  let skipping=1
  while all(i<line_end,skipping)
   let leading_byte=load8(p+i)
   if any(leading_byte==32,leading_byte==9)
    set i=i+1
   else
    set skipping=0
   end
  end
  let token_start=i
  let token_len=0
  let scanning_token=1
  while all(i<line_end,scanning_token)
   let token_byte=load8(p+i)
   if any(token_byte==32,token_byte==9)
    set scanning_token=0
   else
    set token_len=token_len+1
    set i=i+1
   end
  end
  let is_info=0
  let is_warn=0
  let is_error=0
  if token_len==4
   if text_equal(p+token_start,token_len,"INFO",4)
    set is_info=1
   end
  end
  if token_len==4
   if text_equal(p+token_start,token_len,"WARN",4)
    set is_warn=1
   end
  end
  if token_len==5
   if text_equal(p+token_start,token_len,"ERROR",5)
    set is_error=1
   end
  end
  if is_info
   set info_count=info_count+1
  else
   if is_warn
    set warn_count=warn_count+1
   else
    if is_error
     set error_count=error_count+1
    else
     set other_count=other_count+1
    end
   end
  end
 end
 if cursor.status
  return err(cursor.status)
 end
 do report_text(report,out,"Path",4,input.path,io_size(input.path))
 do report_number(report,out,"Lines",5,lines)
 do report_number(report,out,"INFO",4,info_count)
 do report_number(report,out,"WARN",4,warn_count)
 do report_number(report,out,"ERROR",5,error_count)
 do report_number(report,out,"Other",5,other_count)
 return ok(0)
end

fn main(argc,argv)
 return text_report_entry(argc,argv,"Log severity",12,0)
end
