profile RF2_SYSTEM_A64_V1
use "@rf2/v1/text.flow"

fn log_report(mode,path):IO
 let data=buffer("log_data",4097)
 let info=TextInfo(0,0,0,0)
 let n=try io_regular(path,data,4096)
 do text_measure(data,n,info)
 if info.status
  return err(2)
 end
 let out=Writer(buffer("log_out",32768),32768,0,0)
 let is_json=0
 if text_equal(mode,io_size(mode),"json",4)
  set is_json=1
 else
  if text_equal(mode,io_size(mode),"html",4)
   set is_json=0
  else
   return err(2)
  end
 end
 let lines=0
 let info_count=0
 let warn_count=0
 let error_count=0
 let other_count=0
 let cursor=TextCursor(0,0,0,0)
 let span=TextSpan(0,0)
 while text_next_line(data,n,cursor,span)
  if cursor.status
   return err(2)
  end
  set lines=lines+1
  let start=span.start
  let len=span.length
  let i=start
  let line_end=start+len
  let scanning=1
  while all(i<line_end,scanning)
   let b=load8(data+i)
   if b==32
    set i=i+1
   else
    if b==9
     set i=i+1
    else
     set scanning=0
    end
   end
  end
  let token=0
  if i+4<=line_end
   if load8(data+i)==73
    if load8(data+i+1)==78
     if load8(data+i+2)==70
      if load8(data+i+3)==79
       set token=1
      end
     end
    end
   end
  end
  if token==0
   if i+4<=line_end
    if load8(data+i)==87
     if load8(data+i+1)==65
      if load8(data+i+2)==82
       if load8(data+i+3)==78
        set token=2
       end
      end
     end
    end
   end
  end
  if token==0
   if i+5<=line_end
    if load8(data+i)==69
     if load8(data+i+1)==82
      if load8(data+i+2)==82
       if load8(data+i+3)==79
        if load8(data+i+4)==82
         set token=3
        end
       end
      end
     end
    end
   end
  end
  if token!=0
   let j=i
   if token==1
    set j=i+4
   else
    if token==2
     set j=i+4
    else
     set j=i+5
    end
   end
   if j==line_end
    if token==1
     set info_count=info_count+1
    else
     if token==2
      set warn_count=warn_count+1
     else
      set error_count=error_count+1
     end
    end
   else
    let b2=load8(data+j)
    if b2==32
     if token==1
      set info_count=info_count+1
     else
      if token==2
       set warn_count=warn_count+1
      else
       set error_count=error_count+1
      end
     end
    else
     if b2==9
      if token==1
       set info_count=info_count+1
      else
       if token==2
        set warn_count=warn_count+1
       else
        set error_count=error_count+1
       end
      end
     else
      set other_count=other_count+1
     end
    end
   end
  else
   set other_count=other_count+1
  end
 end
 if cursor.status
  return err(2)
 end
 if is_json==1
  do writer_text(out,"{\"title\":\"Log severity\",\"fields\":[")
  do writer_text(out,"{\"name\":\"Path\",\"value\":")
  do writer_json(out,path,io_size(path))
  do writer_text(out,"},{\"name\":\"Lines\",\"value\":")
  do writer_number(out,lines)
  do writer_text(out,"},{\"name\":\"INFO\",\"value\":")
  do writer_number(out,info_count)
  do writer_text(out,"},{\"name\":\"WARN\",\"value\":")
  do writer_number(out,warn_count)
  do writer_text(out,"},{\"name\":\"ERROR\",\"value\":")
  do writer_number(out,error_count)
  do writer_text(out,"},{\"name\":\"Other\",\"value\":")
  do writer_number(out,other_count)
  do writer_text(out,"}]}\n")
 else
  do writer_text(out,"<!doctype html><html lang=\"en\"><meta charset=\"utf-8\"><title>Log severity</title><main><h1>Log severity</h1><dl>")
  do writer_text(out,"<dt>Path</dt><dd>")
  do writer_html(out,path,io_size(path))
  do writer_text(out,"</dd><dt>Lines</dt><dd>")
  do writer_number(out,lines)
  do writer_text(out,"</dd><dt>INFO</dt><dd>")
  do writer_number(out,info_count)
  do writer_text(out,"</dd><dt>WARN</dt><dd>")
  do writer_number(out,warn_count)
  do writer_text(out,"</dd><dt>ERROR</dt><dd>")
  do writer_number(out,error_count)
  do writer_text(out,"</dd><dt>Other</dt><dd>")
  do writer_number(out,other_count)
  do writer_text(out,"</dd></dl></main></html>\n")
 end
 if out.error
  return err(2)
 end
 let w=try io_write_no_sigpipe(1,out.data,out.used)
 if w!=out.used
  return err(2)
 end
 return ok(0)
end
fn main(argc,argv)
 if argc!=3
  return 2
 end
 handle log_report(load64(argv+8),load64(argv+16))
 ok done_value
  return 0
 err failure_code
  return 2
 end
 return 2
end
