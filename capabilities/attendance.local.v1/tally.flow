FLOW "Attendance packed tally"
PROFILE RF2_U32_CORE_V0
ARITHMETIC CHECKED
FUNCTION add_count(left: u32, right: u32) RETURNS u32
STEP add = ADD WITH { a: left, b: right, result: value }
RETURN value
END
FUNCTION main(data: u32[], count: u32) RETURNS u32
VAR total = 0
FOR i FROM 0 TO count LIMIT 1000
STEP read = LOAD WITH { array: data, index: i, result: item }
STEP add = CALL add_count WITH { left: total, right: item, result: total }
END FOR
RETURN total
END
