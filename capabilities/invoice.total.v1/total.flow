FLOW "Invoice line totals"
PROFILE RF2_U32_CORE_V0
ARITHMETIC CHECKED
FUNCTION line_total(quantity: u32, price: u32) RETURNS u32
  STEP multiply = MUL WITH { a: quantity, b: price, result: amount }
  RETURN amount
END
FUNCTION main(data: u32[], count: u32) RETURNS u32
  VAR total = 0
  FOR i FROM 0 TO count LIMIT 1000
    STEP offset = MUL WITH { a: i, b: 2, result: index }
    STEP next = ADD WITH { a: index, b: 1, result: price_index }
    STEP qty = LOAD WITH { array: data, index: index, result: quantity }
    STEP cost = LOAD WITH { array: data, index: price_index, result: price }
    STEP line = CALL line_total WITH { quantity: quantity, price: price, result: amount }
    STEP add = ADD WITH { a: total, b: amount, result: total }
  END FOR
  RETURN total
END
