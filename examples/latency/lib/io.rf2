module io
fn io_length(text)
 let n = 0
 while load8(text + n) != 0
  set n = n + 1
 end
 return n
end
fn io_print(text)
 let n = io_length(text)
 return write(1, text, n) == n
end
fn io_fail(text)
 do write(2, text, io_length(text))
 do write(2, "\n", 1)
 do exit(1)
 return 0
end
fn io_number(value)
 let p = buffer("io_digits", 24)
 let i = 24
 let q = 0
 if value == 0
  return write(1, "0", 1)
 end
 while value != 0
  set q = value // 10
  set i = i - 1
  do store8(p + i, 48 + value - q * 10)
  set value = q
 end
 return write(1, p + i, 24 - i)
end
