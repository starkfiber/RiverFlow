profile RF2_SYSTEM_A64_V1
use "lib/search.rf2"
fn search_write(fd,p,n)
 let done=0
 while done<n
  let wrote=write(fd,p+done,n-done)
  if (wrote>>63)|(wrote==0)
   return 0
  end
  set done=done+wrote
 end
 return 1
end
fn search_length(p,limit)
 let n=0
 while n<limit
  if load8(p+n)==0
   return n
  end
  set n=n+1
 end
 return limit
end
fn search_number(n)
 let digits=buffer("search_digits",24)
 let i=24
 if n==0
  return search_write(1,"0",1)
 end
 while n
  set i=i-1
  do store8(digits+i,48+n-(n//10)*10)
  set n=n//10
 end
 return search_write(1,digits+i,24-i)
end
fn search_help(fd)
 let text="Usage: log-scan QUERY\nReads at most 1 MiB from stdin; counts exact byte matches within LF-delimited lines.\nQuery limit 4096 bytes. Final unterminated content is one line.\n"
 return search_write(fd,text,search_length(text,512))
end
fn main(argc,argv)
 if argc!=2
  do search_help(2)
  return 2
 end
 let query=load64(argv+8)
 let m=search_length(query,4097)
 if m==6
  if (load8(query)==45)&(load8(query+1)==45)&(load8(query+2)==104)&(load8(query+3)==101)&(load8(query+4)==108)&(load8(query+5)==112)
   if search_help(1)==0
    return 5
   end
   return 0
  end
 end
 if m>4096
  do search_write(2,"Query exceeds 4096 bytes\n",25)
  return 2
 end
 # Borrowed streams: no file creation, named path or hidden background operation.
 let input=buffer("log_input",1048577)
 let n=0
 let got=1
 while got!=0
  set got=read(0,input+n,1048577-n)
  if got>>63
   do search_write(2,"Input read failed\n",18)
   return 3
  end
  set n=n+got
  if n>1048576
   do search_write(2,"Input exceeds 1 MiB\n",20)
   return 4
  end
 end
 let prefix=SearchPrefix()
 let out=ByteSearch(0,0,0)
 let lines=0
 let matching=0
 let matches=0
 let first=0
 let start=0
 let end=0
 while start<n
  set end=start
  while all(end<n,load8(input+end)!=10)
   set end=end+1
  end
  set lines=lines+1
  do byte_search(input+start,end-start,query,m,0,prefix,out)
  if out.status
   return 2
  end
  set matches=matches+out.matches
  if out.matches
   set matching=matching+1
   if first==0
    set first=lines
   end
  end
  set start=end+1
 end
 let ok=search_write(1,"{\"bytes\":",9)
 set ok=ok&search_number(n)
 set ok=ok&search_write(1,",\"query_bytes\":",15)
 set ok=ok&search_number(m)
 set ok=ok&search_write(1,",\"lines\":",9)
 set ok=ok&search_number(lines)
 set ok=ok&search_write(1,",\"matching_lines\":",18)
 set ok=ok&search_number(matching)
 set ok=ok&search_write(1,",\"matches\":",11)
 set ok=ok&search_number(matches)
 set ok=ok&search_write(1,",\"first_line\":",14)
 if first
  set ok=ok&search_number(first)
 else
  set ok=ok&search_write(1,"null",4)
 end
 set ok=ok&search_write(1,"}\n",2)
 if ok==0
  return 5
 end
 return 0
end
