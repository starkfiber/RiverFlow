# Test-only GPIO substitution. Never linked into a board image.
# Input header: SDA script length, stuck-clock start/read-count, stuck duration,
# selected entry, arg1, arg2 (six little-endian u64); then SDA samples as bytes.
fn model_state()
 return buffer("tmp102_model_state",64)
end
fn model_input()
 return buffer("tmp102_model_input",2048)
end
fn model_events()
 return buffer("tmp102_model_events",32768)
end
fn bus_delay()
 return 0
end
fn model_event(kind,high)
 let p=model_state()
 let n=load64(p+16)
 if n<4096
  do store64(model_events()+n*8,kind*256+high)
  do store64(p+16,n+1)
 else
  do store64(p+48,1)
 end
 return 0
end
fn bus_sda(high)
 do store64(model_state()+24,high)
 return model_event(1,high)
end
fn bus_scl(high)
 do store64(model_state()+32,high)
 return model_event(2,high)
end
fn bus_read_sda()
 let p=model_state()
 let n=load64(p)
 do store64(p,n+1)
 if n>=load64(model_input())
  do store64(p+40,load64(p+40)+1)
  return 1
 end
 return load8(model_input()+48+n)
end
fn bus_read_scl()
 let p=model_state()
 let n=load64(p+8)+1
 do store64(p+8,n)
 let start=load64(model_input()+8)
 if start
  if n>=start
   if n-start<load64(model_input()+16)
    return 0
   end
  end
 end
 return 1
end
fn bus_setup()
 return 0
end
fn uart_byte(value)
 if load64(model_input()+32)
  return 1
 end
 let state=model_state()
 let n=load64(state+56)
 if n>=512
  return 1
 end
 do store8(buffer("tmp102_uart_model",512)+n,value)
 do store64(state+56,n+1)
 return 0
end
