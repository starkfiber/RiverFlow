module doc_http
use "lib/corpus.flow"
fn globals()
 return buffer("documents_web_state",128)
end
fn size(p)
 let n = 0
 while load8(p+n)!=0
  set n = n+1
 end
 return n
end
fn copy(dst,src,n)
 let i = 0
 while i<n
  do store8(dst+i,load8(src+i))
  set i = i+1
 end
 return n
end
fn same(p,n,text)
 let i = 0
 if n!=size(text)
  return 0
 end
 while i<n
  if load8(p+i)!=load8(text+i)
   return 0
  end
  set i = i+1
 end
 return 1
end
fn key(p,n,text)
 let i = 0
 let c = 0
 if n!=size(text)
  return 0
 end
 while i<n
  set c = load8(p+i)
  if (c>=65)&(c<=90)
   set c = c+32
  end
  if c!=load8(text+i)
   return 0
  end
  set i = i+1
 end
 return 1
end
fn find(p,n,text,count)
 let i = 0
 let j = 0
 while i+count<=n
  set j = 0
  while (j<count)&(load8(p+i+j)==load8(text+j))
   set j = j+1
  end
  if j==count
   return i+1
  end
  set i = i+1
 end
 return 0
end
fn reset_output()
 do store64(globals()+80,0)
 do store64(globals()+88,0)
 return 0
end
fn text(p)
 let n = size(p)
 let used = load64(globals()+80)
 if used+n>=1048576
  do store64(globals()+88,1)
  return 0
 end
 do copy(buffer("documents_web_output",1048576)+used,p,n)
 do store64(globals()+80,used+n)
 return 0
end
fn decimal(value)
 let digits = buffer("documents_web_digits",32)
 let n = 0
 let one = buffer("documents_web_one",2)
 while 1
  do store8(digits+n,48+value-value//10*10)
  set n = n+1
  set value = value//10
  if value==0
   while n!=0
    set n = n-1
    do store8(one,load8(digits+n))
    do text(one)
   end
   return 0
  end
 end
 return 0
end
fn unsigned(p,n,max)
 if (n==0)|(n>10)
  return -1
 end
 let i = 0
 let value = 0
 let c = 0
 while i<n
  set c = load8(p+i)
  if (c<48)|(c>57)
   return -1
  end
  set value = value*10+c-48
  if value>max
   return -1
  end
  set i = i+1
 end
 return value
end
fn elapsed(start)
 return (vm_clock_ticks()-start)*load32(buffer("documents_web_timebase",8))//load32(buffer("documents_web_timebase",8)+4)
end
fn wait_ready(fd,event,start)
 let poll = buffer("documents_web_io_poll",8)
 let remaining = 0
 let rc = 0
 let age = elapsed(start)
 while age<2000000000
  set remaining = (2000000000-age)//1000000
  if remaining==0
   set remaining = 1
  end
  do store32(poll,fd)
  do store32(poll+4,event)
  set rc = syscall6(230,poll,1,remaining,0,0,0)
  if rc>>63
   return 0
  end
  if rc!=0
   if (load32(poll+4)>>16)&event
    return 1
   end
   return 0
  end
  set age = elapsed(start)
 end
 return 0
end
fn receive(fd,p,n,start)
 let got = 0
 while wait_ready(fd,1,start)
  set got = read(fd,p,n)
  if (got>>63)==0
   return got
  end
  # EINTR/EAGAIN remain bounded by the same monotonic deadline.
 end
 return 0
end
fn send(fd,p,n,start)
 let done = 0
 let got = 0
 while done<n
  if wait_ready(fd,4,start)==0
   return 0
  end
  set got = write(fd,p+done,n-done)
  if (got==0)|(got>>63)
   return 0
  end
  set done = done+got
 end
 return 1
end
fn request(fd)
 let data = buffer("documents_web_request",4353)
 let n = 0
 let got = 0
 let end = 0
 let first = 0
 let sep = 0
 let space = 0
 let pos = 0
 let line = 0
 let colon = 0
 let value = 0
 let length = 0
 let host = 0
 let origin = 0
 let length_seen = 0
 let type_seen = 0
 let total = 0
 let body = 0
 let i = 0
 let c = 0
 let start = vm_clock_ticks()
 do store64(globals()+8,0)
 do store64(globals()+16,0)
 do store64(globals()+24,0)
 do store64(globals()+32,0)
 while (end==0)&(n<4096)
  set got = receive(fd,data+n,4096-n,start)
  if got==0
   return 0
  end
  set n = n+got
  do store64(globals()+32,n)
  set end = find(data,n,"\r\n\r\n",4)
 end
 if end==0
  return 0
 end
 set body = end+3
 set first = find(data,body,"\r\n",2)
 if (first==0)|(first>2048)
  return 0
 end
 set sep = find(data,first-1," ",1)
 if sep==0
  return 0
 end
 if same(data,sep-1,"GET")
  do store64(globals()+8,1)
 else
  return 0
 end
 set space = find(data+sep,first-sep-1," ",1)
 if (space<2)|(space>2049)
  return 0
 end
 set i = 0
 while i<space-1
  set c = load8(data+sep+i)
  if (c<33)|(c>126)
   return 0
  end
  set i = i+1
 end
 do copy(buffer("documents_web_target",2049),data+sep,space-1)
 do store8(buffer("documents_web_target",2049)+space-1,0)
 if same(data+sep+space,first-1-sep-space,"HTTP/1.1")==0
  return 0
 end
 set pos = first+1
 while pos<end-1
  set line = find(data+pos,body-pos,"\r\n",2)
  if (line==0)|(line>1024)
   return 0
  end
  set line = line-1
  set colon = find(data+pos,line,":",1)
  if (colon==0)|(colon==1)
   return 0
  end
  set i = 0
  while i<colon-1
   set c = load8(data+pos+i)
   if ((c<65)|(c>90))&((c<97)|(c>122))&((c<48)|(c>57))&(c!=45)
    return 0
   end
   set i = i+1
  end
  set value = pos+colon
  set length = line-colon
  while (length>0)&((load8(data+value)==32)|(load8(data+value)==9))
   set value = value+1
   set length = length-1
  end
  set i = 0
  while i<length
   set c = load8(data+value+i)
   if ((c<32)&(c!=9))|(c>126)
    return 0
   end
   set i = i+1
  end
  if key(data+pos,colon-1,"host")
   if host
    return 0
   end
   set host = 1
   if same(data+value,length,buffer("documents_web_host",64))==0
    return 0
   end
  end
  if key(data+pos,colon-1,"origin")
   if origin
    return 0
   end
   set origin = 1
   if same(data+value,length,buffer("documents_web_url",96))==0
    return 0
   end
  end
  if key(data+pos,colon-1,"content-length")
   if length_seen
    return 0
   end
   set length_seen = 1
   set total = unsigned(data+value,length,256)
   if total>>63
    return 0
   end
  end
  if key(data+pos,colon-1,"content-type")
   if type_seen
    return 0
   end
   set type_seen = 1
   if same(data+value,length,"application/x-www-form-urlencoded")==0
    return 0
   end
  end
  if key(data+pos,colon-1,"transfer-encoding")|key(data+pos,colon-1,"expect")
   return 0
  end
  set pos = pos+line+2
 end
 if host==0
  return 0
 end
 if load64(globals()+8)==2
  if (origin==0)|(length_seen==0)|(type_seen==0)
   return 0
  end
 else
  if (total!=0)|type_seen
   return 0
  end
 end
 if n>body+total
  return 0
 end
 while n<body+total
  set got = receive(fd,data+n,body+total-n,start)
  if got==0
   return 0
  end
  set n = n+got
 end
 do store64(globals()+16,data+body)
 do store64(globals()+24,total)
 return 1
end
fn respond(fd,status,mime)
 let n=load64(globals()+80)
 if load64(globals()+88)
  return 0
 end
 do copy(buffer("documents_web_body",1048576),buffer("documents_web_output",1048576),n)
 do reset_output()
 do text("HTTP/1.1 ")
 do text(status)
 do text("\r\nConnection: close\r\nCache-Control: no-store\r\nX-Content-Type-Options: nosniff\r\nReferrer-Policy: same-origin\r\nCross-Origin-Resource-Policy: same-origin\r\nContent-Security-Policy: default-src 'none'; style-src 'unsafe-inline'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'\r\nContent-Type: ")
 do text(mime)
 do text("\r\nContent-Length: ")
 do decimal(n)
 do text("\r\n\r\n")
 let start=vm_clock_ticks()
 if send(fd,buffer("documents_web_output",1048576),load64(globals()+80),start)==0
  return 0
 end
 return send(fd,buffer("documents_web_body",1048576),n,start)
end
fn bad(fd,status)
 do reset_output()
 do text("<!doctype html><html lang=en><meta charset=utf-8><title>Request refused</title><h1>Request refused</h1><p>The document snapshot is unchanged. Try a shorter search (up to 256 UTF-8 bytes) or return to all documents.</p><p><a href=/>Return to the workspace</a></p></html>")
 return respond(fd,status,"text/html; charset=utf-8")
end
