module parser
record Cursor(p:u64,n:u64,i:u64,error:u64)
fn space(v)
 return any(v==32,any(v==9,any(v==10,v==13)))
end
fn skip(c:Cursor)
 while c.i<c.n
  if not(space(load8(c.p+c.i)))
   return 0
  end
  set c.i=c.i+1
 end
 return 0
end
fn word(c:Cursor,w)
 do skip(c)
 let j=0
 while load8(w+j)!=0
  if c.i>=c.n
   set c.error=1
   return 0
  end
  if load8(c.p+c.i)!=load8(w+j)
   set c.error=1
   return 0
  end
  set c.i=c.i+1
  set j=j+1
 end
 if c.i<c.n
  if not(space(load8(c.p+c.i)))
   set c.error=1
  end
 end
 return 0
end
fn number(c:Cursor)
 do skip(c)
 let value=0
 let digits=0
 let byte=0
 let first=0
 while c.i<c.n
  set byte=load8(c.p+c.i)
  if space(byte)
   if digits==0
    set c.error=1
   end
   return value
  end
  if any(byte<48,byte>57)
   set c.error=1
   return 0
  end
  if digits==0
   set first=byte
  else
   if first==48
    set c.error=1
    return 0
   end
  end
  if any(value>1844674407370955161,all(value==1844674407370955161,byte>53))
   set c.error=1
   return 0
  end
  set value=value*10+byte-48
  set digits=digits+1
  set c.i=c.i+1
 end
 if digits==0
  set c.error=1
 end
 return value
end
fn parse(c:Cursor,data:Data,p:Plan,codes:Ops,args:Ops)
 let i=0
 let v=0
 do word(c,"RF2E1")
 do word(c,"allow")
 set p.allow=number(c)
 do word(c,"budget")
 set p.budget=number(c)
 do word(c,"input")
 set p.count=number(c)
 if any(c.error,p.count>128)
  return 1
 end
 while i<p.count
  set v=number(c)
  if any(c.error,v>255)
   return 1
  end
  set data[i]=v
  set i=i+1
 end
 do word(c,"steps")
 set p.steps=number(c)
 if any(c.error,p.steps>32)
  return 1
 end
 set i=0
 while i<p.steps
  do skip(c)
  if c.i>=c.n
   return 1
  end
  set v=load8(c.p+c.i)
  if v==97
   do word(c,"add")
   set codes[i]=1
   set args[i]=number(c)
  else
   if v==120
    do word(c,"xor")
    set codes[i]=2
    set args[i]=number(c)
   else
    do word(c,"reverse")
    set codes[i]=4
    set args[i]=0
   end
  end
  if c.error
   return 1
  end
  set i=i+1
 end
 do skip(c)
 return any(c.error,c.i!=c.n)
end
# Strict lowercase hexadecimal. Returns decoded byte length.
fn hex_value(v)
 if all(v>=48,v<=57)
  return v-48
 end
 if all(v>=97,v<=102)
  return v-87
 end
 return 256
end
fn decode_hex(c:Cursor,dst,limit)
 do skip(c)
 let count=0
 let high=0
 let low=0
 while c.i<c.n
  if space(load8(c.p+c.i))
   return count
  end
  if any(count>=limit,c.n-c.i<2)
   set c.error=1
   return 0
  end
  set high=hex_value(load8(c.p+c.i))
  set low=hex_value(load8(c.p+c.i+1))
  if any(high>15,low>15)
   set c.error=1
   return 0
  end
  do store8(dst+count,high*16+low)
  set count=count+1
  set c.i=c.i+2
 end
 return count
end
fn decode_capsule(c:Cursor,plan,expected)
 let temp=buffer("capsule_hash",32)
 let start=0
 let i=0
 let n=0
 do word(c,"RF2C1")
 do word(c,"source")
 do skip(c)
 set start=c.i
 set n=decode_hex(c,temp,32)
 if any(c.error,n!=32)
  set c.error=1
  return 0
 end
 while i<64
  if load8(c.p+start+i)!=load8(build_identity()+i)
   set c.error=1
   return 0
  end
  set i=i+1
 end
 do word(c,"receipt")
 do skip(c)
 set start=c.i
 set n=decode_hex(c,temp,32)
 if any(c.error,n!=32)
  set c.error=1
  return 0
 end
 do copy_bytes(expected,c.p+start,64)
 do store8(expected+64,0)
 do word(c,"plan")
 set n=decode_hex(c,plan,8192)
 do skip(c)
 if any(c.error,any(n==0,c.i!=c.n))
  set c.error=1
  return 0
 end
 return n
end
