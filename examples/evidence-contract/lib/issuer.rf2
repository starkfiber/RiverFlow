module issuer
fn issue_plan(key,src,n,e:Envelope)
 let data=Data()
 let ops=Ops()
 let args=Ops()
 let p=Plan(0,0,0,0)
 let r=Run(0,0,0,0,0,0)
 let c=Cursor(src,n,0,0)
 let actual=buffer("issue_actual",128)
 let expected=buffer("issue_expected",128)
 let report=buffer("issue_report",56)
 let checked=buffer("issue_checked",56)
 let i=0
 if parse(c,data,p,ops,args)
  return 0
 end
 do execute(data,p,ops,args,r)
 while i<p.count
  do store8(actual+i,data[i])
  set i=i+1
 end
 do store64(report,r.code)
 do store64(report+8,r.step)
 do store64(report+16,r.index)
 do store64(report+24,r.expected)
 do store64(report+32,r.actual)
 do store64(report+40,r.work)
 do store64(report+48,p.count)
 # A separately written parser/trajectory evaluator gates every issued MAC.
 if not(independent_plan(src,n,expected,checked))
  return 0
 end
 if not(all(same_bytes(report,checked,56),same_bytes(actual,expected,p.count)))
  return 0
 end
 set e.plan=src
 set e.length=n
 set e.receipt=buffer("issue_receipt",32)
 set e.tag=buffer("issue_tag",32)
 set e.kid=buffer("issue_kid",16)
 do copy_bytes(e.receipt,receipt_for(src,n,actual,report),32)
 do key_id(key,e.kid)
 do auth_tag(key,e,e.tag)
 return 1
end
