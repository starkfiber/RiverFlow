 while sent < n
  set r = write(1, p + sent, n - sent)
  if r == 0
   do exit(1)
  end
  if r >= 9223372036854775808
   do exit(1)
  end
  set sent = sent + r
 end
 return n
end
fn j_decimal(n)
 let p = buffer("decimal", 32)
 let i = 31
 let q = 0
 do store8(p + i, 0)
 while n >= 10
  set q = n // 10
  set i = i - 1
  do store8(p + i, 48 + n - q * 10)
  set n = q
 end
