end
fn j_state()
 return buffer("state", 128)
end
fn j_fail(code)
 do store64(j_state() + 0, code)
 return 0
end
fn j_whitespace(c)
 if c == 32
  return 1
 end
 if c == 9
  return 1
 end
 if c == 10
  return 1
 end
 if c == 13
  return 1
 end
 return 0
end
fn j_skip(p, endp)
 while p < endp
  if j_whitespace(load8(p)) == 0
   return p
  end
  set p = p + 1
 end
 return p
end
fn j_hex(c)
 if c >= 48
  if c <= 57
   return c - 48
  end
 end
 if c >= 65
  if c <= 70
   return c - 55
  end
 end
 if c >= 97
  if c <= 102
   return c - 87
  end
 end
 return 256
end
fn j_digit(c)
 if c < 48
  return 0
 end
 return c <= 57
end
fn j_token(i)
 return buffer("tokens", 3360000) + i * 48
end
# JSON state: cursor+8,end+16,token count+24,arena used+32.
