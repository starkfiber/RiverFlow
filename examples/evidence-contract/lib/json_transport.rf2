module transport
# Derived from native/rf2.rf2 by tools/sync-contract-json.py.
fn j_slen(p)
 let n = 0
 while load8(p + n) != 0
  set n = n + 1
 end
 return n
end
fn j_eq(a, b)
 let i = 0
 while load8(a + i) == load8(b + i)
  if load8(a + i) == 0
   return 1
  end
  set i = i + 1
 end
 return 0
end
fn j_say(p)
 return j_output(p, j_slen(p))
end
fn j_output(p, n)
