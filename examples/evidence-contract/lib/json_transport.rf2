   do store64(t + 16, p - start)
   do store64(s + 8, p)
  end
 end
 do store64(t + 24, load64(s + 24))
 return idx
end
fn j_digits_end(p, endp)
 while p < endp
  if j_digit(load8(p)) == 0
   return p
  end
  set p = p + 1
 end
 return p
end
fn j_json_number_tail(t, start, p, endp, idx)
 let before = 0
 let c = 0
 if p < endp
  if load8(p) == 46
   set p = p + 1
   set before = p
   set p = j_digits_end(p, endp)
   if p == before
    return j_fail(1)
   end
  end
 end
 if p < endp
  set c = load8(p)
  if c == 69
   set c = 101
  end
  if c == 101
   set p = p + 1
   if p < endp
    set c = load8(p)
    if c == 43
     set p = p + 1
    else
     if c == 45
      set p = p + 1
     end
    end
   end
   set before = p
   set p = j_digits_end(p, endp)
   if p == before
    return j_fail(1)
   end
  end
 end
 do store64(t + 16, p - start)
 do store64(t + 24, load64(j_state() + 24))
