end
fn j_same_string(a, b)
 let n = load64(a + 40)
 let i = 0
 if n != load64(b + 40)
  return 0
 end
 while i < n
  if load8(load64(a + 32) + i) != load8(load64(b + 32) + i)
   return 0
  end
  set i = i + 1
 end
 return 1
end
fn j_matches(t, text)
 let n = j_slen(text)
 let i = 0
 if load64(t) != 1
  return 0
 end
 if load64(t + 40) != n
  return 0
 end
 while i < n
  if load8(load64(t + 32) + i) != load8(text + i)
   return 0
  end
  set i = i + 1
 end
 return 1
end
fn j_field(t, name)
 let i = t + 1
 let until = load64(j_token(t) + 24)
 if load64(j_token(t)) != 2
  return 0
 end
 while i < until
  if j_matches(j_token(i), name)
   return i + 1
  end
  set i = load64(j_token(i + 1) + 24)
 end
 return 0
end
fn j_utf8(p, n)
 let i = 0
 let c = 0
 let remaining = 0
 let v = 0
 let lower = 0
 let j = 0
 while i < n
  set c = load8(p + i)
  set i = i + 1
  if c >= 128
   if c < 194
    return 0
   end
   if c < 224
    set remaining = 1
    set v = c & 31
    set lower = 128
   else
    if c < 240
     set remaining = 2
     set v = c & 15
     set lower = 2048
    else
     if c > 244
      return 0
     end
     set remaining = 3
     set v = c & 7
     set lower = 65536
    end
   end
   if i + remaining > n
    return 0
   end
   set j = 0
   while j < remaining
    set c = load8(p + i)
    if c < 128
     return 0
    end
    if c > 191
     return 0
    end
    set v = v * 64 + (c & 63)
    set i = i + 1
    set j = j + 1
   end
   if v < lower
    return 0
   end
   if v > 1114111
    return 0
   end
   if v >= 55296
    if v <= 57343
     return 0
    end
   end
  end
 end
 return 1
end
fn j_number_u32(t)
 let p = load64(t + 8)
 let n = load64(t + 16)
 let i = 0
 let neg = 0
 let c = 0
 let frac = 0
 let decimal_seen = 0
 let significant = 0
 let trailing = 0
 let value = 0
 let e = 0
 let eneg = 0
 let shift = 0
 if load64(t) != 7
  return j_fail(2)
 end
 # Common canonical integer fast path. Other valid JSON numeric forms use the unchanged exact parser.
 if (n > 0) & (n <= 10)
  while i < n
   if j_digit(load8(p + i)) == 0
    set i = n + 1
   else
    set value = value * 10 + load8(p + i) - 48
    set i = i + 1
   end
  end
  if i == n
   if value > 4294967295
    return j_fail(2)
   end
   return value
  end
  set i = 0
  set value = 0
 end

 if load8(p) == 45
  set neg = 1
  set i = 1
 end
 while i < n
  set c = load8(p + i)
  if c == 69
   set c = 101
  end
  if c == 101
   set i = i + 1
   if load8(p + i) == 45
    set eneg = 1
    set i = i + 1
   else
    if load8(p + i) == 43
     set i = i + 1
    end
   end
   while i < n
    if e < 1000000
     set e = e * 10 + load8(p + i) - 48
    end
    set i = i + 1
   end
  else
   if c == 46
    set decimal_seen = 1
   else
    if decimal_seen
     set frac = frac + 1
    end
    if significant != 0
     set significant = significant + 1
    else
     if c != 48
      set significant = 1
     end
    end
    if significant != 0
     if c == 48
      set trailing = trailing + 1
     else
      set trailing = 0
     end
     if significant <= 10
      set value = value * 10 + c - 48
     end
    end
   end
   set i = i + 1
  end
 end
 if significant == 0
  return 0
 end
 if neg
  return j_fail(2)
 end
 # Strip trailing zeroes from the mantissa. Re-read its at most ten significant digits.
 if significant - trailing > 10
  return j_fail(2)
 end
 set value = 0
 set i = 0
 set decimal_seen = 0
 while decimal_seen < significant - trailing
  set c = load8(p + i)
  if j_digit(c)
   if decimal_seen != 0
    set value = value * 10 + c - 48
    set decimal_seen = decimal_seen + 1
   else
    if c != 48
     set value = c - 48
     set decimal_seen = 1
    end
   end
  end
  set i = i + 1
 end
 set shift = 20000000 + trailing - frac
 if eneg
  set shift = shift - e
 else
  set shift = shift + e
 end
 if shift < 20000000
  return j_fail(2)
 end
 set shift = shift - 20000000
 if significant - trailing + shift > 10
  return j_fail(2)
 end
 while shift != 0
  set value = value * 10
  set shift = shift - 1
 end
 if value > 4294967295
  return j_fail(2)
 end
 return value
end

fn j_json_parse(p, n)
 do store64(j_state(), 0)
 if j_utf8(p, n) == 0
  return j_fail(1)
 end
 do store64(j_state() + 8, p)
 do store64(j_state() + 16, p + n)
 do store64(j_state() + 24, 0)
 do store64(j_state() + 32, 0)
 do j_json_value(0)
 if load64(j_state()) != 0
  return 0
 end
 if j_skip(load64(j_state() + 8), p + n) != p + n
  return j_fail(1)
 end
 return 1
end
fn j_rpc_start(id)
 let t = j_token(id)
 do j_say("{\"jsonrpc\":\"2.0\",\"id\":")
 if id == 0
  do j_say("null")
 else
  if load64(t) == 1
   do j_say("\"")
   do j_output(load64(t + 8), load64(t + 16))
   do j_say("\"")
  else
   do j_output(load64(t + 8), load64(t + 16))
  end
 end
 return 0
end
fn j_rpc_error(id, code, message)
 do j_rpc_start(id)
 do j_say(",\"error\":{\"code\":-")
 do j_decimal(code)
 do j_say(",\"message\":\"")
 do j_say(message)
 return j_say("\"}}\n")
end
fn j_line()
 let g = buffer("stream_state", 24)
 let chunk = buffer("stream_chunk", 8192)
 let b = buffer("line", 1048577)
 let pos = load64(g)
 let size = load64(g + 8)
 let n = 0
 let c = 0
 let over = 0
 while 1
  if pos == size
   set size = read(0, chunk, 8192)
   set pos = 0
   if size >= 9223372036854775808
    do exit(1)
   end
   if size == 0
    do store64(g, 0)
    do store64(g + 8, 0)
    if over
     return 1048577
    end
    return n
   end
  end
  set c = load8(chunk + pos)
  set pos = pos + 1
  if c == 10
   do store64(g, pos)
   do store64(g + 8, size)
   if over
    return 1048577
   end
   # Zero length blank lines are ignored instead of treated as EOF.
   if n != 0
    return n
   end
  else
   if n < 1048576
    do store8(b + n, c)
    set n = n + 1
   else
    set over = 1
   end
  end
 end
 return 0
end
