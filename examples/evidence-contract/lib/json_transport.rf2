fn j_json_value(depth)
 let s = j_state()
 let p = j_skip(load64(s + 8), load64(s + 16))
 let endp = load64(s + 16)
 let idx = load64(s + 24)
 let t = j_token(idx)
 let c = 0
 let closer = 0
 let fields = 0
 let k = 0
 let start = 0
 let has = 0
 if depth > 32
  return j_fail(1)
 end
 if p >= endp
  return j_fail(1)
 end
 if idx >= 70000
  return j_fail(1)
 end
 do store64(s + 24, idx + 1)
 do store64(s + 8, p)
 do store64(t + 8, p)
 do store64(t + 32, 0)
 do store64(t + 40, 0)
 set c = load8(p)
 if c == 34
  do j_json_string(t)
 else
  if c == 123
   set closer = 125
   do store64(t, 2)
  else
   if c == 91
    set closer = 93
    do store64(t, 3)
   end
  end
  if closer != 0
   set p = j_skip(p + 1, endp)
   if p >= endp
    return j_fail(1)
   end
   if load8(p) != closer
    while 1
     if closer == 125
      if fields >= 64
       return j_fail(1)
      end
      if load8(p) != 34
       return j_fail(1)
      end
      set k = load64(s + 24)
      do store64(s + 8, p)
      do j_json_value(depth + 1)
      if load64(s) != 0
       return 0
      end
      # Duplicate keys, including escaped spellings and embedded NUL, reject.
      set start = idx + 1
      while start < k
       if j_same_string(j_token(start), j_token(k)) != 0
        return j_fail(1)
       end
       set start = load64(j_token(start + 1) + 24)
      end
      set p = j_skip(load64(s + 8), endp)
      if p >= endp
       return j_fail(1)
      end
      if load8(p) != 58
       return j_fail(1)
      end
      set p = j_skip(p + 1, endp)
     end
     do store64(s + 8, p)
     do j_json_value(depth + 1)
     if load64(s) != 0
      return 0
     end
     set fields = fields + 1
     set p = j_skip(load64(s + 8), endp)
     if p >= endp
      return j_fail(1)
     end
     if load8(p) == closer
      do store64(s + 8, p + 1)
      do store64(t + 24, load64(s + 24))
      do store64(t + 16, p + 1 - load64(t + 8))
      return idx
     end
     if load8(p) != 44
      return j_fail(1)
     end
     set p = j_skip(p + 1, endp)
     if p >= endp
      return j_fail(1)
     end
    end
   end
   do store64(s + 8, p + 1)
  else
   set start = p
   if c == 116
    set has = 4
    set k = "true"
    do store64(t, 4)
   else
    if c == 102
     set has = 5
     set k = "false"
     do store64(t, 5)
    else
     if c == 110
      set has = 4
      set k = "null"
      do store64(t, 6)
     end
    end
   end
   if has != 0
    if p + has > endp
     return j_fail(1)
    end
    set fields = 0
    while fields < has
     if load8(p + fields) != load8(k + fields)
      return j_fail(1)
     end
     set fields = fields + 1
    end
    set p = p + has
   else
    do store64(t, 7)
    if c == 45
     set p = p + 1
    end
    if p >= endp
     return j_fail(1)
    end
    if j_digit(load8(p)) == 0
     return j_fail(1)
    end
    if load8(p) == 48
     set p = p + 1
    else
     set p = j_digits_end(p, endp)
