      do store8(out + n, 192 + (v >> 6))
      set n = n + 1
     else
      if v < 65536
       do store8(out + n, 224 + (v >> 12))
       do store8(out + n + 1, 128 + ((v >> 6) & 63))
       set n = n + 2
      else
       do store8(out + n, 240 + (v >> 18))
       do store8(out + n + 1, 128 + ((v >> 12) & 63))
       do store8(out + n + 2, 128 + ((v >> 6) & 63))
       set n = n + 3
      end
     end
     set c = 128 + (v & 63)
    end
   else
    if c == 110
     set c = 10
    else
     if c == 114
      set c = 13
     else
      if c == 116
       set c = 9
      else
       if c == 98
        set c = 8
       else
        if c == 102
         set c = 12
        else
         if c != 34
          if c != 92
           if c != 47
