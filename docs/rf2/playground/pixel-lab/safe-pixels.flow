profile RF2_SYSTEM_A64_V1
use "lib/engine.rf2"
use "lib/sha256.rf2"
use "lib/output.rf2"
use "lib/identity.rf2"
fn equal(a,b)
 let i=0
 while load8(a+i)!=0
  if load8(a+i)!=load8(b+i)
   return 0
  end
  set i=i+1
 end
 return load8(b+i)==0
end
fn hex_digit(v)
 if all(v>=48,v<=57)
  return v-48
 end
 if all(v>=97,v<=102)
  return v-87
 end
 return 256
end
fn decimal(p)
 let n=text_length(p)
 if any(n==0,n>5)
  return 65536
 end
 let v=0
 let i=0
 while i<n
  let c=load8(p+i)
  if any(c<48,c>57)
   return 65536
  end
  if all(i==0,all(c==48,n>1))
   return 65536
  end
  set v=v*10+c-48
  if v>16384
   return 65536
  end
  set i=i+1
 end
 return v
end
fn refuse()
 do emit("{\"error\":\"Use invert, rotate, brighten or combo; supply exactly 64 lower-case hex pixel bytes. Optional budget and permission are whole numbers.\",\"published\":false}\n")
 return 2
end
fn main(argc,argv)
 if not(any(argc==3,any(argc==4,argc==5)))
  return refuse()
 end
 let svg=0
 if argc==4
  if not(equal(load64(argv+24),"--svg"))
   return refuse()
  end
  set svg=1
 end
 let mode=load64(argv+8)
 let hex=load64(argv+16)
 if text_length(hex)!=128
  return refuse()
 end
 let code=0
 if equal(mode,"invert")
  set code=2
 end
 if equal(mode,"rotate")
  set code=4
 end
 if equal(mode,"brighten")
  set code=1
 end
 if equal(mode,"combo")
  set code=7
 end
 if code==0
  return refuse()
 end
 let data=Data()
 let original=Data()
 let codes=Ops()
 let args=Ops()
 let p=Plan(64,1,7,384)
 let r=Run(0,0,0,0,0,0)
 if argc==5
  set p.budget=decimal(load64(argv+24))
  set p.allow=decimal(load64(argv+32))
  if any(p.budget>16384,p.allow>7)
   return refuse()
  end
 end
 let i=0
 while i<64
  let high=hex_digit(load8(hex+2*i))
  let low=hex_digit(load8(hex+2*i+1))
  if any(high>15,low>15)
   return refuse()
  end
  set data[i]=high*16+low
  set original[i]=data[i]
  set i=i+1
 end
 set codes[0]=code
 set args[0]=0
 if code==1
  set args[0]=32
 end
 if code==2
  set args[0]=255
 end
 if code==7
  set p.steps=3
  set codes[0]=1
  set args[0]=16
  set codes[1]=2
  set args[1]=255
  set codes[2]=4
 end
 do execute(data,p,codes,args,r)
 let before=buffer("pixel_before",64)
 let after=buffer("pixel_after",64)
 let receipt=buffer("pixel_receipt",320)
 let preserved=1
 set i=0
 while i<64
  do store8(before+i,original[i])
  do store8(after+i,data[i])
  if data[i]!=original[i]
   set preserved=0
  end
  do store8(receipt+i,load8(source_identity()+i))
  do store8(receipt+64+i,original[i])
  do store8(receipt+128+i,data[i])
  set i=i+1
 end
 do store64(receipt+192,code)
 do store64(receipt+200,p.budget)
 do store64(receipt+208,p.allow)
 do store64(receipt+216,r.code)
 do store64(receipt+224,r.step)
 do store64(receipt+232,r.index)
 do store64(receipt+240,r.expected)
 do store64(receipt+248,r.actual)
 do store64(receipt+256,r.work)
 if svg
  do emit("<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 256 256\" role=\"img\" aria-label=\"RF2 native pixel transformation\"><title>RF2 Safe Pixel Lab: ")
  do emit(mode)
  do emit("</title><metadata>Unsigned source-bound receipt SHA256: ")
  do emit_hex(sha256(receipt,264),32)
  do emit("; code: ")
  do emit_number(r.code)
  do emit("; published: ")
  do emit_number(r.code==0)
  do emit("</metadata>")
  set i=0
  while i<64
   do emit("<rect width=\"32\" height=\"32\" x=\"")
   do emit_number((i&7)*32)
   do emit("\" y=\"")
   do emit_number((i//8)*32)
   do emit("\" fill=\"#")
   do emit_hex(after+i,1)
   do emit_hex(after+i,1)
   do emit_hex(after+i,1)
   do emit("\"/>")
   set i=i+1
  end
  do emit("</svg>\n")
  return r.code
 end
 do emit("{\"schema\":\"rf2.safe-pixels.v1\",\"recipe\":\"")
 do emit(mode)
 do emit("\",\"sourceIdentity\":\"")
 do emit(source_identity())
 do emit("\",\"code\":")
 do emit_number(r.code)
 do emit(",\"published\":")
 if r.code==0
  do emit("true")
 else
  do emit("false")
 end
 do emit(",\"originalPreserved\":")
 if preserved
  do emit("true")
 else
  do emit("false")
 end
 do emit(",\"work\":")
 do emit_number(r.work)
 do emit(",\"budget\":")
 do emit_number(p.budget)
 do emit(",\"allow\":")
 do emit_number(p.allow)
 do emit(",\"inputHex\":\"")
 do emit_hex(before,64)
 do emit("\",\"stateHex\":\"")
 do emit_hex(after,64)
 do emit("\",\"inputSha256\":\"")
 do emit_hex(sha256(before,64),32)
 do emit("\",\"stateSha256\":\"")
 do emit_hex(sha256(after,64),32)
 do emit("\",\"receiptSha256\":\"")
 do emit_hex(sha256(receipt,264),32)
 do emit("\",\"receiptKind\":\"unsigned-local-content-digest\",\"failureStep\":")
 do emit_number(r.step)
 do emit(",\"failureIndex\":")
 do emit_number(r.index)
 do emit(",\"expected\":")
 do emit_number(r.expected)
 do emit(",\"actual\":")
 do emit_number(r.actual)
 do emit("}\n")
 return r.code
end
